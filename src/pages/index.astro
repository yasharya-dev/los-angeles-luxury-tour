---
import Base from '../layouts/Base.astro';
import Landing from '../views/Landing.astro';
import { useTranslations } from '../i18n/utils';

const locale = 'en' as const;
const t = useTranslations(locale);
---

<Base
  locale={locale}
  title={`${t('site.title')} - ${t('site.tagline')}`}
  description="Private tours and transfers across Los Angeles and Orange County with a Japanese guide who lives here. In Japanese and English, by reservation only."
>
  <Landing locale={locale} />
</Base>
