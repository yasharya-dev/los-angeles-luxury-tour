---
import Base from '../../../layouts/Base.astro';
import JourneyDetail from '../../../views/JourneyDetail.astro';
import PlanDetail from '../../../views/PlanDetail.astro';
import { journeys } from '../../../data/journeys';
import { plans } from '../../../data/plans';

// Two data shapes share this route: the three original journeys, and plans in
// Amelia's format (data/plans.ts). The latter is where everything moves once
// her full list arrives.
export function getStaticPaths() {
  return [
    ...journeys.map((j) => ({ params: { slug: j.slug } })),
    ...plans.map((plan) => ({ params: { slug: plan.slug } })),
  ];
}

const locale = 'ja' as const;
const { slug } = Astro.params;
const plan = plans.find((x) => x.slug === slug);
const journey = journeys.find((j) => j.slug === slug);
if (!plan && !journey) throw new Error(`No data for slug "${slug}"`);

const title = plan
  ? `${plan.title.ja}｜Los Angeles Luxury Tour`
  : `${journey!.title.ja.join('')}｜Los Angeles Luxury Tour`;
const description = plan ? plan.subtitle.ja : journey!.lead.ja;
---

<Base locale={locale} title={title} description={description}>
  {plan ? <PlanDetail locale={locale} slug={slug!} /> : <JourneyDetail locale={locale} slug={slug!} />}
</Base>
