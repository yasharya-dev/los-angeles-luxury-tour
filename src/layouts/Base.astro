---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangOfferBar from '../components/LangOfferBar.astro';
import { type Locale } from '../i18n/ui';
import { useTranslations, alternatePath, pagePath } from '../i18n/utils';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  offerBar?: boolean;
}

const { locale, title, description, offerBar = true } = Astro.props;
const t = useTranslations(locale);

const pathname = pagePath(Astro.url.pathname);
const enHref = alternatePath(pathname, 'en');
const jaHref = alternatePath(pathname, 'ja');
const site = Astro.site?.origin ?? 'https://losangelesluxurytour.com';
const canonical = new URL(pathname, site).href;

// One image for both locales: photography and the logo, no text, composed
// by scripts/og.mjs from the same assets the hero uses.
const ogImage = new URL('/og/default.jpg', site).href;
const ogAlt =
  locale === 'ja'
    ? 'ダウンタウン・ロサンゼルスを望むパームツリーの並木道と、Los Angeles Luxury Tourのロゴ'
    : 'Palm-lined road above downtown Los Angeles with the Los Angeles Luxury Tour logo';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The black of the header, so the phone's own chrome meets it without a seam. */}
    <meta name="theme-color" content="#101010" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="en" href={new URL(enHref, site).href} />
    <link rel="alternate" hreflang="ja" href={new URL(jaHref, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(enHref, site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Montserrat:wght@400;500;600&family=Noto+Serif+JP:wght@400;500;600;700&display=swap"
    />

    {/* Cream is the default for everyone, whatever the device prefers: it is
        the look in Amelia's brief. Dark is a choice, read here, inline and
        blocking, so a visitor who made it never sees a cream flash. */}
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('llt-theme') === 'dark') {
            document.documentElement.dataset.theme = 'dark';
          }
        } catch (e) {
          /* private mode - stay on the default */
        }
      })();
    </script>
    {/* The theme toggle is a script. Without one it would be a dead button.
        !important, because the component's own display rule is more specific. */}
    <noscript><style is:inline>[data-theme-toggle]{display:none!important}</style></noscript>
  </head>

  <body>
    <a class="skip-link plate" href="#main">{t('nav.skip')}</a>
    {offerBar && <LangOfferBar locale={locale} jaHref={jaHref} />}
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    {/* Copied text leaves behind the invisible marks the Japanese is set
        with (U+200B where a line may fold, U+2060 where it may not): pasted
        into LINE, a search box or a form, they would ride along. */}
    <script is:inline>
      document.addEventListener('copy', function (e) {
        var text = String(getSelection());
        var clean = text.replace(/[\u200b\u2060]/g, '');
        if (clean === text || !e.clipboardData) return;
        e.clipboardData.setData('text/plain', clean);
        e.preventDefault();
      });
    </script>
  </body>
</html>
