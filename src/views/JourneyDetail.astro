---
import { type Locale } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/utils';
import { bySlug, bookPath, consultPath } from '../data/offerings';
import { journeyBySlug } from '../data/journeys';
import Divider from '../components/Divider.astro';
import Icon from '../components/Icon.astro';
import Phrases from '../components/Phrases.astro';
import Reservation from '../components/Reservation.astro';

interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const t = useTranslations(locale);
const p = (path: string) => localizePath(path, locale);

const journey = journeyBySlug(slug);
const offering = bySlug(slug);
if (!journey || !offering) {
  throw new Error(`No journey data for slug "${slug}"`);
}

// The schedule's times are written 13:15. English reads them on a 12-hour
// clock, as the card's '9 a.m. to 6 p.m.' does; Japanese as written.
const clock = (time: string) => {
  if (locale !== 'en') return time;
  const [h, m] = time.split(':').map(Number);
  return `${h % 12 || 12}:${String(m).padStart(2, '0')} ${h < 12 ? 'a.m.' : 'p.m.'}`;
};

const labels = {
  en: {
    includes: 'What is included',
    excludes: 'Not included',
    schedule: 'The shape of the day',
  },
  ja: {
    includes: '料金に含まれるもの',
    excludes: '料金に含まれないもの',
    schedule: '1日の流れ',
  },
}[locale];
---

<section class="section head">
  <div class="measure measure--wide">
    <a class="back" href={p('/experience')}>
      <Icon name="arrow-left" size={18} />
      {t('cta.back')}
    </a>
    <p class="kicker head__kicker">{journey.kicker[locale]}</p>
    <h1 class="h2 head__title">
      {journey.title[locale].map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </h1>
    <p class="price">
      <span class="price__amount">{offering.price[locale]}</span>
      {offering.priceNote?.[locale] && (
        <span class="price__unit">{offering.priceNote[locale]}</span>
      )}
    </p>
    <p class="body head__lead"><Phrases text={journey.lead[locale]} /></p>
  </div>
</section>

{
  journey.schedule && (
    <section class="section section--deep">
      <div class="measure--cards">
        <h2 class="h3 block__title">{labels.schedule}</h2>
        {/* role="list": Safari drops the list from a list with no markers. */}
        <ol class="schedule" role="list">
          {journey.schedule.map((row) => (
            <li class="row">
              <span class="row__time">{clock(row.time)}</span>
              <div class="row__text">
                <p class="row__title"><Phrases text={row.title[locale]} /></p>
                {row.note && (
                  <p class="row__note">
                    <Phrases text={row.note[locale]} />
                  </p>
                )}
              </div>
            </li>
          ))}
        </ol>
        {journey.scheduleNote && (
          <p class="note">
            <Phrases text={journey.scheduleNote[locale]} />
          </p>
        )}
      </div>
    </section>
  )
}

<section class="section">
  <div class="measure--cards lists">
    <div class="list">
      <h2 class="h3 block__title">{labels.includes}</h2>
      <ul class="list__items">
        {journey.includes[locale].map((item) => (
          <li class="list__item">
            <Phrases text={item} />
          </li>
        ))}
      </ul>
    </div>

    <div class="list">
      <h2 class="h3 block__title">{labels.excludes}</h2>
      <ul class="list__items list__items--muted">
        {journey.excludes[locale].map((item) => (
          <li class="list__item">
            <Phrases text={item} />
          </li>
        ))}
      </ul>
    </div>
  </div>

  {
    !journey.schedule && journey.scheduleNote && (
      <p class="note measure center">
        <Phrases text={journey.scheduleNote[locale]} />
      </p>
    )
  }
</section>

<Divider />

<section class="section">
  <Reservation locale={locale} />
  <p class="actions">
    <a class="btn btn--solid" href={p(bookPath(offering))}>{t('plan.request')}</a>
    <a class="ask" href={p(consultPath(offering))}>{t('plan.ask')}</a>
  </p>
</section>

<style>
  .head {
    padding-block: clamp(48px, 7vw, 84px) clamp(40px, 6vw, 60px);
  }

  /* A real target for a finger, at the label size the rest of the site uses. */
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap);
    margin-bottom: 18px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .back:hover {
    color: var(--gold-text);
  }

  .head__title {
    margin-block: 20px 22px;
  }

  .price {
    margin: 0 0 26px;
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .price__amount {
    font-family: var(--font-display);
    font-size: clamp(22px, 3.2vw, 30px);
    color: var(--gold-text);
    white-space: nowrap;
  }

  :global(html[lang='ja']) .price__amount {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(18px, 2.6vw, 24px);
  }

  .price__unit {
    font-size: 14px;
    color: var(--ink-soft);
  }

  .block__title {
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--hairline-soft);
  }

  /* ----------------------------------------------------------- schedule */

  .schedule {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }

  .row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(16px, 3vw, 28px);
    padding: 16px 0;
    border-bottom: 1px solid var(--hairline-soft);
  }
  /* On the narrowest phones the time goes above its row: beside it, the
     text had 208px at 320, and her 「オリーブオイルテイスティングへ。」 needs
     214 at the body size, so it broke mid-word and started a line with 。 */
  @media (max-width: 359px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }

  /* Times in the label face in both locales, as the Experience page's step
     numbers: Cormorant's 1 is drawn like a small capital I, so 11:15 read
     II:I5, and Mincho figures here would read as an accident. */
  .row__time {
    font-family: var(--font-label);
    font-size: 16px;
    font-weight: 600;
    color: var(--gold-text);
    white-space: nowrap;
    min-width: 3.5em;
  }

  .row__title {
    margin: 0;
    font-size: clamp(16px, 1.9vw, 17px);
    color: var(--ink);
  }

  /* Sentences, so the body size: her 14px is for labels. */
  .row__note {
    margin: 6px 0 0;
    font-size: 16px;
    line-height: 1.8;
    color: var(--ink-soft);
  }

  .note {
    margin-top: 22px;
    font-size: 16px;
    line-height: 1.8;
    color: var(--ink-soft);
  }

  /* -------------------------------------------------------------- lists */

  .lists {
    margin-inline: auto;
    display: grid;
    gap: clamp(40px, 6vw, 60px);
    grid-template-columns: 1fr;
  }

  @media (min-width: 760px) {
    .lists {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: start;
    }
  }

  .list__items {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .list__item {
    position: relative;
    padding: 9px 0 9px 20px;
    font-size: 16px;
    line-height: 1.85;
    color: var(--ink-mid);
  }

  /* Her own bullet convention: a middot for inclusions. */
  .list__item::before {
    content: '\30FB';
    position: absolute;
    left: 0;
    color: var(--gold-text);
  }

  .list__items--muted .list__item {
    color: var(--ink-soft);
  }
  .list__items--muted .list__item::before {
    content: '\203B'; /* her caveat mark */
    color: var(--ink-soft);
  }
  /* A Japanese mark: English lists take the middot the inclusions use. */
  :global(html[lang='en']) .list__items--muted .list__item::before {
    content: '\30FB';
  }

  /* ------------------------------------------------------------ actions */

  .actions {
    margin: clamp(32px, 5vw, 44px) auto 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-lg);
    flex-wrap: wrap;
  }

  /* A second action in her warm grey, underlined, as under the plan page's
     price (10A). */
  .ask {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: 15px;
    font-weight: 600;
    color: var(--chip-ink);
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 0.3em;
  }
  .ask:hover {
    color: var(--ink);
  }
</style>
