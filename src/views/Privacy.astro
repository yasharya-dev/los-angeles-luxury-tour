---
import type { Locale } from '../i18n/ui';
import { CONTACT } from '../data/contact';
import Phrases from '../components/Phrases.astro';

// No fold inside LINE ID or Cloudflare Web Analytics.
const NBSP = String.fromCharCode(0xa0);

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// Names the actual processors rather than boilerplate. If the form provider
// or analytics changes, this page changes in the same commit.
const copy = {
  en: {
    kicker: 'Privacy',
    title: 'What happens to what you share with us',
    updated: 'Last updated November 2026',
    sections: [
      {
        h: 'What we collect',
        b: 'Only what you type into the consultation or booking form: your name, email address, LINE ID if you give one, preferred language, plan, the transfer and route you choose, dates, number of guests, where you are staying, what you are hoping for, requests or notes, how you heard about us, and the name of a friend who referred you, if you give one. Nothing else, and nothing you have not chosen to write.',
      },
      {
        h: 'Why we collect it',
        b: 'To reply to you and to plan your journey. That is the only purpose. Your details are never sold, never rented, and never shared for marketing.',
      },
      {
        h: 'Who else sees it',
        b: 'Your message is delivered to our inbox by Resend, an email provider, and this site is hosted by Cloudflare. Both handle the message in transit. No one else has access. When you send a booking request, Resend also delivers a receipt to the address you gave, listing the plan, your choices, the date and the number of guests; nothing else you wrote goes into it.',
      },
      {
        h: 'How long we keep it',
        b: 'For as long as we are in conversation, and afterwards only as an ordinary record of correspondence. Ask us to delete it and we will.',
      },
      {
        h: 'Cookies',
        b: 'This site sets no tracking cookies and runs no advertising. Your language and theme preferences are stored in your own browser, and never leave it. Visitor numbers are counted by Cloudflare Web Analytics, which uses no cookies and does not identify individuals.',
      },
      {
        h: 'Getting in touch',
        b: 'To see, correct, or delete anything we hold about you, write to us at',
      },
    ],
  },

  ja: {
    kicker: 'プライバシーポリシー',
    title: 'お預かりする情報について',
    updated: '最終更新：2026年11月',
    sections: [
      {
        h: '取得する情報',
        b: `お問い合わせフォームまたはご予約フォームにご記入いただいた内容のみです。お名前、メールアドレス、LINE${NBSP}ID（ご記入いただいた場合）、ご希望の言語、プラン、送迎タイプ・送迎区間、ご旅行の時期やご希望日、人数、ご宿泊先、ご希望の内容やご要望、当サービスをお知りになったきっかけ、ご紹介者のお名前（ご記入いただいた場合）。それ以外の情報は取得いたしません。`,
      },
      {
        h: '利用目的',
        b: 'ご返信と、旅のご提案のためだけに利用いたします。第三者への販売・貸与、マーケティング目的での共有は一切行いません。',
      },
      {
        h: '第三者への提供',
        b: 'お送りいただいた内容は、メール配信サービスのResendを通じて弊社の受信箱へ届きます。また、本サイトはCloudflareにてホスティングしています。いずれも送信の過程で内容を取り扱いますが、それ以外の第三者がアクセスすることはありません。ご予約リクエストをお送りいただいた場合は、ご入力のメールアドレスへ、同じくResendを通じて受付のご案内をお送りします。記載するのはプラン、送迎タイプ・送迎区間、ご利用日、人数のみで、その他のご記入内容は含みません。',
      },
      {
        h: '保存期間',
        b: 'ご連絡を取り合っている間、およびその後は通常の連絡記録として保管いたします。削除をご希望の場合は、お申し付けください。',
      },
      {
        h: 'クッキーについて',
        b: `本サイトでは、トラッキングクッキーや広告は使用しておりません。言語とテーマの設定はお客様のブラウザ内にのみ保存され、外部に送信されることはありません。アクセス数の集計にはCloudflare${NBSP}Web${NBSP}Analyticsを使用しており、クッキーを用いず、個人を特定することもありません。`,
      },
      {
        h: 'お問い合わせ',
        b: '弊社が保有するお客様の情報の確認・訂正・削除をご希望の場合は、こちらまでご連絡ください：',
      },
    ],
  },
} as const;

const c = copy[locale];
---

<section class="section">
  <div class="measure">
    <p class="kicker">{c.kicker}</p>
    <h1 class="h2 title">{c.title}</h1>
    <p class="caption updated">{c.updated}</p>

    {
      c.sections.map((s, i) => (
        <section class="block">
          <h2 class="h3 block__h">{s.h}</h2>
          <p class="body">
            <Phrases text={s.b} />
            {/* The address follows a Japanese colon with no space. */}
            {i === c.sections.length - 1 && (
              <>
                {locale === 'en' ? ' ' : <wbr />}<a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
              </>
            )}
          </p>
        </section>
      ))
    }
  </div>
</section>

<style>
  .title {
    margin-block: 22px 12px;
  }
  .updated {
    margin-bottom: clamp(40px, 6vw, 56px);
  }
  .block + .block {
    margin-top: clamp(32px, 4vw, 44px);
  }
  .block__h {
    margin-bottom: 14px;
  }
  /* The address is long enough to take a line of its own on a phone, where
     it is a target, not a word in a sentence: padding gives it 44px to hit
     without moving a line of the text. */
  .block a {
    padding-block: 11px;
  }
</style>
