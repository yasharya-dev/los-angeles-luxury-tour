---
import { type Locale } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/utils';
import { bySlug, bookPath, consultPath, type Tier } from '../data/offerings';
import { planBySlug, yenAmount, lowestPrice } from '../data/plans';
import { planPhotos } from '../data/plan-photos';
import { cancellation } from '../data/cancellation';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Phrases from '../components/Phrases.astro';

interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const t = useTranslations(locale);
const p = (path: string) => localizePath(path, locale);

const plan = planBySlug(slug);
const offering = bySlug(slug);
if (!plan || !offering) {
  throw new Error(`No plan data for slug "${slug}"`);
}

// Amelia's plan page (brief of 2026-11-05, section 10A): one column on every
// screen, centred on a wide one. Every word on it comes from the plan's data
// or from the labels all plans share, so the next plan is a data entry.
const photos = planPhotos[slug] ?? {};
const tierLabel: Record<Tier, string> = {
  signature: t('tier.signature'),
  day: t('tier.day'),
  transport: t('tier.transport'),
};

// Her eyebrows are English, so on the Japanese page they are marked as such
// and a screen reader says them as English. She names the experience part in
// English too.
const ascii = (s: string) => /^[\x20-\x7e]+$/.test(s);
const eyebrow = plan.eyebrow?.[locale] ?? tierLabel[offering.tier];
const eyebrowLang = locale !== 'en' && ascii(eyebrow) ? 'en' : undefined;
const en = locale === 'en' ? undefined : 'en';

const book = p(bookPath(offering));
const ask = p(consultPath(offering));
const unit = plan.unit[locale];
const terms = cancellation[locale];
---

<div class="plan-page">
  {/* 01 Photo first, then the overview. */}
  {
    photos.hero && (
      <div class="hero">
        <Photo
          class="hero__photo"
          src={photos.hero.src}
          alt={photos.hero.alt[locale]}
          aspect={16 / 10}
          sizes="(min-width: 720px) 680px, 100vw"
          priority
          style={photos.hero.focus ? `object-position: ${photos.hero.focus}` : undefined}
        />
      </div>
    )
  }

  <section class="overview">
    <p class="kicker" lang={eyebrowLang}>{eyebrow}</p>
    <h1 class="h2 overview__title"><Phrases text={plan.title[locale]} /></h1>
    <p class="body overview__intro"><Phrases text={plan.intro[locale]} /></p>
    <ul class="tiles" role="list">
      {
        plan.tiles.map((tile) => (
          <li class="tile">
            <Icon name={tile.icon} size={24} class="tile__icon" />
            <span class="tile__label">{tile.label[locale]}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {/* 02 One white card: the prices, her note, both ways in. */}
  <section class="pricing panel">
    <dl class="prices">
      {
        plan.prices.map((row) => (
          <div class="price">
            <dt class="price__label">{row.label[locale]}</dt>
            <dd class="price__figure">
              <span class="price__amount">{yenAmount(row.yen, locale)}</span>{' '}
              <span class="price__unit">{unit}</span>
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="caption pricing__note">{plan.priceNote[locale]}</p>
    <a class="btn btn--solid pricing__cta" href={book} data-plan-request>
      {t('plan.request')}
      <Icon name="arrow-right" size={18} />
    </a>
    <a class="pricing__ask" href={ask}>{t('plan.ask')}</a>
  </section>

  {/* 03 The experience, then what the service includes, kept in view. */}
  <section class="experience" aria-labelledby="plan-experience">
    <p class="kicker" lang={en}>The experience</p>
    <h2 class="h2 experience__title" id="plan-experience">
      <Phrases text={plan.experience.title[locale]} />
    </h2>
    <p class="body"><Phrases text={plan.experience.body[locale]} /></p>
    {
      photos.experience && (
        <Photo
          class="experience__photo"
          src={photos.experience.src}
          alt={photos.experience.alt[locale]}
          aspect={16 / 10}
          sizes="(min-width: 720px) 632px, calc(100vw - 40px)"
          style={photos.experience.focus ? `object-position: ${photos.experience.focus}` : undefined}
        />
      )
    }

    <h3 class="h3 part__title">{t('plan.services')}</h3>
    <ul class="checks" role="list">
      {
        plan.services[locale].map((item) => (
          <li class="check">
            <Icon name="check" size={20} class="check__icon" />
            <span>
              <Phrases text={item} />
            </span>
          </li>
        ))
      }
    </ul>

    <h3 class="h3 part__title">{t('plan.usage')}</h3>
    <dl class="usage">
      {
        plan.usage.map((row) => (
          <div class="usage__row">
            <dt class="usage__label">{row.label[locale]}</dt>
            <dd class="usage__value">{row.value[locale]}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* 04 Her two accordions, holding her existing terms. The cancellation
      terms are the FAQ's own, from the same data, so they are on the page
      before anyone reaches the form. */}
  <div class="details panel">
    {
      plan.details.map((d) => (
        <details class="detail">
          <summary class="detail__label">
            <span>{d.label[locale]}</span>
            <Icon name="chevron-down" size={20} class="detail__chevron" />
          </summary>
          <div class="detail__body">
            {d.blocks.map((block) => (
              <div class="block">
                {block.heading && <p class="block__heading">{block.heading[locale]}</p>}
                {block.paragraphs?.[locale].map((para) => (
                  <p class="body">
                    <Phrases text={para} />
                  </p>
                ))}
                {block.bullets && (
                  <ul class="bullets">
                    {block.bullets[locale].map((item) => (
                      <li class="body">
                        <Phrases text={item} />
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
            {d.cancellation && (
              <div class="block" data-cancellation>
                <p class="block__heading">{terms.question}</p>
                <p class="body">
                  <Phrases text={terms.lead} />
                </p>
                <ul class="bullets">
                  {terms.tiers.map((tier) => (
                    <li class="body">{tier}</li>
                  ))}
                </ul>
                <p class="body">
                  <Phrases text={terms.after} />
                </p>
              </div>
            )}
          </div>
        </details>
      ))
    }
  </div>

  {/* Her black closing panel: 完全予約制, her line, the gold button. */}
  <section class="closing plate" aria-labelledby="plan-closing" data-plan-closing>
    <p class="closing__label">{t('plan.byReservation')}</p>
    <h2 class="h2 closing__title" id="plan-closing"><Phrases text={plan.closing[locale]} /></h2>
    <a class="btn btn--solid" href={book}>
      {t('plan.request')}
      <Icon name="arrow-right" size={18} />
    </a>
  </section>

  {/* With the photo first, the way back moves to the end of the page. */}
  <p class="back">
    <a href={p('/experience')}>
      <Icon name="arrow-left" size={18} />
      {t('cta.back')}
    </a>
  </p>

  {/* Her optional phone bar (10A 04): the from-price and her label, at the
      foot of the screen once the price card's button has gone above it, and
      until her closing panel comes up. Hidden until the script below takes
      it out, so it never shows without one. */}
  <div class="plan-bar plate" data-plan-bar hidden>
    <p class="plan-bar__price">
      <span class="plan-bar__amount">{lowestPrice(plan, locale)}</span>{' '}
      <span class="plan-bar__unit">{unit}</span>
    </p>
    <a class="btn btn--solid plan-bar__cta" href={book}>
      {t('plan.bar')}
      <Icon name="arrow-right" size={18} class="plan-bar__arrow" />
    </a>
  </div>
</div>

<script>
  import { startPlanBar } from '../scripts/plan-bar';

  startPlanBar();
</script>

<style>
  /* One column, the same on every screen: her layout, centred on a wide one.
     The photo runs to the edges of the column; everything else keeps the
     page's gutter. Sections follow on at one even spacing, without bands. */
  .plan-page {
    /* The one spacing between her four parts: price, experience, details,
       closing. */
    --part-gap: clamp(24px, 4vw, 32px);
    max-width: 680px;
    margin-inline: auto;
    padding-bottom: clamp(36px, 6vw, 56px);
  }

  .overview,
  .pricing,
  .experience,
  .details,
  .closing,
  .back {
    margin-inline: var(--gutter);
  }

  .hero :global(picture) {
    display: block;
  }
  .hero__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  /* Once the column is narrower than the screen, the photo sits in it as a
     picture: rounded, with air above it. */
  @media (min-width: 681px) {
    .plan-page {
      padding-top: 32px;
    }
    .hero__photo {
      border-radius: var(--radius-card);
    }
  }

  /* A phone on its side: the photo leaves room for the kicker and title in
     the first screen, cropped rather than shrunk, and the column's padding
     above it, which is for a desktop, goes. Measured at 667x375, 844x390 and
     932x430. */
  @media (orientation: landscape) and (max-height: 500px) {
    .plan-page {
      padding-top: 0;
    }
    .hero__photo {
      max-height: 45svh;
    }
  }

  /* ----------------------------------------------------------- overview */

  .overview {
    margin-top: 22px;
  }

  .overview__title {
    margin-block: 10px 12px;
  }

  /* Three equal tiles, side by side at every width, as she drew them. */
  .tiles {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 12px 6px;
    border-radius: var(--radius-ctl);
    background: var(--bg-deep);
    text-align: center;
  }
  .tile :global(.tile__icon) {
    color: var(--gold-text);
  }
  .tile__label {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--ink);
    text-wrap: balance;
  }

  /* ------------------------------------------------------------ pricing */

  .pricing {
    margin-top: var(--part-gap);
    padding: 4px clamp(16px, 4vw, 22px) 14px;
  }

  .prices {
    margin: 0;
  }

  /* Label on the left, price on the right; a long English label folds
     before the price ever does. */
  .price {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--hairline-soft);
  }

  .price__label {
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
  }

  .price__figure {
    margin: 0;
    white-space: nowrap;
  }
  .price__amount {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    color: var(--gold-text);
  }
  :global(html[lang='ja']) .price__amount {
    font-family: var(--font-body);
    font-size: 21px;
  }
  .price__unit {
    font-size: 14px;
    color: var(--ink-soft);
  }

  .pricing__note {
    margin-top: 10px;
  }

  .pricing__cta {
    display: flex;
    width: 100%;
    margin-top: 16px;
  }

  .pricing__ask {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    margin-top: 4px;
    font-size: 15px;
    font-weight: 600;
    color: var(--quiet-ink);
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 0.3em;
  }
  /* Her warm grey, underlined (10A): a second action, quieter than the
     button above it. */
  .pricing__ask:hover {
    color: var(--ink);
  }

  /* --------------------------------------------------------- experience */

  /* The gaps are even from ink to ink: the kicker's half-leading adds about
     5px above this part, and the details panel's shadow takes about 3px from
     the one below it. */
  .experience {
    margin-top: calc(var(--part-gap) - 5px);
  }

  .experience__title {
    margin-block: 10px 12px;
  }

  .experience :global(picture) {
    display: block;
    margin-top: 18px;
  }
  .experience__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-ctl);
  }

  .part__title {
    margin: 26px 0 10px;
  }

  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .check {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-mid);
  }
  .check :global(.check__icon) {
    flex: none;
    margin-top: 0.2em;
    color: var(--gold-text);
  }
  /* Two even lines where a row folds, not a long line and a word. */
  .check > span {
    text-wrap: balance;
  }

  .usage {
    margin: 0;
    border-top: 1px solid var(--hairline-soft);
  }
  .usage__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--hairline-soft);
  }
  .usage__label {
    flex: none;
    font-size: 15px;
    color: var(--ink-soft);
  }
  /* Half-width marks without proportional kana: WebKit lays a palt run out
     at its full width and draws it narrower, so a right-aligned value stopped
     short; with no feature at all ・ and brackets go full width and loose. */
  .usage__value {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    text-align: right;
    font-feature-settings: 'halt';
  }

  /* ------------------------------------------------------------ details */

  .details {
    margin-top: var(--part-gap);
    padding-inline: clamp(16px, 4vw, 22px);
  }

  .detail + .detail {
    border-top: 1px solid var(--hairline-soft);
  }

  .detail__label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    padding: 12px 0;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--ink);
    transition: color 0.3s ease;
  }
  :global(html[lang='ja']) .detail__label {
    font-family: var(--font-body);
    font-size: 16px;
  }
  .detail__label > span {
    text-wrap: balance;
  }
  .detail__label::-webkit-details-marker {
    display: none;
  }
  .detail__label:hover {
    color: var(--gold-text);
  }
  .detail__label :global(.detail__chevron) {
    flex: none;
    color: var(--gold-text);
    transition: transform 0.25s ease;
  }
  .detail[open] .detail__label :global(.detail__chevron) {
    transform: rotate(180deg);
  }

  .detail__body {
    display: grid;
    gap: 18px;
    padding-bottom: 20px;
  }

  .block > * + * {
    margin-top: 6px;
  }
  .block__heading {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
  }
  .bullets {
    margin: 0;
    padding-left: 1.3em;
  }
  .bullets li + li {
    margin-top: 4px;
  }

  /* ------------------------------------------------------------ closing */

  /* A hairline keeps the panel a panel in the dark theme, where its black
     would otherwise be the page's own. */
  .closing {
    border: 1px solid var(--hairline);
    margin-top: calc(var(--part-gap) + 3px);
    padding: clamp(28px, 6vw, 40px) clamp(16px, 4vw, 24px);
    border-radius: var(--radius-card);
    background: var(--bar);
    text-align: center;
  }

  .closing__label {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--gold-text);
  }
  :global(html[lang='en']) .closing__label {
    font-family: var(--font-label);
    font-size: 14px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .closing__title {
    margin-block: 10px 20px;
  }

  /* As wide as the price card's button on a phone, so the label holds one
     line; no wider than it needs on a wide screen. */
  .closing .btn {
    display: flex;
    width: 100%;
    max-width: 360px;
    margin-inline: auto;
  }

  .back {
    margin-top: 20px;
    margin-bottom: 0;
  }
  .back a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .back a:hover {
    color: var(--gold-text);
  }

  /* ---------------------------------------------------------- phone bar */

  /* Her bar is for a phone held upright: off on a wide screen, on a phone on
     its side and on paper. A plate, so its gold and ink are the dark ones.
     It sits under the header's menu, which opens over it. */
  .plan-bar {
    display: none;
  }

  @media (max-width: 680px) and (min-height: 480px) {
    .plan-bar:not([hidden]) {
      position: fixed;
      inset: auto 0 0;
      z-index: 40;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px var(--gutter);
      background: var(--bar);
      border-top: 1px solid var(--hairline);
      visibility: hidden;
      transform: translateY(100%);
    }
    /* It slides in, and goes at once: a bar on its way out would still sit
       over what the page is bringing into view. */
    .plan-bar.is-shown {
      visibility: visible;
      transform: none;
      transition: transform 0.25s ease;
    }
  }

  /* In the dark theme the page is the bar's own black: the bar is lifted to
     the raised surface, with a shadow above it. */
  :global(html[data-theme='dark']) .plan-bar:not([hidden]) {
    background: var(--raised);
    box-shadow: 0 -10px 24px rgba(0, 0, 0, 0.45);
  }

  /* While it slides in, taps pass through it to what the guest meant to tap
     at the foot of the screen. */
  .plan-bar.is-arriving {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .plan-bar:not([hidden]),
    .plan-bar.is-shown {
      transition: none;
    }
  }

  @media print {
    .plan-bar {
      display: none !important;
    }
  }

  /* Her price takes the room the button leaves, as one line where it fits;
     the unit goes under the figure before the button gives way. The figure
     itself never shrinks: a flex item keeps its widest unbroken piece, so the
     price is never cut. */
  .plan-bar__price {
    flex: 1 1 0;
    margin: 0;
    line-height: 1.3;
  }
  .plan-bar__amount {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--gold-text);
    white-space: nowrap;
  }
  :global(html[lang='ja']) .plan-bar__amount {
    font-family: var(--font-body);
    font-size: 19px;
  }
  .plan-bar__unit {
    display: inline-block;
    font-size: 14px;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  /* Tighter than the page's buttons, as it shares the row with the price.
     It keeps its full width unless the price, at its narrowest, still leaves
     too little: then its English label folds between its two words, in two
     even lines. Her Japanese label never folds inside itself. */
  .plan-bar__cta {
    flex: 0 1 auto;
    padding: 8px 16px;
    letter-spacing: 0.06em;
    text-wrap: balance;
  }
  :global(html[lang='ja']) .plan-bar__cta {
    letter-spacing: 0.04em;
    word-break: keep-all;
  }

  /* Where the row is tight the arrow goes, so the label keeps one line:
     under 390px for the longer English label, under 360px for hers. */
  @media (max-width: 389px) {
    :global(html[lang='en']) .plan-bar :global(.plan-bar__arrow) {
      display: none;
    }
  }
  @media (max-width: 359px) {
    .plan-bar :global(.plan-bar__arrow) {
      display: none;
    }
  }
</style>
