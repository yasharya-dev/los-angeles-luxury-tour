---
import { type Locale } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/utils';
import Divider from '../components/Divider.astro';
import portrait from '../assets/portrait.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const p = (path: string) => localizePath(path, locale);

const EM = String.fromCharCode(0x2014);
const RSQ = String.fromCharCode(0x2019);
const LDQ = String.fromCharCode(0x201c);
const RDQ = String.fromCharCode(0x201d);

// The design handoff had 「observする人の目線」 here, an English verb left
// inside a Japanese sentence. Corrected to 「観る人の目線」.
const copy = {
  en: {
    kicker: 'About',
    title: ['Raised in Japan. At home in Los Angeles.'],
    intro: [
      `I${RSQ}m Amelia. I design and personally guide private journeys across Los Angeles and Orange County ${EM} every one of them, from the first message to the last drive.`,
      `Half Japanese, half American, I grew up in Japan and live here now ${EM} working between two languages and two ideas of hospitality.`,
    ],
    portraitAlt: 'Amelia Kay Perrin',

    storyTitle: ['The long way here'],
    story: [
      `As a child I lived for ballet and musical theater. What the stage taught me, I think, was to imagine the person watching ${EM} what they were feeling, what they might need next.`,
      `As an adult I tried plenty of things that didn${RSQ}t work ${EM} ideas that never took shape, work that didn${RSQ}t last. When I found this work, everything finally connected: both languages, both cultures, an eye for detail, and the joy of sharing a place I love. All of me is useful here.`,
      `Beautiful places, restaurants that make you feel something, thoughtful design and architecture ${EM} I collect them from everyday life, and every time I ask myself: who would love this? That collection becomes your journey.`,
    ],

    homesKicker: 'From two homes',
    homesTitle: ['What each place taught me'],
    homes: [
      {
        label: 'From Japan',
        body: `Thoughtfulness. Noticing before being asked. Caring for people in ways they never have to say out loud ${EM} the root of how I was raised.`,
      },
      {
        label: 'From America',
        body: `Confidence, flexibility, optimism ${EM} and the generosity of letting everyone enjoy things in their own way. This city${RSQ}s gift to me.`,
      },
    ],
    creed: [
      'Polished without being formal.',
      'Thoughtful without being restrictive.',
      'Personal without ever feeling forced.',
    ],
    creedAttr: `${EM} my own shape of hospitality.`,

    staysKicker: 'What guests carry home',
    staysTitle: ['What stays, after the trip'],
    staysBody: `Guests have told me, mid-journey, that they suddenly understood what truly mattered to them. Others said a belief they had carried for years quietly looked different. The best souvenir, it turns out, doesn${RSQ}t fit in a suitcase.`,
    quote: `${LDQ}I${RSQ}ve shared moments with guests that were so moving, we both had goosebumps.${RDQ}`,
    quoteAttr: 'Amelia',
    testimonialsSoon: `One day, this space will hold her guests${RSQ} own words.`,

    mediaKicker: 'As seen on',
    mediaName: 'ミヤネ屋',
    mediaBody: `Japan${RSQ}s national daytime programme ${EM} live from Dodger Stadium, alongside a guest, on taking the worry out of game-day transport.`,

    partnerKicker: 'Partnerships',
    partnerTitle: ['Work with Amelia'],
    partnerBody: `Hotels, restaurants, sporting organizations, tourism boards, travel advisors, and lifestyle brands ${EM} I welcome partners who care about the quality of the experience, communicate honestly, and value long-term relationships over quick transactions.`,

    closingKicker: 'Get in touch',
    closingTitle: ['Tell me what you are hoping for.'],
    closingBody:
      'Write in Japanese or English. You will hear back within 24 hours.',
  },

  ja: {
    kicker: 'アメリアについて',
    title: ['日本で育ち、', 'ロサンゼルスに暮らして。'],
    intro: [
      'はじめまして。アメリアです。ロサンゼルスとオレンジカウンティで、旅の設計から当日のご案内まで、すべてを私自身が担当しています。',
      '日本人の母とアメリカ人の父のもと、日本で育ちました。いまはこの街に暮らし、日本語と英語、ふたつの文化のあいだで旅をお仕立てしています。',
    ],
    portraitAlt: 'アメリア・ケイ・ペリン',

    storyTitle: ['この仕事に、たどり着くまで'],
    story: [
      '子どもの頃は、バレエとミュージカルに夢中でした。舞台の上で学んだのは、観る人の目線。観てくださる方が、いま何を感じているかを想像することだったように思います。',
      '大人になってからは、うまくいかなかった挑戦もたくさんあります。かたちにならなかったアイデアも、続かなかった仕事も。それでも、この仕事に出会ったとき、初めて全部がつながった気がしました。ふたつの言葉、ふたつの文化、細部への目、大好きな場所を誰かと分かち合うこと。私のすべてが、ここでは役に立つのです。',
      '美しい場所、心が動くレストラン、素敵なデザインや建築。日々の暮らしの中で出会うたび、いつも考えます。「これを、誰が喜んでくれるだろう？」その積み重ねが、あなたの旅になります。',
    ],

    homesKicker: 'ふたつの故郷から',
    homesTitle: ['それぞれの国が、', '教えてくれたこと'],
    homes: [
      {
        label: '日本から',
        body: '細やかな気配り。頼まれる前に気づくこと。そして、ディテールを大切にすること。言葉にされない想いを汲むことは、日本で育った私の根っこです。',
      },
      {
        label: 'アメリカから',
        body: '自信と、柔軟さと、楽観。そして「楽しみ方は人それぞれでいい」というおおらかさ。この街が、私に教えてくれたことです。',
      },
    ],
    creed: [
      'かしこまりすぎず、丁寧に。',
      '決めつけずに、心を配って。',
      '押しつけずに、その人らしく。',
    ],
    creedAttr: 'おもてなしの、私なりのかたち。',

    staysKicker: 'お客様が持ち帰るもの',
    staysTitle: ['旅の終わりに、残るもの'],
    staysBody:
      '旅の途中で「本当に大切なものに気づいた気がする」と話してくださった方がいます。長年抱えていた考えが、ふっと違って見えた。そう教えてくださった方も。旅の一番のお土産は、荷物には入らないのかもしれません。',
    quote: '「鳥肌が立つような瞬間を、お客様と何度もご一緒してきました。」',
    quoteAttr: 'アメリア',
    testimonialsSoon:
      'いつかこの場所に、お客様ご自身の言葉を並べられますように。',

    mediaKicker: 'メディア出演',
    mediaName: '日本テレビ系『ミヤネ屋』',
    mediaBody:
      'ドジャースタジアムから、お客様とともに生中継で出演しました。観戦時の送迎の不安を解消したい。その想いをお話ししています。',

    partnerKicker: 'パートナーシップ',
    partnerTitle: ['ご一緒しませんか'],
    partnerBody:
      'ホテル、レストラン、スポーツ団体、観光局、トラベルアドバイザー、ライフスタイルブランドの皆様。体験の質を大切にし、誠実に対話し、長いお付き合いを重んじる方々とのご縁を、いつでも歓迎しています。',

    closingKicker: 'お問い合わせ',
    closingTitle: ['あなたの「行ってみたい」を、', 'お聞かせください。'],
    closingBody: '日本語でお気軽にどうぞ。24時間以内にご返信いたします。',
  },
} as const;

const c = copy[locale];
---

<section class="section intro">
  <div class="intro__grid measure--grid">
    <div class="intro__portrait">
      <img
        src={portrait.src}
        alt={c.portraitAlt}
        width={portrait.width}
        height={portrait.height}
      />
    </div>
    <div class="intro__text">
      <p class="kicker">{c.kicker}</p>
      <h1 class="h2 intro__title">
        {c.title.map((line, i) => <>{i > 0 && <br />}{line}</>)}
      </h1>
      {c.intro.map((para) => <p class="body intro__para">{para}</p>)}
    </div>
  </div>
</section>

<section class="section section--deep">
  <div class="measure measure--wide">
    <h2 class="h2 story__title">
      {c.storyTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </h2>
    {c.story.map((para) => <p class="body story__para">{para}</p>)}
  </div>
</section>

<Divider />

<section class="section">
  <div class="measure measure--wide center homes__head">
    <p class="kicker">{c.homesKicker}</p>
    <h2 class="h2 section__title">
      {c.homesTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </h2>
  </div>

  <ul class="homes measure--cards">
    {
      c.homes.map((home) => (
        <li class="home">
          <p class="home__label">{home.label}</p>
          <p class="body home__body">{home.body}</p>
        </li>
      ))
    }
  </ul>

  <blockquote class="creed measure">
    {c.creed.map((line) => <p class="creed__line">{line}</p>)}
    <footer class="creed__attr">{c.creedAttr}</footer>
  </blockquote>
</section>

<section class="section section--deep section--wedged">
  <div class="measure measure--wide center">
    <p class="kicker">{c.staysKicker}</p>
    <h2 class="h2 section__title">
      {c.staysTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </h2>
    <p class="body">{c.staysBody}</p>
  </div>

  <blockquote class="pullquote measure">
    <p class="pullquote__text">{c.quote}</p>
    <footer class="pullquote__attr">{c.quoteAttr}</footer>
  </blockquote>

  {/* Testimonials are v2. Holding the space rather than faking it. */}
  <p class="caption center soon">{c.testimonialsSoon}</p>
</section>

<section class="section">
  <div class="measure center">
    <p class="kicker">{c.mediaKicker}</p>
    <p class="media__name">{c.mediaName}</p>
    <p class="caption media__body">{c.mediaBody}</p>
  </div>
</section>

<section class="section section--deep">
  <div class="measure measure--wide center">
    <p class="kicker">{c.partnerKicker}</p>
    <h2 class="h2 section__title">
      {c.partnerTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </h2>
    <p class="body partner__body">{c.partnerBody}</p>
    <a class="btn" href={p('/contact')}>{t('cta.start')}</a>
  </div>
</section>

<section class="section">
  <div class="measure measure--wide center">
    <p class="kicker">{c.closingKicker}</p>
    <h2 class="h2 section__title">
      {c.closingTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </h2>
    <p class="body closing__body">{c.closingBody}</p>
    <a class="btn" href={p('/contact')}>{t('cta.start')}</a>
  </div>
</section>

<style>
  .section__title {
    margin-block: 26px;
  }

  /* ------------------------------------------------------------- intro */

  .intro__grid {
    margin-inline: auto;
    display: grid;
    gap: clamp(32px, 6vw, 64px);
    align-items: center;
    grid-template-columns: 1fr;
  }

  @media (min-width: 820px) {
    .intro__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }

  .intro__portrait img {
    width: 100%;
    height: auto;
    border: 1px solid var(--card-edge);
  }

  .intro__title {
    margin-block: 22px;
  }

  .intro__para + .intro__para {
    margin-top: 18px;
  }

  /* -------------------------------------------------------------- story */

  .story__title {
    margin-bottom: 32px;
  }

  .story__para + .story__para {
    margin-top: 20px;
  }

  /* -------------------------------------------------------------- homes */

  .homes__head {
    margin-inline: auto;
    margin-bottom: clamp(40px, 6vw, 60px);
  }

  .homes {
    list-style: none;
    margin: 0 auto clamp(56px, 8vw, 88px);
    padding: 0;
    display: grid;
    gap: clamp(36px, 5vw, 56px);
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .homes {
      grid-template-columns: repeat(2, 1fr);
      align-items: start;
    }
  }

  .home {
    border-top: 1px solid var(--hairline-soft);
    padding-top: 22px;
  }

  .home__label {
    margin: 0 0 14px;
    font-family: var(--font-label);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  :global(html[lang='ja']) .home__label {
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.22em;
    text-transform: none;
  }

  /* -------------------------------------------------------------- creed */

  .creed {
    margin-inline: auto;
    padding: 0;
    text-align: center;
    border-top: 1px solid var(--hairline-soft);
    border-bottom: 1px solid var(--hairline-soft);
    padding-block: clamp(40px, 6vw, 60px);
  }

  .creed__line {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(19px, 2.8vw, 26px);
    line-height: 1.75;
    color: var(--ink);
  }

  :global(html[lang='ja']) .creed__line {
    font-family: var(--font-body);
    font-size: clamp(16px, 2.3vw, 21px);
    line-height: 2;
    letter-spacing: 0.04em;
  }

  .creed__attr {
    margin-top: 22px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 15px;
    color: var(--gold-text);
  }

  :global(html[lang='ja']) .creed__attr {
    font-family: var(--font-body);
    font-style: normal;
    font-weight: 500;
  }

  /* ---------------------------------------------------------- pullquote */

  .pullquote {
    margin: clamp(48px, 7vw, 72px) auto 0;
    padding: 0;
    text-align: center;
  }

  .pullquote__text {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(20px, 3vw, 28px);
    font-style: italic;
    line-height: 1.6;
    color: var(--gold-text);
  }

  :global(html[lang='ja']) .pullquote__text {
    font-family: var(--font-body);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(16px, 2.4vw, 22px);
    line-height: 2;
  }

  .pullquote__attr {
    margin-top: 18px;
    font-family: var(--font-label);
    font-size: 10.5px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  :global(html[lang='ja']) .pullquote__attr {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: none;
  }

  .soon {
    margin-top: clamp(32px, 5vw, 44px);
  }

  /* -------------------------------------------------------------- media */

  .media__name {
    margin: 20px 0 14px;
    font-family: var(--font-body);
    font-size: clamp(19px, 2.6vw, 24px);
    font-weight: 500;
    color: var(--ink);
  }

  .media__body {
    max-width: 46ch;
    margin-inline: auto;
  }

  /* ------------------------------------------------------------ closing */

  .partner__body,
  .closing__body {
    margin-bottom: 38px;
  }
</style>
