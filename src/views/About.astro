---
import { type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import Divider from '../components/Divider.astro';
import portrait from '../assets/portrait.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = (path: string) => localizePath(path, locale);

const RSQ = String.fromCharCode(0x2019);

// Amelia's structure and Japanese from her review of 2026-10-22: a brand page
// with a founder section inside it, in her order. English derived from it.
// Her small headings are bilingual lockups; the Japanese page shows them as
// she wrote them, the English page shows the English half.
const BOLD_JOURNEY = 'https://boldjourney.com/meet-amelia-perrin/';

const copy = {
  en: {
    aboutKicker: 'About us',
    aboutTitle: ['We believe luxury is an experience that enriches your life.'],
    aboutSub: '',
    about: [
      'Luxury, to us, is not only what is lavish. It is time, freedom, room to breathe, and enjoying things in a way that is yours.',
      'A place that moves you because of who you are. Time that exists because of the day it is. An experience that stays with you after the trip is over. Those are the luxuries we care about.',
      `Los Angeles Luxury Tour brings together a local view of Los Angeles and each guest${RSQ}s interests and sensibility, and proposes time that is yours alone.`,
    ],

    founderKicker: 'Founder',
    founderTitle: ['Raised in Japan. At home in Southern California.'],
    founder: [
      'Raised in Japan by a Japanese mother and an American father, now based in Southern California.',
      'The careful attention Japan is known for, and the easy freedom of America.',
      'Drawing on a life lived close to both cultures and on the view of someone who lives here, she proposes time in Los Angeles shaped to each guest.',
    ],
    portraitAlt: 'Amelia Kay Perrin',

    storyKicker: 'Our story',
    storyTitle: ['The moments that make people happy, turned into a life in travel.'],
    story: [
      'As a child, the ballet and musical stage was everything.',
      'What came naturally there was to think not only about how I looked, but about what the person watching was feeling right then.',
      'That never changed as an adult: thinking about what would make someone happy, noticing the small things, and sharing the places I love.',
      'When I began running tours in Los Angeles, everything I had done until then came together.',
      'Not simply showing people places, but making experiences they could only have met on this trip.',
      'And letting that time become the memory that coming to Los Angeles was worth it.',
      'That is where Los Angeles Luxury Tour began.',
    ],

    expKicker: 'The experience',
    expTitle: ['Time that stays with you after the trip is over.'],
    expLines: [
      'The view you met because of the day it was.',
      'The place you had always wanted to go.',
      'The little shop you found by chance and loved.',
      'The time you laughed with someone.',
      'Time you find yourself remembering long after the trip is over.',
    ],
    exp: [
      'From the classic sights of Los Angeles to the places and experiences only someone who lives here could suggest.',
      `Shaped to each guest${RSQ}s interests and what they came for, we make time that is theirs alone.`,
    ],

    pressKicker: 'Media & press',
    pressTitle: ['Press and appearances'],
    press: [
      {
        name: 'Bold Journey',
        label: 'Founder Interview: Meet Amelia Perrin',
        body: 'An interview on how Los Angeles Luxury Tour began, the road to it, and how she thinks about travel and hospitality.',
        link: 'Read the article',
        href: BOLD_JOURNEY,
      },
      {
        name: 'Nippon TV',
        label: 'Joho Live Miyaneya',
        body: 'Appeared live from Dodger Stadium, alongside a guest.',
      },
    ],

    partnerKicker: 'Partnership',
    partnerTitle: ['New experiences in Los Angeles, together.'],
    partner: [
      'Los Angeles Luxury Tour welcomes partners who can bring new experiences to our guests: hotels, restaurants, attractions, sports and entertainment, brands, media.',
      `We value building, on each other${RSQ}s strengths, experiences that could only come from here.`,
    ],
    partnerCta: 'Partnership enquiries',

    closingTitle: ['Next, your Los Angeles.'],
    closing: [
      'Where you want to go and how you want to spend it can be different for everyone.',
      'Your next special time, in Los Angeles.',
    ],
    closingPlans: 'See the plans',
    closingConsult: 'Consult',
  },

  ja: {
    aboutKicker: 'ABOUT US｜私たちについて',
    aboutTitle: ['私たちが考えるLuxuryとは、', '人生の価値になる体験です。'],
    aboutSub: 'We believe luxury is an experience that enriches your life.',
    about: [
      '贅沢とは、豪華さだけではなく、時間、自由、心の余裕、そして自分らしく楽しめること。',
      'その人だから心が動く場所、その日だから生まれる時間、旅が終わったあとも心に残る体験も、私たちにとって大切なLuxuryです。',
      'Los Angeles Luxury Tourは、ロサンゼルスを知る現地の視点と、一人ひとりの興味や感性を掛け合わせ、その方だけの時間をご提案します。',
    ],

    founderKicker: 'FOUNDER｜代表紹介',
    founderTitle: ['日本で育ち、', '南カリフォルニアに暮らして。'],
    founder: [
      '日本人の母とアメリカ人の父のもと日本で育ち、現在は南カリフォルニアを拠点にしています。',
      '日本ならではの細やかな心配りと、アメリカらしい自由な感覚。',
      '二つの文化を身近に感じてきた経験と、現地で暮らす視点を活かしながら、一人ひとりに合わせたロサンゼルスでの時間をご提案しています。',
    ],
    portraitAlt: 'アメリア・ケイ・ペリン',

    storyKicker: 'OUR STORY｜Los Angeles Luxury Tourを始めた理由',
    storyTitle: ['人が喜ぶ瞬間を、', '旅の仕事に。'],
    story: [
      '子どもの頃は、バレエやミュージカルの舞台に夢中でした。',
      'そこで自然と考えていたのは、自分がどう見えるかだけではなく、「見てくれている人は、今どんなことを感じているだろう」ということ。',
      '大人になってからも、人が喜ぶことを考えること、細かなことに気づくこと、そして大好きな場所を誰かと分かち合うことは変わりませんでした。',
      'ロサンゼルスでツアーを始めたとき、それまでの経験がひとつにつながりました。',
      'ただ場所をご案内するのではなく、「この旅だったから出会えた」と思える体験をつくる。',
      'そして、その時間が「ロサンゼルスに来てよかった」という記憶につながっていく。',
      'それが、Los Angeles Luxury Tourの原点です。',
    ],

    expKicker: 'THE EXPERIENCE｜旅のあとにも残るもの',
    expTitle: ['旅が終わったあとも、', '心に残る時間を。'],
    expLines: [
      'その日だから出会えた景色。',
      'ずっと行ってみたかった場所。',
      '偶然見つけたお気に入りのお店。',
      '誰かと笑った時間。',
      '旅が終わったあとも、ふとした瞬間に思い出したくなる時間。',
    ],
    exp: [
      '定番のロサンゼルス観光から、現地を知るからこそご提案できる場所や体験まで。',
      '一人ひとりの興味や目的に合わせ、その方だけの時間をつくります。',
    ],

    pressKicker: 'MEDIA & PRESS｜メディア掲載・出演実績',
    pressTitle: ['メディア掲載・出演実績'],
    press: [
      {
        name: 'Bold Journey',
        label: 'Founder Interview｜Meet Amelia Perrin',
        body: 'Los Angeles Luxury Tourを始めた背景やこれまでの歩み、旅とおもてなしに対する考えについてインタビューいただきました。',
        link: '記事を読む ※英語記事',
        href: BOLD_JOURNEY,
      },
      {
        name: '日本テレビ系',
        label: '『情報ライブ ミヤネ屋』',
        body: 'ドジャースタジアムからの生中継に、お客様とともに出演。',
      },
    ],

    partnerKicker: 'PARTNERSHIP｜パートナーシップ',
    partnerTitle: ['ロサンゼルスで、', '新しい体験を一緒に。'],
    partner: [
      'Los Angeles Luxury Tourでは、ホテル、レストラン、観光施設、スポーツ・エンターテインメント、ブランド、メディアなど、お客様に新しい体験を届けられるパートナーとの協業を歓迎しています。',
      '互いの強みを活かしながら、ここでしか生まれない体験を一緒につくることを大切にしています。',
    ],
    partnerCta: 'パートナーシップのお問い合わせ',

    closingTitle: ['次は、あなたのロサンゼルスを。'],
    closing: [
      '行きたい場所も、過ごし方も、一人ひとり違っていい。',
      '次の特別な時間を、ロサンゼルスで。',
    ],
    closingPlans: 'プランを見る',
    closingConsult: '相談する',
  },
} as const;

const c = copy[locale];
---

{/* 1. About us */}
<section class="section about">
  <div class="measure measure--wide center">
    <p class="kicker">{c.aboutKicker}</p>
    <h1 class="h2 section__title">{c.aboutTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h1>
    {c.aboutSub && <p class="about__en">{c.aboutSub}</p>}
    {c.about.map((para) => <p class="body stack">{para}</p>)}
  </div>
</section>

{/* 2. Founder: the portrait smaller, set beside the introduction, as she asked. */}
<section class="section section--deep">
  <div class="founder measure--grid">
    <div class="founder__portrait">
      <img
        src={portrait.src}
        alt={c.portraitAlt}
        width={portrait.width}
        height={portrait.height}
        loading="lazy"
      />
    </div>
    <p class="kicker founder__kicker">{c.founderKicker}</p>
    <div class="founder__text">
      <h2 class="h2 section__title">{c.founderTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2>
      {c.founder.map((para) => <p class="body stack">{para}</p>)}
    </div>
  </div>
</section>

<Divider />

{/* 3. Our story */}
<section class="section">
  <div class="measure measure--wide">
    <p class="kicker">{c.storyKicker}</p>
    <h2 class="h2 section__title">{c.storyTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2>
    {c.story.map((para) => <p class="body stack">{para}</p>)}
  </div>
</section>

{/* 4. The experience: five fragments she wrote as a stack, then two lines. */}
<section class="section section--deep section--wedged">
  <div class="measure measure--wide center">
    <p class="kicker">{c.expKicker}</p>
    <h2 class="h2 section__title">{c.expTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2>
    <div class="exp__lines">
      {c.expLines.map((line) => <p class="exp__line">{line}</p>)}
    </div>
    {c.exp.map((para) => <p class="body stack">{para}</p>)}
  </div>
</section>

{/* 5. Media & press */}
<section class="section">
  <div class="measure measure--wide center press__head">
    <p class="kicker">{c.pressKicker}</p>
    <h2 class="h2 section__title">{c.pressTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2>
  </div>
  <ul class="press measure--cards">
    {
      c.press.map((item) => (
        <li class="press__item">
          <p class="press__name">{item.name}</p>
          <p class="press__label">{item.label}</p>
          <p class="body press__body">{item.body}</p>
          {'href' in item && item.href && (
            <a class="press__link" href={item.href} rel="noopener" target="_blank">
              {item.link} <span aria-hidden="true">&rarr;</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>

<Divider />

{/* 6. Partnership */}
<section class="section">
  <div class="measure measure--wide center">
    <p class="kicker">{c.partnerKicker}</p>
    <h2 class="h2 section__title">{c.partnerTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2>
    {c.partner.map((para) => <p class="body stack">{para}</p>)}
    <a class="btn partner__cta" href={p('/consult')}>{c.partnerCta}</a>
  </div>
</section>

{/* 7. Final CTA */}
<section class="section section--deep">
  <div class="measure measure--wide center">
    <h2 class="h2 section__title">{c.closingTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2>
    {c.closing.map((para) => <p class="body stack">{para}</p>)}
    <div class="closing__actions">
      <a class="btn btn--solid" href={p('/experience')}>{c.closingPlans}</a>
      <a class="btn" href={p('/consult')}>{c.closingConsult}</a>
    </div>
  </div>
</section>

<style>
  .section__title {
    margin-block: 26px;
  }

  /* One sentence per line is how she writes; .body carries margin: 0. */
  .stack + .stack {
    margin-top: 0.7em;
  }

  /* ------------------------------------------------------------- about */

  .about__en {
    margin: 0 0 28px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(16px, 2.2vw, 19px);
    color: var(--gold-text);
  }

  /* ----------------------------------------------------------- founder */

  /* The portrait sits at a fixed small width beside the introduction, as she
     asked, rather than filling the viewport the way it used to. On a phone the
     kicker sits beside the photo and the heading and text run full width
     underneath: a Japanese heading cannot wrap inside a 180px column without
     breaking mid-word. From 720px the text column takes both. */
  .founder {
    margin-inline: auto;
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    column-gap: clamp(20px, 4vw, 48px);
    row-gap: 22px;
    align-items: center;
  }

  .founder__portrait {
    grid-column: 1;
    grid-row: 1;
  }

  .founder__kicker {
    grid-column: 2;
    grid-row: 1;
  }

  .founder__text {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  @media (min-width: 720px) {
    .founder {
      grid-template-columns: 220px minmax(0, 1fr);
      row-gap: 0;
      align-items: start;
    }
    .founder__portrait {
      grid-row: 1 / span 2;
      align-self: center;
    }
    .founder__text {
      grid-column: 2;
    }
  }

  .founder__portrait img {
    width: 100%;
    height: auto;
    border: 1px solid var(--card-edge);
  }

  .founder__text .section__title {
    margin-block: 0 18px;
  }

  @media (min-width: 720px) {
    .founder__text .section__title {
      margin-block: 20px 22px;
    }
  }

  /* --------------------------------------------------------- experience */

  .exp__lines {
    margin: 0 auto clamp(28px, 4vw, 40px);
    padding-block: clamp(28px, 4vw, 40px);
    border-top: 1px solid var(--hairline-soft);
    border-bottom: 1px solid var(--hairline-soft);
  }

  .exp__line {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(18px, 2.6vw, 24px);
    line-height: 1.8;
    color: var(--ink);
  }

  :global(html[lang='ja']) .exp__line {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(15.5px, 2.2vw, 20px);
    line-height: 2;
  }

  /* -------------------------------------------------------------- press */

  .press__head {
    margin-inline: auto;
    margin-bottom: clamp(32px, 5vw, 46px);
  }

  .press {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    gap: var(--gap-md);
    grid-template-columns: 1fr;
  }

  @media (min-width: 760px) {
    .press {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .press__item {
    border: 1px solid var(--card-edge);
    background: var(--card);
    padding: clamp(24px, 3.5vw, 34px);
  }

  .press__name {
    margin: 0 0 8px;
    font-family: var(--font-label);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  :global(html[lang='ja']) .press__name {
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: none;
  }

  .press__label {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: clamp(18px, 2.4vw, 22px);
    line-height: 1.4;
    color: var(--ink);
  }

  :global(html[lang='ja']) .press__label {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(15.5px, 2vw, 18px);
    line-height: 1.7;
  }

  .press__body {
    margin-bottom: 16px;
  }

  .press__link {
    font-family: var(--font-label);
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    display: inline-block;
    padding-block: 4px;
  }

  :global(html[lang='ja']) .press__link {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: none;
  }

  /* ------------------------------------------------- partner + closing */

  .partner__cta {
    margin-top: 36px;
  }

  .closing__actions {
    margin-top: 36px;
    display: flex;
    justify-content: center;
    gap: var(--gap-md);
    flex-wrap: wrap;
  }
</style>
