---
import { type Locale } from '../i18n/ui';
import { BR } from '../i18n/text';
import { localizePath } from '../i18n/utils';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Phrases from '../components/Phrases.astro';
import portrait from '../assets/portrait.jpg';
import coast from '../assets/malibu-cliff-house.webp';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = (path: string) => localizePath(path, locale);

// Amelia's About page, from section 09 of her brief of 2026-11-05: five
// short parts in place of the seven longer ones. Her Japanese is verbatim,
// with the line breaks her picture shows; the English is derived from it,
// and stays in the first person, since this is her page.
const BOLD_JOURNEY = 'https://boldjourney.com/meet-amelia-perrin/';

// She names the parts in English, in both languages. On the Japanese page
// they are marked as English so a screen reader says them as English words.
const labels = {
  about: 'About us',
  founder: 'Founder',
  experience: 'The experience',
  press: 'Media & press',
};
const en = locale === 'en' ? undefined : 'en';
const NBSP = String.fromCharCode(0xa0);

const copy = {
  en: {
    title: 'Luxury is an experience that enriches your life.',
    lead: [
      'What a trip is worth is not the number of places you saw, but the time you spent there.',
      'We stay close to what each guest hopes for, and bring you a Los Angeles trip that stays with you.',
    ],

    founderTitle: 'Because I have always loved to travel, there are moments I want to share with you.',
    founder: [
      'I grew up in Japan and now live in Southern California.',
      'In the many countries I have visited, I have known hospitality that stays with you, and the special time that only travel brings.',
      'I care about more than glamour: quiet attentiveness and comfort, so that you can enjoy your trip at ease.',
    ],
    portraitAlt: 'Portrait of the founder',

    coastAlt: 'A house on the cliffs above the Malibu coast at sunset',
    // Held together by no-break spaces, so a line never ends on a lone 'go.'
    expTitle: `Not only where${NBSP}you${NBSP}go. How you spend the time, in your own way.`,
    exp: [
      'More than a sightseeing tour: we plan a trip at your pace and around your wishes, one that lets you feel what Los Angeles really is.',
      'With real local knowledge and careful support in Japanese, even a first visit is one you can enjoy at ease.',
    ],

    press: [
      { name: 'Bold Journey', what: 'Founder interview', link: 'Read the article', href: BOLD_JOURNEY },
    ],

    closingTitle: 'A Los Angeles that is yours alone.',
    cta: 'Ask about your trip',
  },

  ja: {
    title: ['贅沢とは、', BR, '人生の価値になる体験。'],
    lead: [
      ['旅の価値は、', '訪れた場所の数ではなく、', 'そこでどんな時間を過ごしたか。'],
      ['一人ひとりの希望に寄り添い、', '心に残るロサンゼルスの旅を', 'お届けします。'],
    ],

    founderTitle: ['旅を愛してきたからこそ、', BR, '届けたい時間があります。'],
    founder: [
      '日本で育ち、現在は南カリフォルニアで暮らしています。',
      'これまでに訪れたさまざまな国で、心に残るホスピタリティや、旅がもたらす特別な時間を体験してきました。',
      '華やかさだけでなく、さりげない心配りや心地よさを大切にし、安心して楽しめる旅をご案内しています。',
    ],
    portraitAlt: '代表のポートレート',

    coastAlt: '夕日のマリブ海岸。崖の上に建つ邸宅',
    expTitle: ['行き先だけでなく、', BR, '過ごし方まで、', 'あなたらしく。'],
    exp: [
      '観光地を巡るだけでなく、あなたのペースやご希望に合わせて、ロサンゼルスの魅力を深く感じられる旅をご提案します。',
      '現地のリアルな情報と、日本語でのきめ細やかなサポートで、初めての方でも安心してお楽しみいただけます。',
    ],

    press: [
      { name: 'Bold Journey', what: '代表者インタビュー掲載', link: '記事を読む', href: BOLD_JOURNEY },
    ],

    closingTitle: ['あなただけの', 'ロサンゼルスを。'],
    cta: '旅のご相談はこちら',
  },
} as const;

const c = copy[locale];
---

{/* 1. About us: her headline and two short lines, on a compact head. */}
<section class="section head">
  <div class="measure measure--wide center">
    <p class="kicker" lang={en}>{labels.about}</p>
    <span class="rule"></span>
    <h1 class="h2 h2--page"><Phrases text={c.title} /></h1>
    {c.lead.map((para) => <p class="body head__lead"><Phrases text={para} /></p>)}
  </div>
</section>

{/* 2. Founder: her portrait beside the introduction. On a phone the heading
    runs full width and the text wraps around the portrait; from 640px the
    portrait is a column of its own. */}
<section class="section section--deep">
  <div class="measure--cards">
    <p class="kicker center" lang={en}>{labels.founder}</p>
    <span class="rule rule--center"></span>
    <div class="founder">
      <h2 class="h2 founder__title"><Phrases text={c.founderTitle} /></h2>
      <figure class="founder__figure">
        <Photo
          class="founder__photo"
          src={portrait}
          alt={c.portraitAlt}
          aspect={3 / 4}
          keep="top"
          sizes="(min-width: 640px) 240px, 124px"
          priority
        />
        {/* Her line: 「Amelia Kay Perrin | Founder」, in her capitals. The bar
            is a separator: a screen reader gets a comma in its place, and
            it is dropped where the two halves stack under a narrow portrait,
            which cannot hold the line on one row. */}
        <figcaption class="founder__caption" lang={en}>
          <span class="founder__name">Amelia Kay Perrin</span>
          <span class="sr-only">, </span>
          <span class="founder__bar" aria-hidden="true">|</span>
          <span class="founder__role">Founder</span>
        </figcaption>
      </figure>
      {c.founder.map((para) => <p class="body founder__para"><Phrases text={para} /></p>)}
    </div>
  </div>
</section>

{/* 3. The full-width California photo, then her short experience message. */}
<div class="band">
  <Photo class="band__photo" src={coast} alt={c.coastAlt} aspect={5 / 2} sizes="100vw" />
</div>

<section class="section">
  <div class="measure measure--wide center">
    <p class="kicker" lang={en}>{labels.experience}</p>
    <span class="rule"></span>
    <h2 class="h2 h2--statement"><Phrases text={c.expTitle} /></h2>
    {c.exp.map((para) => <p class="body exp__para"><Phrases text={para} /></p>)}
  </div>

  {/* 4. Media and press: one slim card. A list, so another credit is a line
      of data. */}
  <ul class="press measure--cards" role="list">
    {
      c.press.map((item) => (
        <li class="press__item">
          <span class="kicker press__label" lang={en}>{labels.press}</span>
          <span class="press__what">
            <span class="press__name" lang={en}>{item.name}</span>
            <span class="press__desc">{item.what}</span>
          </span>
          <a class="press__link" href={item.href} rel="noopener" target="_blank">
            {item.link}
            <Icon name="arrow-right" size={18} />
          </a>
        </li>
      ))
    }
  </ul>
</section>

{/* 5. Her closing line and the one gold button. */}
<section class="section section--deep">
  <div class="measure measure--wide center">
    <h2 class="h2 h2--statement"><Phrases text={c.closingTitle} /></h2>
    <span class="rule"></span>
    <a class="btn btn--solid btn--pill btn--end-icon closing__cta" href={p('/contact')}>
      {c.cta}
      <Icon name="arrow-right" size={18} />
    </a>
  </div>
</section>

<style>
  /* --------------------------------------------------------------- head */

  .head .rule {
    margin-block: 14px 18px;
  }

  .head__lead {
    margin-top: 14px;
  }
  .head__lead + .head__lead {
    margin-top: 6px;
  }

  /* ------------------------------------------------------------ founder */

  .founder {
    display: flow-root;
    max-width: 560px;
    margin: clamp(18px, 3vw, 28px) auto 0;
  }

  /* Centred on a phone, like every other heading on the page. Beside the
     portrait, from 640px, it starts where the text starts. */
  .founder__title {
    margin-bottom: 16px;
    text-align: center;
  }

  /* Beside the introduction, as she asked: on a phone the portrait floats
     and her three paragraphs run beside it, then under it. */
  .founder__figure {
    float: left;
    width: 124px;
    margin: 8px 16px 6px 0;
  }
  .founder__figure :global(picture) {
    display: block;
  }
  .founder__photo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-ctl);
  }

  .founder__caption {
    margin-top: 8px;
    line-height: 1.4;
  }
  .founder__name,
  .founder__role {
    display: block;
  }
  /* A name is set as it is written: never uppercased, never tracked apart. */
  .founder__name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }
  .founder__bar {
    display: none;
    color: var(--gold-text);
  }
  /* Her 'Founder', as she wrote it: the part names are capitals, her
     caption is not. */
  .founder__role {
    margin-top: 2px;
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--gold-text);
  }

  .founder__para + .founder__para {
    margin-top: 0.7em;
  }

  /* On the narrowest phones the text beside the portrait would run two or
     three words a line: the portrait sits above it instead. */
  @media (max-width: 359px) {
    .founder__figure {
      float: none;
      margin: 0 auto 16px;
      text-align: center;
    }
  }

  /* From here the portrait has a column to itself, with the heading and the
     text beside it and her name line on one row beneath. The figure spans
     more rows than there are, so a fourth paragraph needs no change here. */
  @media (min-width: 640px) {
    .founder {
      display: grid;
      grid-template-columns: 240px minmax(0, 1fr);
      column-gap: clamp(28px, 5vw, 48px);
      align-items: start;
      max-width: 820px;
    }
    .founder__figure {
      float: none;
      grid-column: 1;
      grid-row: 1 / span 12;
      width: auto;
      margin: 0;
    }
    .founder__title,
    .founder__para {
      grid-column: 2;
    }
    .founder__title {
      text-align: left;
    }
    .founder__caption {
      display: flex;
      align-items: baseline;
      gap: 10px;
      margin-top: 12px;
    }
    .founder__bar {
      display: inline;
    }
    .founder__role {
      margin-top: 0;
    }
  }

  /* --------------------------------------------------------------- band */

  .band :global(picture) {
    display: block;
  }
  .band__photo {
    display: block;
    width: 100%;
    height: clamp(150px, 32vw, 380px);
    object-fit: cover;
  }

  /* --------------------------------------------------------- experience */

  .exp__para {
    margin-top: 14px;
  }
  .exp__para + .exp__para {
    margin-top: 6px;
  }

  /* -------------------------------------------------------------- press */

  .press {
    list-style: none;
    margin: clamp(26px, 4vw, 40px) auto 0;
    padding: 0;
    display: grid;
    gap: 10px;
    max-width: 720px;
  }

  /* A slim card on the alternate cream. On a phone the label takes the first
     row; from 640px the three parts sit in one row, divided by hairlines. */
  .press__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 4px 16px;
    padding: 14px clamp(16px, 3vw, 24px);
    background: var(--bg-deep);
    border-radius: var(--radius-card);
  }
  .press__label {
    grid-column: 1 / -1;
  }
  .press__name,
  .press__desc {
    display: block;
  }
  .press__name {
    font-family: var(--font-label);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
  }
  .press__desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .press__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tap);
    font-size: 14px;
    font-weight: 600;
    color: var(--gold-text);
    text-decoration: underline;
    text-decoration-color: var(--hairline);
    text-underline-offset: 0.3em;
    white-space: nowrap;
    transition: color 0.3s ease;
  }
  .press__link:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  /* On the narrowest phones the description and the link no longer fit side
     by side, and 「代表者インタビュー掲載」 lost its last character to a second
     line. The link goes under it. */
  @media (max-width: 359px) {
    .press__item {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 640px) {
    .press__item {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0 24px;
    }
    .press__label {
      grid-column: auto;
      padding-right: 24px;
      border-right: 1px solid var(--hairline);
    }
    .press__what {
      text-align: center;
    }
    .press__link {
      padding-left: 24px;
      border-left: 1px solid var(--hairline);
    }
  }

  /* ------------------------------------------------------------ closing */

  /* Her long pill (09), as long as she drew it. */
  .closing__cta {
    width: min(100%, 328px);
    margin-top: 8px;
  }
  :global(html[lang='ja']) .closing__cta {
    font-size: 17px;
  }
</style>
