---
import { type Locale } from '../i18n/ui';
import { BR } from '../i18n/text';
import { localizePath } from '../i18n/utils';
import type { IconName } from '../data/icons';
import Icon from '../components/Icon.astro';
import InstagramStrip from '../components/InstagramStrip.astro';
import PhotoHero from '../components/PhotoHero.astro';
import Phrases from '../components/Phrases.astro';
import PlanList from '../components/PlanList.astro';
import heroImg from '../assets/hero-dusk.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = (path: string) => localizePath(path, locale);

const LDQ = String.fromCharCode(0x201c);
const RDQ = String.fromCharCode(0x201d);

// Amelia's Experience page, from her brief of 2026-11-05 (section 08): a
// short hero, how a trip comes together as four labels, the plans as the
// same compact cards the homepage shows, what lies beyond them, and
// Instagram. Her Japanese is verbatim; the English is derived from it.
const stepIcons: IconName[] = ['chat', 'doc', 'check-circle', 'plane'];

const copy = {
  en: {
    title: 'Not a set tour. A trip built around you.',
    heroAlt: 'A palm tree and a plane crossing the evening sky above a beach town',

    howTitle: 'How your trip comes together',
    // Short enough for one line each in the four-across row, like hers.
    steps: ['Consultation', 'Plan proposal', 'Review and adjust', 'Book and arrange'],

    plansTitle: 'Plans to suit what you came for',

    beyondTitle: 'Beyond the plans',
    beyondBody: 'An anniversary trip, a special experience: tell us what you want to do, and we will make it happen.',
    beyondCta: 'Talk to us',
  },

  ja: {
    title: ['決まった旅ではなく、', BR, 'あなたに合わせて', 'つくる旅を。'],
    heroAlt: '夕暮れの空を横切る飛行機と、海辺の街のヤシの木',

    howTitle: '旅ができるまで',
    steps: ['ご相談', 'プラン提案', 'ご確認・調整', 'ご予約・手配'],

    plansTitle: ['目的に合わせて選べる、', '旅のプラン'],

    beyondTitle: 'プランのその先へ',
    beyondBody: [
      '記念日旅行や、',
      '特別な体験など、',
      `あなたの${LDQ}やりたい${RDQ}を`,
      'カタチにします。',
    ],
    beyondCta: 'ご相談はこちら',
  },
} as const;

const c = copy[locale];
---

{/* 01 Hero: her heading and nothing else, on a short photo band. The photo
    is a tall one; the band takes its upper part, sky to horizon. */}
<PhotoHero
  src={heroImg}
  alt={c.heroAlt}
  size="short"
  aspect={3 / 2}
  keep="top"
  focus="50% 40%"
  priority
>
  <h1 class="h2 hero__title"><Phrases text={c.title} /></h1>
</PhotoHero>

{/* 02 How it works: four icon labels. One row where all four fit at full
    size, two by two on a phone, which is the fallback she gave. */}
<section class="section how">
  <h2 class="h2 center how__title">{c.howTitle}</h2>
  {/* role="list": Safari stops calling a list without markers a list, and
      these four are in order. The number is text, so it is read out. */}
  <ol class="steps measure--cards" role="list">
    {
      c.steps.map((label, i) => (
        <li class="step">
          <span class="step__icon">
            <Icon name={stepIcons[i]} size={26} />
          </span>
          <span class="step__n">{i + 1}</span>
          <span class="step__label">{label}</span>
        </li>
      ))
    }
  </ol>
</section>

{/* 03 The plans: her heading, no introduction, no exchange rate. */}
<section class="section section--deep" id="plans">
  <h2 class="h2 center plans__title"><Phrases text={c.plansTitle} /></h2>
  <PlanList locale={locale} />
</section>

{/* 05 Beyond the plans: her heading, her line, and the page's one inquiry
    button. */}
<section class="section beyond">
  <div class="measure measure--wide center">
    <h2 class="h2">{c.beyondTitle}</h2>
    <span class="rule"></span>
    <p class="body"><Phrases text={c.beyondBody} /></p>
    <a class="btn btn--solid beyond__cta" href={p('/contact')}>
      {c.beyondCta}
      <Icon name="arrow-right" size={18} />
    </a>
  </div>
</section>

{/* 06 Instagram, as a strip. */}
<InstagramStrip locale={locale} />

<style>
  /* On the photograph's plate, so --ink is the ivory of a dark surface. */
  .hero__title {
    color: var(--ink);
    text-shadow: 0 1px 24px rgba(8, 8, 8, 0.55);
  }

  /* -------------------------------------------------------------- steps */

  .how__title {
    margin-bottom: clamp(20px, 3vw, 30px);
  }

  /* Two by two on a phone. A row of four gives each label a quarter of the
     screen, and 「ご確認・調整」 is six characters: it does not fit a 76px
     column at any size she would accept. From 560px all four sit in one row,
     each label on one line. */
  .steps {
    position: relative;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 12px;
    max-width: 640px;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }

  .step__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--bg-deep);
    color: var(--gold-text);
  }

  /* The label face in both languages. Cormorant's own 1 is drawn like a
     capital I, and asking it for lining figures did nothing in WebKit: the
     row read I, 2, 3, 4. */
  .step__n {
    margin-top: 6px;
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    color: var(--gold-text);
  }

  .step__label {
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.5;
    color: var(--ink);
    text-wrap: balance;
  }
  :global(html[lang='ja']) .step__label {
    font-family: var(--font-body);
    font-size: 15px;
    white-space: nowrap;
  }

  @media (min-width: 560px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }
    /* A dashed line through the four icons, first to last: it says "in this
       order". It runs behind them; each icon's disc covers it. */
    .steps::before {
      content: '';
      position: absolute;
      top: 28px;
      left: 12.5%;
      right: 12.5%;
      border-top: 1px dashed var(--hairline);
    }
  }

  /* -------------------------------------------------------------- plans */

  .plans__title {
    margin-bottom: clamp(22px, 4vw, 34px);
  }

  /* ------------------------------------------------------------- beyond */

  .beyond .rule {
    margin-block: 14px 16px;
  }

  .beyond__cta {
    margin-top: clamp(18px, 3vw, 26px);
  }
</style>
