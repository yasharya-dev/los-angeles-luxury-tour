---
import { type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import ContactForm from '../components/ContactForm.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = (path: string) => localizePath(path, locale);

// The page for people who do not know their plan yet. The other path, for
// people who do, is one link away at the bottom.
const copy = {
  en: {
    kicker: 'Consultation',
    title: ['Tell us what you have in mind.'],
    lead: 'A tailor-made trip, a question about a plan, or no idea where to start yet. All of it belongs here.',
    asideText: 'Know your plan already?',
    asideLink: 'Book it directly',
  },
  ja: {
    kicker: 'ご相談',
    title: ['ご希望を、', 'お聞かせください。'],
    lead: 'オーダーメイドのご希望も、プランについてのご質問も。まだ何も決まっていなくても大丈夫です。',
    asideText: 'プランがお決まりの方は、',
    asideLink: 'ご予約フォームへ',
  },
} as const;

const c = copy[locale];
---

<section class="section head">
  <div class="measure measure--wide center">
    <p class="kicker">{c.kicker}</p>
    <h1 class="h2 head__title">
      {c.title.map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </h1>
    <p class="body">{c.lead}</p>
  </div>
</section>

<ContactForm locale={locale} />

<section class="section section--deep aside">
  <p class="body center measure">
    {c.asideText} <a href={p('/book')}>{c.asideLink}</a>
  </p>
</section>

<style>
  .head {
    padding-block: clamp(64px, 9vw, 110px) clamp(40px, 6vw, 64px);
  }
  .head__title {
    margin-block: 26px;
  }
  .aside {
    padding-block: clamp(40px, 6vw, 64px);
  }
  .aside .measure {
    margin-inline: auto;
  }
  /* The link is short; keep it whole rather than orphan its last character. */
  .aside a {
    white-space: nowrap;
  }
</style>
