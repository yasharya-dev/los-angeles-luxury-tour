---
import { type Locale } from '../i18n/ui';
import { BR } from '../i18n/text';
import { localizePath } from '../i18n/utils';
import type { IconName } from '../data/icons';
import Divider from '../components/Divider.astro';
import Icon from '../components/Icon.astro';
import PhotoHero from '../components/PhotoHero.astro';
import Phrases from '../components/Phrases.astro';
import PlanList from '../components/PlanList.astro';
import Reservation from '../components/Reservation.astro';
import heroImg from '../assets/hero-dtla.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = (path: string) => localizePath(path, locale);

// Amelia's homepage, in her six sections (brief of 2026-11-05): hero, value,
// three reasons, plans, the reservation note, contact. Her Japanese is
// verbatim, written as phrases so a phone folds each line where she would;
// the English is derived from it.
const reasonIcons: IconName[] = ['users', 'car', 'map'];
// A place a line may fold that takes no room when it does not.
const FOLD = String.fromCharCode(0x200b);
// A space a line may not fold at.
const NBSP = String.fromCharCode(0xa0);

const copy = {
  en: {
    heroEyebrow: ['By reservation only', 'Private tours in Japanese'],
    // Held together by no-break spaces, so no width leaves 'is yours alone.'
    // or a lone word.
    heroTitle: `A Los Angeles journey that${NBSP}is${NBSP}yours${NBSP}alone.`,
    heroAlt: 'Palm-lined road above downtown Los Angeles at golden hour',
    cta: 'Ask about your trip',

    valueKicker: 'Peace of mind, enjoyment, satisfaction',
    valueTitle: 'Los Angeles, with more freedom and more luxury.',
    valueBody:
      `A Japanese guide based in Los${NBSP}Angeles supports a trip made just for you, from getting around to seeing the sights.`,

    reasonsTitle: 'Three reasons guests choose us',
    reasons: [['At ease, in Japanese'], ['A luxury car, fully private'], ['A trip made to order']],

    plansTitle: 'Tours & services',
    plansLead: 'Plans to suit the way you like to travel.',

    closingTitle: 'How would you like to spend your time in Los Angeles?',
    closingBody:
      'Your plans do not need to be decided yet. Ask us anything. You will usually hear back within 24 hours.',
  },

  ja: {
    heroEyebrow: ['完全予約制', '日本語対応プライベートツアー'],
    heroTitle: ['ロサンゼルスで叶える、', BR, 'あなただけの特別な旅。'],
    heroAlt: '夕暮れのロサンゼルス。ヤシ並木とダウンタウンの眺め',
    cta: '旅のご相談はこちら',

    valueKicker: '安心も、楽しさも、満足も。',
    valueTitle: ['ロサンゼルスを、', BR, 'もっと自由に。', 'もっと贅沢に。'],
    valueBody: [
      '現地在住の日本人ガイドが、',
      '移動から観光まで、',
      'お客様だけの旅をサポートします。',
    ],

    reasonsTitle: '選ばれる3つの理由',
    // Her breaks, used wherever the cards are too narrow for one line (every
    // phone); from 540px each title runs on one line, as she prefers.
    reasons: [['日本語で安心'], ['高級車で', '完全貸切'], ['オーダーメイドの', '旅']],

    plansTitle: 'ツアー・サービス',
    plansLead: '旅のスタイルに合わせたプランをご用意しています。',

    closingTitle: ['ロサンゼルスで、', BR, 'どんな時間を', '過ごしたいですか？'],
    closingBody: [
      '旅のプランが決まっていなくても、',
      'お気軽にご相談ください。',
      '通常24時間以内にご返信いたします。',
    ],
  },
} as const;

const c = copy[locale];

---

{/* 01 Hero. About half the screen, so the next section starts in view. */}
<PhotoHero src={heroImg} alt={c.heroAlt} size="tall" focus="32% 50%" priority>
  {/* Her label, 「完全予約制｜日本語対応プライベートツアー」. Each half stays
      whole. The bar is a separator, so it is hidden from a screen reader, and
      where the two halves cannot share a line it is dropped and they stack. */}
  <p class="hero__eyebrow">
    {c.heroEyebrow.map((part, i) => (
      <>
        {i > 0 && (
          <>
            <span class="sr-only">{locale === 'ja' ? '、' : ', '}</span>
            <span class="hero__bar" aria-hidden="true">｜</span>
          </>
        )}
        <span class="hero__part">{part}</span>
      </>
    ))}
  </p>
  <span class="rule rule--center hero__rule"></span>
  <h1 class="display hero__title"><Phrases text={c.heroTitle} /></h1>
  <a class="btn btn--solid hero__cta" href={p('/contact')}>
    {c.cta}
    <Icon name="arrow-right" size={18} />
  </a>
</PhotoHero>

{/* 02 Value: her eyebrow, heading and one line. */}
<section class="section value">
  <div class="measure measure--wide center">
    <p class="kicker">{c.valueKicker}</p>
    <span class="rule"></span>
    <h2 class="h2"><Phrases text={c.valueTitle} /></h2>
    <p class="body value__body"><Phrases text={c.valueBody} /></p>
  </div>
</section>

{/* 03 Three reasons: icon and title only, side by side at every width. */}
<section class="section reasons">
  <Divider />
  <h2 class="h2 center reasons__title">{c.reasonsTitle}</h2>
  <ul class="reasons__list measure--cards" role="list">
    {
      c.reasons.map((title, i) => (
        <li class="reason panel">
          <Icon name={reasonIcons[i]} size={36} class="reason__icon" />
          <h3 class="reason__title">
            {/* One piece of text, with an invisible fold where she breaks
                the line. As separate elements, or with a <br> between, WebKit
                left a gap after 「オーダーメイドの」 wherever the title ran on
                one line. */}
            {title.join(FOLD)}
          </h3>
        </li>
      ))
    }
  </ul>
</section>

{/* 04 Plans: every plan, as compact cards under its tier. The same list
    the Experience page shows. */}
<section class="section section--deep" id="plans">
  <div class="measure measure--wide center plans__head">
    <h2 class="h2">{c.plansTitle}</h2>
    <span class="rule"></span>
    <p class="body"><Phrases text={c.plansLead} /></p>
  </div>

  <PlanList locale={locale} />
</section>

{/* 05 and 06: the reservation note, then the contact call, close together. */}
<section class="section closing">
  <Reservation locale={locale} />
  <div class="measure measure--wide center closing__text">
    <h2 class="h2"><Phrases text={c.closingTitle} /></h2>
    <Divider />
    <p class="body"><Phrases text={c.closingBody} /></p>
    <a class="btn btn--solid closing__cta" href={p('/contact')}>
      {c.cta}
      <Icon name="arrow-right" size={18} />
    </a>
  </div>
</section>

<style>
  /* -------------------------------------------------------------- hero */

  /* On the photograph's plate, so these tokens are the dark-surface ones. */
  .hero__eyebrow {
    margin: 0;
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .hero__part {
    display: inline-block;
    white-space: nowrap;
  }
  .hero__bar {
    margin-inline: 0.5em;
    opacity: 0.7;
  }

  /* Her label is 21 characters. At 14px with this tracking it is 312px, and a
     360px phone has 320px to give it, so it stays on one line. */
  :global(html[lang='ja']) .hero__eyebrow {
    font-family: var(--font-body);
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: none;
  }
  :global(html[lang='ja']) .hero__bar {
    margin-inline: 0;
  }

  /* The English label is 45 letters and never fits one line on a phone:
     the halves stack, without the bar. */
  @media (max-width: 599px) {
    :global(html[lang='en']) .hero__bar {
      display: none;
    }
    :global(html[lang='en']) .hero__part {
      display: block;
    }
  }
  /* Hers stops fitting one line under 340px. The second half goes under the
     first, and her bar stays where her label has it, after 完全予約制. */
  @media (max-width: 339px) {
    :global(html[lang='ja']) .hero__part:last-child {
      display: block;
    }
  }

  .hero__rule {
    margin-block: 14px 18px;
  }

  .hero__title {
    color: var(--ink);
    text-shadow: 0 1px 24px rgba(8, 8, 8, 0.55);
  }

  .hero__cta {
    margin-top: clamp(22px, 4vh, 34px);
  }

  /* ------------------------------------------------------------- value */

  .value .rule {
    margin-block: 14px 18px;
  }

  .value__body {
    margin-top: 16px;
  }

  /* ----------------------------------------------------------- reasons */

  /* Continues the value section: one thought, so no second full gap. */
  .reasons {
    padding-top: 0;
  }

  .reasons__title {
    margin-block: 18px clamp(20px, 3vw, 30px);
  }

  /* Three equal cards side by side on every screen, as she asked. On a phone
     the row keeps the page's gutters, the gaps close to 4px and the cards
     carry no side padding: her longest line, 「オーダーメイドの」, is eight
     full-width characters, and a third of a 360px screen is all it has. A
     wider gap takes the title under her 14px at 375px. */
  .reasons__list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(6px, 2vw, 22px);
  }
  @media (max-width: 480px) {
    .reasons__list {
      gap: 4px;
    }
  }

  .reason {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    padding: clamp(16px, 3.2vw, 28px) 0;
    text-align: center;
    /* The title is sized from the card it has to fit, below. */
    container-type: inline-size;
  }

  .reason :global(.reason__icon) {
    color: var(--gold-deco);
  }

  .reason__title {
    margin: 0;
    padding-inline: 4px;
    font-family: var(--font-label);
    /* Her 14px floor for a label, from the narrowest phone this layout has. */
    font-size: clamp(14px, 3.6vw, 15px);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.5;
    color: var(--ink);
    text-wrap: balance;
  }

  /* Her longest line, 「オーダーメイドの」, must not fold. Set with
     proportional kana it is 7.1 characters wide in Chromium and in WebKit,
     so the size is the card's width over 7.6: the line fits with a little
     air. The width is inside the card's border. That is 13.4px on a 360px
     phone and her 14px floor from 374px, which is every iPhone. (The vw line
     is for a browser without container units.) */
  :global(html[lang='ja']) .reason__title {
    padding-inline: 0;
    font-family: var(--font-body);
    font-size: clamp(12.5px, 3.75vw, 17px);
    font-size: clamp(12.5px, calc(100cqi / 7.6), 17px);
    letter-spacing: 0;
    line-height: 1.55;
    text-wrap: initial;
  }
  /* The title folds at her breaks and nowhere else: keep-all rules out a
     fold between two characters, which leaves the invisible one she is given
     in the markup. On a phone the title is made as narrow as its longest
     line, so it does fold there, into her two lines. */
  :global(html[lang='ja']) .reason__title {
    width: min-content;
    word-break: keep-all;
    overflow-wrap: normal;
  }

  /* Up to 355px (an iPhone in Display Zoom is 320) a third of the screen
     cannot hold her line at any honest size, and an English title at 14px
     leaves 'car,' alone. The cards become three rows, icon beside title, at
     full size. */
  @media (max-width: 355px) {
    .reasons__list {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      margin-inline: 0;
    }
    .reason {
      flex-direction: row;
      gap: 14px;
      padding: 12px 16px;
      text-align: left;
    }
    .reason__title,
    :global(html[lang='ja']) .reason__title {
      width: auto;
      font-size: 15px;
    }
  }

  /* From here the cards are wide enough for each title on one line, with air
     either side: at 540px a card holds 155px inside its border, and
     「オーダーメイドの旅」 needs 138px at 17px. (At 500px it was 3px a side.) */
  @media (min-width: 540px) {
    :global(html[lang='ja']) .reason__title {
      width: auto;
    }
  }

  /* ------------------------------------------------------------- plans */

  .plans__head .rule {
    margin-block: 14px;
  }

  .plans__head {
    margin-bottom: clamp(24px, 4vw, 36px);
  }

  /* ----------------------------------------------------------- closing */

  .closing__text {
    margin-top: clamp(32px, 5vw, 48px);
  }

  .closing__text :global(.divider) {
    margin-block: 18px;
  }

  .closing__cta {
    margin-top: clamp(20px, 3vw, 28px);
  }
</style>
