---
import { type Locale } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/utils';
import { byTier, capabilities, tierOrder, type Tier } from '../data/offerings';
import Divider from '../components/Divider.astro';
import Reservation from '../components/Reservation.astro';
import heroImg from '../assets/hero-dtla.jpg';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const p = (path: string) => localizePath(path, locale);

// Built by code point so the source stays ASCII.
const EM = String.fromCharCode(0x2014);
const RSQ = String.fromCharCode(0x2019);

// JA display lines are arrays because the breaks are authored: Japanese has
// no spaces and auto-wrap lands mid-clause. EN uses text-wrap: balance.
const copy = {
  en: {
    heroKicker: 'Private transportation & tour service',
    heroTitle: [
      `The best journeys don${RSQ}t just show you new places.`,
      'They help you discover new ways of seeing your life.',
    ],
    heroLead: `Peace of mind is part of a good trip. A Japanese guide who lives here listens to what you want ${EM} and makes your time in Los Angeles that much more special.`,
    heroAlt: 'Palm-lined road above downtown Los Angeles at golden hour',

    reassureKicker: 'Peace of mind, enjoyment, satisfaction',
    reassureTitle: ['Los Angeles, with more freedom and more luxury.'],
    reassureBody: [
      'Los Angeles is a car city, and the places worth seeing are spread across a wide area. With limited time, how you get around and which route you take matter as much as where you go.',
      'As a private service, by reservation only, a Japanese guide who lives here supports you with everything from the driving to the sightseeing plan, shaped around each guest.',
      `Luxury, to us, is time that becomes an experience you keep for life. Leave the driving and the logistics to us ${EM} and enjoy your time in Los Angeles freely, at ease, and to the full.`,
    ],

    whyKicker: 'Why Los Angeles Luxury Tour',
    pillars: [
      {
        title: ['Peace of mind, in Japanese, down to the details'],
        body: 'A Japanese guide who lives here supports you carefully, down to the smallest wish for the trip.',
      },
      {
        title: ['Fully private. The trip moves at your pace.'],
        body: `Where you go and how you spend the hours ${EM} free, and shaped to each guest.`,
      },
      {
        title: ['Limited time, made into something worth keeping'],
        body: `A day proposed around your interests and what you came for ${EM} yours alone.`,
      },
    ],

    offersTitle: ['The plans we offer'],
    offersLead: `A set of plans to choose from, shaped to what you want. On a private tour the destinations and the pace are yours to set ${EM} a plan proposed for that day alone.`,

    closingTitle: ['How would you like to spend your time in Los Angeles?'],
    closingBody:
      'Write in Japanese or English. You will usually hear back within 24 hours.',
  },

  ja: {
    heroKicker: '完全予約制｜VIP送迎＆貸切プライベートツアー',
    heroTitle: ['ロサンゼルスで叶える、', 'あなただけの特別な旅。'],
    heroLead:
      '安心して過ごせることも、旅の質のひとつ。現地在住の日本人ガイドが、あなたのご希望に寄り添い、ロサンゼルスでの時間を、より特別なものに。',
    heroAlt: '夕暮れのロサンゼルス。ヤシ並木とダウンタウンの眺め',

    reassureKicker: '安心も、楽しさも、満足も。',
    reassureTitle: ['ロサンゼルスを、もっと自由に。', 'もっと贅沢に。'],
    reassureBody: [
      'ロサンゼルスは、見どころが広いエリアに点在する車社会の街。限られた時間を有効に楽しむには、移動手段やルート選びも旅の大切なポイントです。',
      '完全予約制のプライベートサービスとして、現地在住の日本人ガイドが、移動から観光プランまで一人ひとりに合わせてサポート。',
      '私たちが考えるラグジュアリーとは、その時間そのものが、人生に残る価値ある体験になること。移動や段取りはおまかせいただき、ロサンゼルスでの時間を、安心して自由に、心からお楽しみください。',
    ],

    whyKicker: 'Los Angeles Luxury Tour が選ばれる理由',
    pillars: [
      {
        title: ['日本語で、', '細部まで行き届く安心を。'],
        body: '現地在住の日本人ガイドが、旅の細かなご希望まで丁寧にサポート。',
      },
      {
        title: ['完全貸切。', '旅は、あなたのペースで。'],
        body: '行き先も、時間の使い方も。一人ひとりのご希望に合わせて自由に。',
      },
      {
        title: ['限られた時間を、', '価値ある体験へ。'],
        body: 'お客様の興味や目的に合わせて、その方だけの一日をご提案。',
      },
    ],

    offersTitle: ['ご用意しているプラン'],
    offersLead:
      'ご希望に合わせて選べるプランをご用意しています。貸切ツアーは、行き先も時間の使い方も自由に。その日だけのプランをご提案します。',

    closingTitle: ['ロサンゼルスで、', 'どんな時間を過ごしたいですか？'],
    closingBody: '日本語でお気軽にどうぞ。通常24時間以内にご返信いたします。',
  },
} as const;

const c = copy[locale];

// The Japanese kicker may break only at the ｜, never inside a word. Japanese
// has no spaces, so without this a narrow phone breaks プライベートツアー in half.
const kickerParts = c.heroKicker.split('｜');

const tierCta: Record<Tier, string> = {
  signature: t('cta.journeys'),
  day: t('cta.days'),
  transport: t('cta.transport'),
};
const tierLabel: Record<Tier, string> = {
  signature: t('tier.signature'),
  day: t('tier.day'),
  transport: t('tier.transport'),
};
---

<section class="hero">
  <img
    class="hero__img"
    src={heroImg.src}
    alt={c.heroAlt}
    width={heroImg.width}
    height={heroImg.height}
    fetchpriority="high"
  />
  <div class="hero__scrim"></div>
  <div class="hero__inner">
    <p class="kicker hero__kicker">
      {kickerParts.length > 1
        ? kickerParts.map((part, i) => (
            <>
              {i > 0 && '｜'}
              <span class="nowrap">{part}</span>
            </>
          ))
        : c.heroKicker}
    </p>
    <h1 class="display hero__title">
      {c.heroTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </h1>
    <p class="hero__lead">{c.heroLead}</p>
    <div class="hero__cta">
      <a class="btn" href={p('/contact')}>{t('cta.begin')}</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="measure measure--wide center">
    <p class="kicker">{c.reassureKicker}</p>
    <h2 class="h2 section__title">
      {c.reassureTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </h2>
    {c.reassureBody.map((para) => <p class="body reassure__para">{para}</p>)}
  </div>
</section>

<Divider />

<section class="section">
  <div class="measure--grid center pillars-head">
    <p class="kicker">{c.whyKicker}</p>
  </div>
  <ul class="pillars measure--grid">
    {
      c.pillars.map((pillar) => (
        <li class="pillar">
          <h3 class="h3 pillar__title">
            {pillar.title.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))}
          </h3>
          <p class="body pillar__body">{pillar.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<section class="section section--deep section--wedged" id="journeys">
  <div class="measure measure--wide center offers__head">
    <h2 class="h2 section__title">
      {c.offersTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </h2>
    <p class="body">{c.offersLead}</p>
  </div>

  <div class="tiers measure--cards">
    {
      tierOrder.map((tier) => (
        <section class="tier" aria-labelledby={`tier-${tier}`}>
          <h3 class="tier__label" id={`tier-${tier}`}>
            {tierLabel[tier]}
          </h3>
          <ul class="tier__list">
            {byTier(tier).map((o) => (
              <li class="offer">
                <div class="offer__text">
                  <p class="offer__name">{o.name[locale]}</p>
                  <p class="offer__blurb">{o.blurb[locale]}</p>
                </div>
                <p class="offer__price">
                  <span class="offer__amount">{o.price[locale]}</span>
                  {o.priceNote?.[locale] && (
                    <span class="offer__unit">{o.priceNote[locale]}</span>
                  )}
                </p>
              </li>
            ))}
          </ul>
          <a class="tier__cta" href={p('/experience')}>
            {tierCta[tier]} <span aria-hidden="true">&rarr;</span>
          </a>
        </section>
      ))
    }
  </div>

  <div class="measure--cards offers__foot">
    <p class="caption">{capabilities[locale]}</p>
    {t('price.note') && <p class="caption offers__rate">{t('price.note')}</p>}
  </div>
</section>

<section class="section">
  <Reservation locale={locale} />
</section>

<section class="section section--deep">
  <div class="measure measure--wide center">
    <h2 class="h2 section__title">
      {c.closingTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </h2>
    <p class="body closing__body">{c.closingBody}</p>
    <a class="btn" href={p('/contact')}>{t('cta.start')}</a>
  </div>
</section>

<style>
  /* ------------------------------------------------------------- hero */

  .hero {
    position: relative;
    min-height: min(66svh, 620px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Heavier at the bottom so the CTA contrasts with the plate, not the photo. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(8, 8, 8, 0.66) 0%,
      rgba(8, 8, 8, 0.58) 40%,
      rgba(8, 8, 8, 0.82) 100%
    );
  }

  .hero__inner {
    position: relative;
    text-align: center;
    padding: clamp(56px, 9vh, 96px) 24px;
    max-width: 860px;
    animation: fadeIn 1.1s ease both;
  }

  .hero__kicker {
    margin-bottom: 26px;
    letter-spacing: 0.38em;
    color: rgba(245, 245, 250, 0.85);
  }
  .nowrap {
    white-space: nowrap;
  }

  .hero__title {
    text-shadow: 0 1px 34px rgba(8, 8, 8, 0.5);
    color: #d4af37;
  }

  .hero__lead {
    margin: 30px auto 0;
    max-width: var(--measure-narrow);
    font-size: clamp(15px, 2vw, 17px);
    line-height: 1.85;
    color: rgba(245, 245, 250, 0.88);
    text-wrap: pretty;
  }

  :global(html[lang='ja']) .hero__lead {
    line-height: 2.1;
    text-wrap: initial;
  }

  .hero__cta {
    margin-top: 44px;
    display: flex;
    justify-content: center;
  }

  /* Plate is always dark, so these are literal rather than tokens. */
  .hero :global(.btn) {
    color: #d4af37;
    border-color: rgba(212, 175, 55, 0.75);
  }
  .hero :global(.btn:hover) {
    background: rgba(212, 175, 55, 0.12);
    color: #f5f5fa;
  }

  /* ---------------------------------------------------------- sections */

  .section__title {
    margin-block: 30px;
  }

  .reassure__para + .reassure__para {
    margin-top: 1.1em;
  }

  /* ---------------------------------------------------------- pillars */

  .pillars-head {
    margin-inline: auto;
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .pillars {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    gap: clamp(40px, 6vw, 56px);
    grid-template-columns: 1fr;
    text-align: center;
  }

  @media (min-width: 720px) {
    .pillars {
      grid-template-columns: repeat(3, 1fr);
      /* JA runs ~40% shorter; don't derive height from text. */
      align-items: start;
    }
  }

  .pillar__title {
    margin-bottom: 18px;
  }

  .pillar__body {
    max-width: 34ch;
    margin-inline: auto;
  }

  /* ------------------------------------------------------------ offers */

  .offers__head {
    margin-inline: auto;
    margin-bottom: clamp(48px, 7vw, 72px);
  }

  .tiers {
    margin-inline: auto;
    display: grid;
    gap: clamp(44px, 6vw, 64px);
  }

  .tier__label {
    margin: 0 0 var(--gap-lg);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--hairline-soft);
    font-family: var(--font-label);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  :global(html[lang='ja']) .tier__label {
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.22em;
    text-transform: none;
  }

  .tier__list {
    list-style: none;
    margin: 0 0 var(--gap-lg);
    padding: 0;
  }

  .offer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap-md);
    flex-wrap: wrap;
    padding: 18px 0;
    border-bottom: 1px solid var(--hairline-soft);
  }

  .offer__text {
    flex: 1 1 16rem;
  }

  .offer__name {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: clamp(18px, 2.2vw, 21px);
    color: var(--ink);
  }

  :global(html[lang='ja']) .offer__name {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.9vw, 17px);
    font-weight: 500;
  }

  .offer__blurb {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  /* Never wrap mid-figure; the row wraps around it. When it does wrap onto
     its own line, auto margin keeps it on the right edge, so amount and
     unit share an edge instead of each amount landing wherever its unit's
     width puts it. */
  .offer__price {
    margin: 0 0 0 auto;
    text-align: right;
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .offer__amount {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(17px, 2.1vw, 20px);
    color: var(--gold-text);
  }

  :global(html[lang='ja']) .offer__amount {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(15px, 1.9vw, 17px);
  }

  .offer__unit {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .tier__cta {
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    /* Standalone CTA, so it owns a 24px target rather than borrowing the
       inline exception. */
    display: inline-block;
    padding-block: 4px;
  }

  :global(html[lang='ja']) .tier__cta {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: none;
  }

  .offers__foot {
    margin: clamp(40px, 6vw, 56px) auto 0;
    text-align: center;
  }

  .offers__rate {
    margin-top: 10px;
    color: var(--ink-soft);
    font-size: 12px;
  }

  /* ----------------------------------------------------------- closing */

  .closing__body {
    margin-bottom: 40px;
  }
</style>
