---
import { type Locale } from '../i18n/ui';
import { BR } from '../i18n/text';
import { localizePath } from '../i18n/utils';
import type { IconName } from '../data/icons';
import Divider from '../components/Divider.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import PhotoHero from '../components/PhotoHero.astro';
import Phrases from '../components/Phrases.astro';
import PlanList from '../components/PlanList.astro';
import Reservation from '../components/Reservation.astro';
import heroImg from '../assets/hero-hollywood.webp';
import heroUpright from '../assets/hero-hollywood-upright.webp';
import fronds from '../assets/palm-shadows-plaster.webp';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = (path: string) => localizePath(path, locale);

// Amelia's homepage, in her six sections (brief of 2026-11-05): hero, value,
// three reasons, plans, the reservation note, contact. Her Japanese is
// verbatim, written as phrases so a phone folds each line where she would;
// the English is derived from it.
const reasonIcons: IconName[] = ['users', 'car', 'map'];
// A place a line may fold that takes no room when it does not.
const FOLD = String.fromCharCode(0x200b);
// A space a line may not fold at.
const NBSP = String.fromCharCode(0xa0);

const copy = {
  en: {
    heroEyebrow: ['By reservation only', 'Private tours in Japanese'],
    // Held together by no-break spaces, so no width leaves 'is yours alone.'
    // or a lone word.
    heroTitle: `A Los Angeles journey that${NBSP}is${NBSP}yours${NBSP}alone.`,
    // Both photos show this; only the landscape one shows downtown.
    heroAlt: 'The Hollywood Sign lit by the setting sun',
    cta: 'Ask about your trip',

    valueKicker: 'Peace of mind, enjoyment, satisfaction',
    valueTitle: 'Los Angeles, with more freedom and more luxury.',
    valueBody:
      `A Japanese guide based in Los${NBSP}Angeles supports a trip made just for you, from getting around to seeing the sights.`,

    reasonsTitle: 'Three reasons guests choose us',
    reasons: [['At ease, in Japanese'], ['A luxury car, fully private'], ['A trip made to order']],

    plansTitle: 'Tours & services',
    plansLead: 'Plans to suit the way you like to travel.',

    closingTitle: 'How would you like to spend your time in Los Angeles?',
    closingBody:
      'Your plans do not need to be decided yet. Ask us anything. You will usually hear back within 24 hours.',
  },

  ja: {
    heroEyebrow: ['完全予約制', '日本語対応プライベートツアー'],
    heroTitle: ['ロサンゼルスで叶える、', BR, 'あなただけの特別な旅。'],
    heroAlt: '夕日に照らされたハリウッドサイン',
    cta: '旅のご相談はこちら',

    valueKicker: '安心も、楽しさも、満足も。',
    valueTitle: ['ロサンゼルスを、', BR, 'もっと自由に。', 'もっと贅沢に。'],
    valueBody: [
      '現地在住の日本人ガイドが、',
      '移動から観光まで、',
      'お客様だけの旅をサポートします。',
    ],

    reasonsTitle: '選ばれる3つの理由',
    // Her breaks, used wherever the cards are too narrow for one line (every
    // phone); from 540px each title runs on one line, as she prefers.
    reasons: [['日本語で安心'], ['高級車で', '完全貸切'], ['オーダーメイドの', '旅']],

    plansTitle: 'ツアー・サービス',
    plansLead: '旅のスタイルに合わせたプランをご用意しています。',

    closingTitle: ['ロサンゼルスで、', BR, 'どんな時間を', '過ごしたいですか？'],
    closingBody: [
      '旅のプランが決まっていなくても、',
      'お気軽にご相談ください。',
      '通常24時間以内にご返信いたします。',
    ],
  },
} as const;

const c = copy[locale];

---

{/* 01 Hero. About half the screen, so the next section starts in view. The
    sign at sunset over the hillside, as in her picture (01): the sign stays
    clear of the words on every screen. Its letters start 360px down the
    941px photo and its legs end at 518px; they run from 845 to 1455px
    across the 1672. An upright phone has a photo of its own, taken upright
    as her picture is, the sign small on the right: its letters run from
    607 to 746px across the 941px photo and its legs end 984px down the
    1672. The mast above the sign starts at 790px, and the landmark's top
    takes it in, so the hero makes room for it. */}
<PhotoHero
  src={heroImg}
  alt={c.heroAlt}
  size="tall"
  focus="81% 50%"
  landmark={{ top: 360 / 941, foot: 518 / 941, left: 845 / 1672, right: 1455 / 1672 }}
  upright={{
    src: heroUpright,
    landmark: { top: 790 / 1672, foot: 984 / 1672, left: 607 / 941, right: 746 / 941 },
  }}
  priority
>
  {/* Her label, 「完全予約制｜日本語対応プライベートツアー」. Each half stays
      whole. The bar is a separator, so it is hidden from a screen reader, and
      where the two halves cannot share a line it is dropped and they stack. */}
  <p class="hero__eyebrow">
    {c.heroEyebrow.map((part, i) => (
      <>
        {i > 0 && (
          <>
            <span class="sr-only">{locale === 'ja' ? '、' : ', '}</span>
            <span class="hero__bar" aria-hidden="true">｜</span>
          </>
        )}
        <span class="hero__part">{part}</span>
      </>
    ))}
  </p>
  <span class="rule rule--center hero__rule"></span>
  <h1 class="display hero__title"><Phrases text={c.heroTitle} /></h1>
  <a class="btn btn--solid btn--champagne btn--pill btn--end-icon hero__cta" href={p('/contact')}>
    {c.cta}
    <Icon name="chevron-right" size={18} />
  </a>
</PhotoHero>

{/* 02 Value: her eyebrow, heading and one line. */}
<section class="section value">
  <div class="measure measure--wide center">
    <p class="kicker">{c.valueKicker}</p>
    <span class="rule"></span>
    <h2 class="h2 h2--statement"><Phrases text={c.valueTitle} /></h2>
    <p class="body value__body"><Phrases text={c.valueBody} /></p>
  </div>
</section>

{/* 03 Three reasons: icon and title only, side by side at every width. */}
<section class="section reasons">
  <Divider />
  <h2 class="h2 center reasons__title">{c.reasonsTitle}</h2>
  <ul class="reasons__list measure--cards" role="list">
    {
      c.reasons.map((title, i) => (
        <li class="reason panel">
          <Icon name={reasonIcons[i]} size={36} class="reason__icon" />
          <h3 class="reason__title">
            {/* One piece of text, with an invisible fold where she breaks
                the line. As separate elements, or with a <br> between, WebKit
                left a gap after 「オーダーメイドの」 wherever the title ran on
                one line. */}
            {title.join(FOLD)}
          </h3>
        </li>
      ))
    }
  </ul>
</section>

{/* 04 Plans: every plan, as compact cards under its tier. The same list
    the Experience page shows. */}
<section class="section section--deep" id="plans">
  <div class="measure measure--wide center plans__head">
    <h2 class="h2">{c.plansTitle}</h2>
    <span class="rule"></span>
    <p class="body"><Phrases text={c.plansLead} /></p>
  </div>

  <PlanList locale={locale} />
</section>

{/* 05 and 06: the reservation note, then the contact call, close together.
    The call stands on a warm wall in late sun, palm fronds' shadows at its
    top left, running to the footer, as her picture has it (06). The photo
    only sets the light, so it has no alt. */}
<section class="section closing">
  <Reservation locale={locale} />
  <div class="invite">
    <div class="measure measure--wide center closing__text">
      <h2 class="h2 h2--statement"><Phrases text={c.closingTitle} /></h2>
      <Divider />
      <p class="body closing__body"><Phrases text={c.closingBody} /></p>
      <a class="btn btn--solid btn--champagne btn--slab closing__cta" href={p('/contact')}>{c.cta}</a>
    </div>
    {/* On a phone the wall is drawn by the band's height, about 620px wide
        at most, wider than the screen. */}
    <Photo class="invite__photo" src={fronds} alt="" sizes="(max-width: 479px) 620px, 100vw" />
  </div>
</section>

<style>
  /* -------------------------------------------------------------- hero */

  /* On the photograph's plate, so these tokens are the dark-surface ones.
     Her label is set light (01), as a line rather than a button. */
  .hero__eyebrow {
    margin: 0;
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .hero__part {
    display: inline-block;
    white-space: nowrap;
  }
  .hero__bar {
    margin-inline: 0.5em;
    opacity: 0.7;
  }

  /* Her label is 21 characters. At 14px with this tracking it is 312px, and a
     360px phone has 320px to give it, so it stays on one line. */
  :global(html[lang='ja']) .hero__eyebrow {
    font-family: var(--font-body);
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: none;
  }
  :global(html[lang='ja']) .hero__bar {
    margin-inline: 0;
  }

  /* The English label is 45 letters and never fits one line on a phone:
     the halves stack, without the bar. */
  @media (max-width: 599px) {
    :global(html[lang='en']) .hero__bar {
      display: none;
    }
    :global(html[lang='en']) .hero__part {
      display: block;
    }
  }
  /* Hers stops fitting one line under 340px. The second half goes under the
     first, and her bar stays where her label has it, after 完全予約制. */
  @media (max-width: 339px) {
    :global(html[lang='ja']) .hero__part:last-child {
      display: block;
    }
  }

  /* Her short, fine rule between the label and the headline (01). */
  .hero__rule {
    width: 32px;
    height: 1.5px;
    margin-block: 12px 14px;
  }

  .hero__title {
    color: var(--ink);
    text-shadow: 0 1px 24px rgba(20, 13, 8, 0.55);
  }
  :global(html[lang='ja']) .hero__title {
    line-height: 1.42;
  }

  /* Her hero pill a size up (01: about 51px tall, a 19px label), her thin
     chevron near the end, the label a little left of centre as she set it. */
  .hero__cta {
    --end-pad-start: 45px;
    --end-pad-end: 54px;
    --end-icon-size: 28px;
    --end-icon-inset: 16px;
    min-height: 52px;
    margin-top: clamp(22px, 4vh, 34px);
  }
  :global(html[lang='ja']) .hero__cta {
    font-size: 19px;
    letter-spacing: 0.05em;
  }

  /* On an upright phone, as her picture sets it (01): the label, the rule
     and the headline closer together, and the button nearer the headline.
     The words stand on the hero's foot, so the button keeps its place and
     the lines above it move down, under her sign. The query is the one the
     hero's upright photo is picked by, word for word (see PhotoHero). */
  @media (width <= 559px) and (orientation: portrait) {
    .hero__rule {
      margin-block: 7px;
    }
    .hero__cta {
      margin-top: clamp(16px, 2.8vh, 26px);
    }
  }

  /* ------------------------------------------------------------- value */

  /* The warm light her sunset leaves under the photograph (01, 02), fading
     to the page's own cream. In the dark theme the glow is the page's black. */
  .value {
    background: linear-gradient(180deg, var(--glow) 0%, var(--bg) 85%);
  }

  /* Her phrase above the statement is set as a phrase, light and spaced,
     not as a label (02). */
  :global(html[lang='ja']) .value .kicker {
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.18em;
  }

  .value .rule {
    margin-block: 14px 18px;
  }

  .value__body {
    margin-top: 28px;
  }

  /* ----------------------------------------------------------- reasons */

  /* Continues the value section: one thought, so no second full gap. */
  .reasons {
    padding-top: 0;
  }

  .reasons__title {
    margin-block: 18px clamp(20px, 3vw, 30px);
  }

  /* Three equal cards side by side on every screen, as she asked. On a phone
     the row keeps the page's gutters, the gaps close to 4px and the cards
     carry no side padding: her longest line, 「オーダーメイドの」, is eight
     full-width characters, and a third of a 360px screen is all it has. A
     wider gap takes the title under her 14px at 375px. */
  .reasons__list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(6px, 2vw, 22px);
  }
  @media (max-width: 480px) {
    .reasons__list {
      gap: 4px;
    }
  }

  /* Her reason cards keep a gold edge (03): the one card on the site that
     does. Decoration around an icon and a title, so no 3:1 is asked of it. */
  .reason {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    padding: clamp(16px, 3.2vw, 28px) 0;
    border-color: var(--hairline);
    text-align: center;
    /* The title is sized from the card it has to fit, below. */
    container-type: inline-size;
  }

  .reason :global(.reason__icon) {
    color: var(--gold-deco);
  }

  .reason__title {
    margin: 0;
    padding-inline: 4px;
    font-family: var(--font-label);
    /* Her 14px floor for a label, from the narrowest phone this layout has. */
    font-size: clamp(14px, 3.6vw, 15px);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.5;
    color: var(--ink);
    text-wrap: balance;
  }

  /* Her longest line, 「オーダーメイドの」, must not fold. Set with
     proportional kana it is 7.1 characters wide in Chromium and in WebKit,
     so the size is the card's width over 7.6: the line fits with a little
     air. The width is inside the card's border. That is 13.4px on a 360px
     phone and her 14px floor from 374px, which is every iPhone. (The vw line
     is for a browser without container units.) */
  :global(html[lang='ja']) .reason__title {
    padding-inline: 0;
    font-family: var(--font-body);
    font-size: clamp(12.5px, 3.75vw, 17px);
    font-size: clamp(12.5px, calc(100cqi / 7.6), 17px);
    letter-spacing: 0;
    line-height: 1.55;
    text-wrap: initial;
  }
  /* The title folds at her breaks and nowhere else: keep-all rules out a
     fold between two characters, which leaves the invisible one she is given
     in the markup. On a phone the title is made as narrow as its longest
     line, so it does fold there, into her two lines. */
  :global(html[lang='ja']) .reason__title {
    width: min-content;
    word-break: keep-all;
    overflow-wrap: normal;
  }

  /* Up to 355px (an iPhone in Display Zoom is 320) a third of the screen
     cannot hold her line at any honest size, and an English title at 14px
     leaves 'car,' alone. The cards become three rows, icon beside title, at
     full size. */
  @media (max-width: 355px) {
    .reasons__list {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      margin-inline: 0;
    }
    .reason {
      flex-direction: row;
      gap: 14px;
      padding: 12px 16px;
      text-align: left;
    }
    .reason__title,
    :global(html[lang='ja']) .reason__title {
      width: auto;
      font-size: 15px;
    }
  }

  /* From here the cards are wide enough for each title on one line, with air
     either side: at 540px a card holds 155px inside its border, and
     「オーダーメイドの旅」 needs 138px at 17px. (At 500px it was 3px a side.) */
  @media (min-width: 540px) {
    :global(html[lang='ja']) .reason__title {
      width: auto;
    }
  }

  /* ------------------------------------------------------------- plans */

  .plans__head .rule {
    margin-block: 14px;
  }

  .plans__head {
    margin-bottom: clamp(24px, 4vw, 36px);
  }

  /* ----------------------------------------------------------- closing */

  /* The call's wall: the photo fills a band the page's full width, from a
     little under the reservation note to the footer, and the band waits in
     the wall's colour until the photo arrives. The photo is graded to her
     wall's pale cream (06), its frond shadows kept warm tan. On a phone the
     band is drawn by its height and cut at its sides; held at its top and
     centre, the fronds keep the top left, about half the width across, and
     the words start about a quarter of the width down, under them, as hers
     do. The wall is light everywhere (no pixel under a luma of 176, even in
     the fronds' shadows), so the words read in dark ink over any of it. */
  .invite {
    position: relative;
    isolation: isolate;
    margin: clamp(32px, 5vw, 48px) calc(-1 * var(--gutter)) calc(-1 * var(--section-y));
    padding: clamp(88px, 9vw, 96px) var(--gutter) var(--section-y);
    background: #f5ebe0;
  }
  /* top and left, not inset, which Safari before 14.1 cannot read. */
  .invite__photo {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }
  .closing__body {
    color: var(--ink);
  }
  /* The button's focus ring, a shade deeper on the wall, where the page's
     gold clears 3:1 by a hair beside the button's shadow. */
  :global(html:not([data-theme='dark'])) .invite {
    --gold-text: #6e5613;
  }
  /* In the dark theme the words are light, so the wall is dimmed under
     them, and the band waits in the dimmed wall's colour. A printed page is
     cream from either theme: the wall as it is, and her divider's rules
     drawn as borders, which paper keeps where it drops a background (they
     would print white across the wall). */
  :global(html[data-theme='dark']) .invite {
    background: #4a4743;
  }
  :global(html[data-theme='dark']) .invite__photo {
    filter: brightness(0.3);
  }
  @media print {
    :global(html[data-theme='dark']) .invite {
      background: #f5ebe0;
    }
    :global(html[data-theme='dark']) .invite__photo {
      filter: none;
    }
    .closing__text :global(.divider__rule) {
      height: 0;
      border-top: 1px solid var(--hairline);
      background: none;
    }
  }
  /* The wall meets the footer with no line between. */
  :global(body:has(.invite__photo) .site-footer) {
    border-top-color: transparent;
  }

  .closing__text :global(.divider) {
    margin-block: 18px;
  }

  .closing__cta {
    margin-top: clamp(20px, 3vw, 28px);
  }

  /* On paper the button stays with its heading and words. */
  @media print {
    .closing__text {
      break-inside: avoid;
    }
  }
</style>
