---
import { type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import BookingForm from '../components/BookingForm.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = (path: string) => localizePath(path, locale);

// The page for people who already know their plan. The other path, for
// people who do not, is one link away at the bottom.
const copy = {
  en: {
    kicker: 'Booking',
    title: ['Book a plan'],
    lead: 'Choose a plan, tell us when and how many, and we will check availability.',
    asideText: 'Not decided yet?',
    asideLink: 'Talk to us first',
  },
  ja: {
    kicker: 'ご予約',
    title: ['ご希望のプランを、', 'お申し込みください。'],
    lead: 'プラン、ご希望日、人数をご入力ください。空き状況を確認のうえ、ご連絡いたします。',
    asideText: 'プランがまだお決まりでない方は、',
    asideLink: 'ご相談フォームへ',
  },
} as const;

const c = copy[locale];
---

<section class="section head">
  <div class="measure measure--wide center">
    <p class="kicker">{c.kicker}</p>
    <h1 class="h2 head__title">
      {c.title.map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </h1>
    <p class="body">{c.lead}</p>
  </div>
</section>

<BookingForm locale={locale} />

<section class="section section--deep aside">
  <p class="body center measure">
    {c.asideText} <a href={p('/contact')}>{c.asideLink}</a>
  </p>
</section>

<style>
  .head {
    padding-block: clamp(64px, 9vw, 110px) clamp(40px, 6vw, 64px);
  }
  .head__title {
    margin-block: 26px;
  }
  .aside {
    padding-block: clamp(40px, 6vw, 64px);
  }
  .aside .measure {
    margin-inline: auto;
  }
  /* The link is short; keep it whole rather than orphan its last character. */
  .aside a {
    white-space: nowrap;
  }
</style>
