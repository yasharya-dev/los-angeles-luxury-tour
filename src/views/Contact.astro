---
import { type Locale } from '../i18n/ui';
import { BR } from '../i18n/text';
import { localizePath } from '../i18n/utils';
import { CONTACT } from '../data/contact';
import { cancellation } from '../data/cancellation';
import type { IconName } from '../data/icons';
import Icon from '../components/Icon.astro';
import Phrases from '../components/Phrases.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const p = (path: string) => localizePath(path, locale);

const EM = String.fromCharCode(0x2014);

const copy = {
  en: {
    kicker: 'Contact',
    title: 'How would you like to spend your time in Los Angeles?',
    lead: 'Your plans do not need to be fixed yet. Start from what you want, or what you are wondering about, and write to us. You will usually hear back within 24 hours.',

    pathsTitle: 'Book, or talk first',
    paths: [
      {
        title: 'Your plan is decided',
        body: 'Choose the plan, your preferred date and party size, and send the request.',
        cta: 'Book',
        href: '/book',
        primary: true,
        icon: 'calendar',
      },
      {
        title: 'Your plan is not decided yet',
        body: 'A tailor-made trip, a question about a plan, or anywhere in between.',
        cta: 'Consult',
        href: '/consult',
        primary: false,
        icon: 'chat',
      },
    ],

    channelsTitle: 'Prefer to write directly?',

    faqKicker: 'FAQ',
    faqTitle: 'Questions, answered',
    faq: [
      {
        q: 'Can I book as a single traveler?',
        a: [
          'Yes, from one guest.',
          'Whether you are traveling alone or visiting Los Angeles for the first time, you are looked after in Japanese, carefully, so you can simply enjoy it.',
        ],
        open: true,
      },
      {
        q: 'Can you pick me up at the airport, or from my hotel?',
        a: [
          'Yes. From Los Angeles International Airport (LAX), your hotel, or wherever you prefer.',
          'After the tour we can drop you at your hotel, a restaurant, or anywhere else you would like to go.',
        ],
      },
      {
        q: 'Can I choose where we go?',
        a: [
          'Yes. It is a private tour, so the plan is built freely around what you want.',
          'Combine the places you have been wanting to see, or, if nothing is decided yet, we suggest spots and a route to suit your interests and what you came for.',
        ],
      },
      {
        q: 'Can we sightsee with our suitcases?',
        a: [
          'Yes. On the day you land, or after checking out, your luggage rides along in the vehicle while you sightsee.',
          'Please tell us the number of guests and the number and size of suitcases when you book, since the vehicle we arrange depends on them.',
        ],
      },
      {
        q: 'Can we change the destinations or the plan on the day?',
        a: [
          'Yes, as far as we can.',
          'We adjust the stops, how long you stay, and the route to the traffic on the day and to what you feel like.',
        ],
      },
      {
        // Her question is 「英語が話せなくても大丈夫ですか？」, and her answer
        // starts 「はい、大丈夫です。」: the English question is asked her way
        // round, so its yes means the same thing.
        q: 'Is it all right if I do not speak English?',
        a: [
          'Yes, it is.',
          `The tour is guided in Japanese, and wherever English is needed along the way ${EM} shopping, restaurants ${EM} we handle it, so first-time travelers and anyone unsure of their English can relax.`,
        ],
      },
      {
        q: 'Are there costs beyond the tour price?',
        a: [
          'The tour price covers the vehicle and guide for the hours stated in the plan.',
          'Parking, admission fees, meals and tickets are not included as a rule.',
          'If the number of guests, the amount of luggage or the areas you visit call for a different vehicle or an extra charge, we tell you beforehand.',
          'Extra time can be added by the hour; the rate is confirmed when you book.',
        ],
      },
      {
        q: cancellation.en.question,
        a: [cancellation.en.lead],
        list: cancellation.en.tiers,
        after: cancellation.en.after,
      },
    ],
  },

  ja: {
    kicker: 'お問い合わせ',
    title: ['ロサンゼルスで、', BR, 'どんな時間を', '過ごしたいですか？'],
    lead: 'ご旅行の予定がまだ固まっていなくても大丈夫です。ご希望や気になることから、お気軽にご相談ください。通常24時間以内にご返信いたします。',

    pathsTitle: 'ご予約・ご相談',
    paths: [
      {
        title: 'プランがお決まりの方',
        body: 'ご希望の日程・人数などを入力してお申し込みください。',
        cta: '予約する',
        href: '/book',
        primary: true,
        icon: 'calendar',
      },
      {
        title: 'まだプランがお決まりでない方',
        body: 'オーダーメイドのご希望や、プランについてのご相談はこちらから。',
        cta: '相談する',
        href: '/consult',
        primary: false,
        icon: 'chat',
      },
    ],

    channelsTitle: '直接ご連絡をご希望の方へ',

    faqKicker: 'FAQ',
    faqTitle: 'よくあるご質問',
    faq: [
      {
        q: '1名でも利用できますか？',
        a: [
          'はい、1名様からご利用いただけます。',
          'お一人旅はもちろん、初めてロサンゼルスを訪れる方にも安心してお楽しみいただけるよう、日本語で丁寧にサポートいたします。',
        ],
        open: true,
      },
      {
        q: '空港到着後やホテル出発でも利用できますか？',
        a: [
          'はい、ロサンゼルス国際空港（LAX）・ご宿泊先ホテルなど、ご希望の場所からご利用いただけます。',
          '観光終了後も、ホテルやレストランなど、ご希望の場所までお送りすることが可能です。',
        ],
      },
      {
        q: '行き先は自由に決められますか？',
        a: [
          'はい。貸切プライベートツアーのため、ご希望に合わせて自由にプランを組むことができます。',
          '行ってみたい場所を組み合わせることはもちろん、まだ具体的に決まっていない場合は、お客様の興味や目的に合わせておすすめのスポットやルートをご提案いたします。',
        ],
      },
      {
        q: 'スーツケースを持ったまま観光できますか？',
        a: [
          'はい、可能です。空港到着日やホテルチェックアウト後も、お荷物を車に積んだまま観光をお楽しみいただけます。',
          '※ご利用人数やスーツケースの個数・サイズによって手配する車両が異なるため、ご予約時にお知らせください。',
        ],
      },
      {
        q: '当日に行き先やプランを変更できますか？',
        a: [
          'はい、可能な範囲で柔軟に対応いたします。',
          '当日の交通状況やお客様のご希望に合わせて、訪問先や滞在時間、ルートなどを調整いたします。',
        ],
      },
      {
        q: '英語が話せなくても大丈夫ですか？',
        a: [
          'はい、大丈夫です。',
          'ツアーは日本語でご案内いたします。',
          '観光中のお買い物やレストランなど、現地で英語が必要な場面もサポートいたしますので、海外旅行が初めての方や英語に不安がある方も安心してご利用ください。',
        ],
      },
      {
        q: 'ツアー料金以外にかかる費用はありますか？',
        a: [
          'ツアー料金には、プランに記載された時間内の車両・ガイドサービスが含まれます。',
          '駐車場代、各施設の入場料、お食事代、チケット代などは、原則としてツアー料金には含まれておりません。',
          'また、ご利用人数・お荷物の量・訪問エリアなどにより、車両変更や追加料金が必要となる場合は事前にご案内いたします。',
          '規定時間を超える場合は、1時間12,000円にて延長が可能です。',
        ],
      },
      {
        q: cancellation.ja.question,
        a: [cancellation.ja.lead],
        list: cancellation.ja.tiers,
        after: cancellation.ja.after,
      },
    ],
  },
} as const;

const c = copy[locale];

// The same three ways to write directly, in both languages. LINE first: it is
// what most of her guests already have open. Each link's name starts with its
// visible label and adds the handle, for anyone who needs to type it.
const mail = locale === 'ja' ? 'メール' : 'Email';
const channels: { icon: IconName; label: string; name: string; href: string }[] = [
  { icon: 'line', label: 'LINE', name: `LINE ${CONTACT.lineId}`, href: CONTACT.lineUrl },
  { icon: 'mail', label: mail, name: `${mail} ${CONTACT.email}`, href: `mailto:${CONTACT.email}` },
  {
    icon: 'instagram',
    label: 'Instagram',
    name: `Instagram ${CONTACT.instagramHandle}`,
    href: CONTACT.instagram,
  },
];
---

<section class="section head">
  <div class="measure measure--wide center">
    <p class="kicker">{c.kicker}</p>
    <span class="rule"></span>
    <h1 class="h2 h2--statement"><Phrases text={c.title} /></h1>
    <p class="body head__lead"><Phrases text={c.lead} /></p>
  </div>
</section>

{/* Two paths, visually separate, as she asked: her copy, unchanged. Then the
    three direct ways in one compact row (her brief, section 07), where there
    used to be three stacked cards. */}
<section class="section section--deep">
  <div class="measure--cards">
    <h2 class="h2 center paths__title">{c.pathsTitle}</h2>
    <ul class="paths" role="list">
      {
        c.paths.map((path) => (
          <li class="path panel">
            <span class="path__icon">
              <Icon name={path.icon} size={26} />
            </span>
            <div class="path__text">
              <h3 class="h3 path__title"><Phrases text={path.title} /></h3>
              <p class="body path__body"><Phrases text={path.body} /></p>
            </div>
            <a class:list={['btn', 'btn--end-icon', 'path__cta', { 'btn--solid': path.primary }]} href={p(path.href)}>
              {path.cta}
              <Icon name="chevron-right" size={18} />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="direct">
      <h2 class="direct__title">
        <span class="direct__line" aria-hidden="true"></span>
        <span class="direct__words">{c.channelsTitle}</span>
        <span class="direct__line" aria-hidden="true"></span>
      </h2>
      <ul class="direct__list" role="list">
        {
          channels.map((ch) => (
            <li>
              <a class="direct__link" href={ch.href} rel="noopener" aria-label={ch.name}>
                <Icon name={ch.icon} size={26} class="direct__icon" />
                <span class="direct__label">{ch.label}</span>
              </a>
            </li>
          ))
        }
      </ul>

      {/* The two a guest may have to type. A LINE ID is how she is added from
          another device, and an email link does nothing on a phone with no
          mail app set up. As text, each can be read out, copied or selected;
          with the footer down to icons, this is the one place they are. */}
      <dl class="direct__ids">
        <div>
          <dt>LINE ID</dt>
          <dd>{CONTACT.lineId}</dd>
        </div>
        <div>
          <dt>{mail}</dt>
          <dd>{CONTACT.email}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<section class="section">
  <div class="measure measure--wide center faq__head">
    <p class="kicker">{c.faqKicker}</p>
    <span class="rule"></span>
    <h2 class="h2">{c.faqTitle}</h2>
  </div>

  <div class="faq panel measure--cards">
    {
      c.faq.map((item) => (
        <details class="faq__item" open={'open' in item && item.open}>
          <summary class="faq__q">
            <span><Phrases text={item.q} /></span>
            <Icon name="chevron-down" size={20} class="faq__chevron" />
          </summary>
          <div class="faq__a">
            {item.a.map((para) => <p class="body"><Phrases text={para} /></p>)}
            {'list' in item && item.list && (
              <ul class="faq__list">
                {item.list.map((line) => <li class="body">{line}</li>)}
              </ul>
            )}
            {'after' in item && item.after && <p class="body"><Phrases text={item.after} /></p>}
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .head .rule,
  .faq__head .rule {
    margin-block: 14px 18px;
  }

  .head__lead {
    margin-top: 16px;
  }

  /* -------------------------------------------------------------- paths */

  .paths__title {
    margin-bottom: clamp(20px, 3vw, 30px);
  }

  .paths {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 760px) {
    .paths {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
  }

  /* Icon beside the words and the button under them: the two buttons line
     up however long the two bodies turn out. */
  .path {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    gap: 14px 16px;
    align-items: start;
    padding: clamp(18px, 3vw, 26px);
  }

  .path__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--bg-deep);
    color: var(--gold-text);
  }

  /* Two even lines when it folds, not one long line and a last word alone. */
  .path__title {
    margin: 0 0 4px;
    text-wrap: balance;
  }

  /* Her two path buttons sit in the text column, under the words, a little
     over half the card wide, the label in the middle and the chevron near
     the end (07). */
  .path__cta {
    grid-column: 2;
    grid-row: 3;
    justify-self: start;
    min-width: min(200px, 100%);
  }

  /* ------------------------------------------------------------- direct */

  .direct {
    margin-top: clamp(28px, 4vw, 40px);
  }

  /* Her heading, with a hairline either side. */
  .direct__title {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 6px;
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }
  :global(html[lang='ja']) .direct__title {
    font-family: var(--font-body);
    font-size: 16px;
    letter-spacing: 0.06em;
    text-transform: none;
  }
  .direct__words {
    flex: none;
    max-width: 100%;
  }
  .direct__line {
    flex: 1;
    height: 1px;
    background: var(--hairline);
  }

  /* One row of three, at every width. */
  .direct__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .direct__list li + li {
    border-left: 1px solid var(--hairline-soft);
  }

  /* Icon over the word on a phone, where a third of the screen is too narrow
     for "Instagram" beside an icon; side by side from 480px. */
  .direct__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-height: 68px;
    padding: 8px 4px;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .direct__link :global(.direct__icon) {
    color: var(--gold-text);
  }
  .direct__link:hover {
    color: var(--gold-text);
  }

  @media (min-width: 480px) {
    .direct__link {
      flex-direction: row;
      gap: 10px;
      min-height: 56px;
      font-size: 15px;
    }
  }

  /* An identifier is set as issued: never uppercased, never tracked apart.
     One touch selects the whole of it. */
  .direct__ids {
    display: grid;
    gap: 2px;
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.7;
    text-align: center;
    color: var(--ink-soft);
  }
  .direct__ids div {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 10px;
  }
  .direct__ids dt {
    font-weight: 600;
  }
  .direct__ids dd {
    margin: 0;
    color: var(--ink-mid);
    overflow-wrap: anywhere;
    -webkit-user-select: all;
    user-select: all;
  }

  /* ---------------------------------------------------------------- faq */

  .faq__head {
    margin-bottom: clamp(20px, 3vw, 30px);
  }

  .faq {
    padding-inline: clamp(16px, 3vw, 28px);
  }

  .faq__item + .faq__item {
    border-top: 1px solid var(--hairline-soft);
  }

  .faq__q {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-md);
    min-height: 56px;
    padding: 12px 0;
    font-family: var(--font-display);
    font-size: clamp(18px, 2.2vw, 20px);
    font-weight: 600;
    line-height: 1.5;
    color: var(--ink);
    /* A long question folds into even lines, not one line and a word. */
    text-wrap: balance;
    transition: color 0.3s ease;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__q:hover {
    color: var(--gold-text);
  }
  .faq__q :global(.faq__chevron) {
    color: var(--gold-text);
    transition: transform 0.25s ease;
  }
  .faq__item[open] .faq__q :global(.faq__chevron) {
    transform: rotate(180deg);
  }

  :global(html[lang='ja']) .faq__q {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
  }

  .faq__a {
    padding: 0 0 20px;
    max-width: 62ch;
  }
  .faq__a > * + * {
    margin-top: 0.6em;
  }
  .faq__list {
    margin: 0;
    padding-left: 1.4em;
  }
  .faq__list li {
    padding-left: 0.2em;
  }
</style>
