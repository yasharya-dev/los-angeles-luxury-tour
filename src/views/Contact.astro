---
import { type Locale } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/utils';
import { CONTACT } from '../data/contact';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const p = (path: string) => localizePath(path, locale);

const EM = String.fromCharCode(0x2014);

const copy = {
  en: {
    kicker: 'Contact',
    title: ['How would you like to spend your time in Los Angeles?'],
    lead: 'Your plans do not need to be fixed yet. Start from what you want, or what you are wondering about, and write to us. You will usually hear back within 24 hours.',

    pathsTitle: 'Book, or talk first',
    paths: [
      {
        title: 'Your plan is decided',
        body: 'Choose the plan, your preferred date and party size, and send the request.',
        cta: 'Book',
        href: '/book',
        primary: true,
      },
      {
        title: 'Your plan is not decided yet',
        body: 'A tailor-made trip, a question about a plan, or anywhere in between.',
        cta: 'Consult',
        href: '/consult',
        primary: false,
      },
    ],

    channelsKicker: 'Prefer to write directly?',
    channels: [
      {
        label: 'LINE',
        note: 'The fastest reply, if LINE is already on your phone.',
        value: CONTACT.lineId,
        href: CONTACT.lineUrl,
        action: 'Open LINE',
      },
      {
        label: 'Email',
        note: `The unhurried way ${EM} write as much or as little as you like.`,
        value: CONTACT.email,
        href: `mailto:${CONTACT.email}`,
        action: 'Write an email',
      },
      {
        label: 'Instagram',
        note: `The day-to-day lives here ${EM} DMs are welcome.`,
        value: CONTACT.instagramHandle,
        href: CONTACT.instagram,
        action: 'Open the profile',
      },
    ],

    faqKicker: 'FAQ',
    faqTitle: ['Questions, answered'],
    faq: [
      {
        q: 'Can I book as a single traveler?',
        a: [
          'Yes, from one guest.',
          'Whether you are traveling alone or visiting Los Angeles for the first time, you are looked after in Japanese, carefully, so you can simply enjoy it.',
        ],
        open: true,
      },
      {
        q: 'Can you pick me up at the airport, or from my hotel?',
        a: [
          'Yes. From Los Angeles International Airport (LAX), your hotel, or wherever you prefer.',
          'After the tour we can drop you at your hotel, a restaurant, or anywhere else you would like to go.',
        ],
      },
      {
        q: 'Can I choose where we go?',
        a: [
          'Yes. It is a private tour, so the plan is built freely around what you want.',
          'Combine the places you have been wanting to see, or, if nothing is decided yet, we suggest spots and a route to suit your interests and what you came for.',
        ],
      },
      {
        q: 'Can we sightsee with our suitcases?',
        a: [
          'Yes. On the day you land, or after checking out, your luggage rides along in the vehicle while you sightsee.',
          'Please tell us the number of guests and the number and size of suitcases when you book, since the vehicle we arrange depends on them.',
        ],
      },
      {
        q: 'Can we change the destinations or the plan on the day?',
        a: [
          'Yes, as far as we can.',
          'We adjust the stops, how long you stay, and the route to the traffic on the day and to what you feel like.',
        ],
      },
      {
        q: 'Is it alright if I do not speak English?',
        a: [
          'Yes.',
          `The tour is guided in Japanese, and wherever English is needed along the way ${EM} shopping, restaurants ${EM} we handle it, so first-time travelers and anyone unsure of their English can relax.`,
        ],
      },
      {
        q: 'Are there costs beyond the tour price?',
        a: [
          'The tour price covers the vehicle and guide for the hours stated in the plan.',
          'Parking, admission fees, meals and tickets are not included as a rule.',
          'If the number of guests, the amount of luggage or the areas you visit call for a different vehicle or an extra charge, we tell you beforehand.',
          'Extra time can be added by the hour; the rate is confirmed when you book.',
        ],
      },
      {
        q: 'Is there a cancellation fee?',
        a: ['Depending on when you cancel:'],
        list: [
          'Up to 7 days before: free',
          'Up to 4 days before: 30%',
          'After that: 100%',
        ],
        after: 'The full cancellation policy comes with your booking.',
      },
    ],
  },

  ja: {
    kicker: 'お問い合わせ',
    title: ['ロサンゼルスで、', 'どんな時間を過ごしたいですか？'],
    lead: 'ご旅行の予定がまだ固まっていなくても大丈夫です。ご希望や気になることから、お気軽にご相談ください。通常24時間以内にご返信いたします。',

    pathsTitle: 'ご予約・ご相談',
    paths: [
      {
        title: 'プランがお決まりの方',
        body: 'ご希望の日程・人数などを入力してお申し込みください。',
        cta: '予約する',
        href: '/book',
        primary: true,
      },
      {
        title: 'まだプランがお決まりでない方',
        body: 'オーダーメイドのご希望や、プランについてのご相談はこちらから。',
        cta: '相談する',
        href: '/consult',
        primary: false,
      },
    ],

    channelsKicker: '直接ご連絡をご希望の方へ',
    channels: [
      {
        label: 'LINE',
        note: 'いちばん早いご連絡方法です。ID検索でも、下のボタンからでも。',
        value: CONTACT.lineId,
        href: CONTACT.lineUrl,
        action: 'LINEで相談する',
      },
      {
        label: 'メール',
        note: 'ゆっくり書きたい方はこちらへ。',
        value: CONTACT.email,
        href: `mailto:${CONTACT.email}`,
        action: 'メールを書く',
      },
      {
        label: 'Instagram',
        note: '日々の様子はこちら。DMもどうぞ。',
        value: CONTACT.instagramHandle,
        href: CONTACT.instagram,
        action: 'プロフィールを見る',
      },
    ],

    faqKicker: 'FAQ',
    faqTitle: ['よくあるご質問'],
    faq: [
      {
        q: '1名でも利用できますか？',
        a: [
          'はい、1名様からご利用いただけます。',
          'お一人旅はもちろん、初めてロサンゼルスを訪れる方にも安心してお楽しみいただけるよう、日本語で丁寧にサポートいたします。',
        ],
        open: true,
      },
      {
        q: '空港到着後やホテル出発でも利用できますか？',
        a: [
          'はい、ロサンゼルス国際空港（LAX）・ご宿泊先ホテルなど、ご希望の場所からご利用いただけます。',
          '観光終了後も、ホテルやレストランなど、ご希望の場所までお送りすることが可能です。',
        ],
      },
      {
        q: '行き先は自由に決められますか？',
        a: [
          'はい。貸切プライベートツアーのため、ご希望に合わせて自由にプランを組むことができます。',
          '行ってみたい場所を組み合わせることはもちろん、まだ具体的に決まっていない場合は、お客様の興味や目的に合わせておすすめのスポットやルートをご提案いたします。',
        ],
      },
      {
        q: 'スーツケースを持ったまま観光できますか？',
        a: [
          'はい、可能です。空港到着日やホテルチェックアウト後も、お荷物を車に積んだまま観光をお楽しみいただけます。',
          '※ご利用人数やスーツケースの個数・サイズによって手配する車両が異なるため、ご予約時にお知らせください。',
        ],
      },
      {
        q: '当日に行き先やプランを変更できますか？',
        a: [
          'はい、可能な範囲で柔軟に対応いたします。',
          '当日の交通状況やお客様のご希望に合わせて、訪問先や滞在時間、ルートなどを調整いたします。',
        ],
      },
      {
        q: '英語が話せなくても大丈夫ですか？',
        a: [
          'はい、大丈夫です。',
          'ツアーは日本語でご案内いたします。',
          '観光中のお買い物やレストランなど、現地で英語が必要な場面もサポートいたしますので、海外旅行が初めての方や英語に不安がある方も安心してご利用ください。',
        ],
      },
      {
        q: 'ツアー料金以外にかかる費用はありますか？',
        a: [
          'ツアー料金には、プランに記載された時間内の車両・ガイドサービスが含まれます。',
          '駐車場代、各施設の入場料、お食事代、チケット代などは、原則としてツアー料金には含まれておりません。',
          'また、ご利用人数・お荷物の量・訪問エリアなどにより、車両変更や追加料金が必要となる場合は事前にご案内いたします。',
          '規定時間を超える場合は、1時間12,000円にて延長が可能です。',
        ],
      },
      {
        q: 'キャンセル料はかかりますか？',
        a: ['キャンセル時期に応じて、以下のキャンセル料が発生いたします。'],
        list: ['7日前まで：無料', '4日前まで：30%', 'それ以降：100%'],
        after: '詳細は、ご予約時にご案内するキャンセルポリシーをご確認ください。',
      },
    ],
  },
} as const;

const c = copy[locale];
---

<section class="section head">
  <div class="measure measure--wide center">
    <p class="kicker">{c.kicker}</p>
    <h1 class="h2 head__title">
      {c.title.map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </h1>
    <p class="body">{c.lead}</p>
  </div>
</section>

{/* Two paths, visually separate, as she asked. The top of the page already
    says plans need not be fixed; this section only does the choosing. */}
<section class="section paths-section">
  <div class="measure--cards">
    <h2 class="h2 center paths__title">{c.pathsTitle}</h2>
    <ul class="paths">
      {
        c.paths.map((path) => (
          <li class="path">
            <h3 class="h3 path__title">{path.title}</h3>
            <p class="body path__body">{path.body}</p>
            <a class:list={['btn', { 'btn--solid': path.primary }]} href={p(path.href)}>
              {path.cta}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

{/* Below the form but full weight: many of her customers prefer LINE. */}
<section class="section section--deep">
  <div class="measure--cards">
    <p class="kicker center channels__kicker">{c.channelsKicker}</p>
    <ul class="channels">
      {
        c.channels.map((ch) => (
          <li class="channel">
            <p class="channel__label">{ch.label}</p>
            <p class="caption channel__note">{ch.note}</p>
            <p class="channel__value">{ch.value}</p>
            <a class="channel__action" href={ch.href} rel="noopener">
              {ch.action}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section">
  <div class="measure measure--wide center faq__head">
    <p class="kicker">{c.faqKicker}</p>
    <h2 class="h2 head__title">
      {c.faqTitle.map((line, i) => <>{i > 0 && <br />}{line}</>)}
    </h2>
  </div>

  <div class="faq measure--cards">
    {
      c.faq.map((item) => (
        <details class="faq__item" open={'open' in item && item.open}>
          <summary class="faq__q">{item.q}</summary>
          <div class="faq__a">
            {item.a.map((para) => <p class="body">{para}</p>)}
            {'list' in item && item.list && (
              <ul class="faq__list">
                {item.list.map((line) => <li class="body">{line}</li>)}
              </ul>
            )}
            {'after' in item && item.after && <p class="body">{item.after}</p>}
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .head {
    padding-block: clamp(64px, 9vw, 110px) clamp(40px, 6vw, 64px);
  }
  .head__title {
    margin-block: 26px;
  }

  /* -------------------------------------------------------------- paths */

  .paths-section {
    padding-top: 0;
  }

  .paths__title {
    margin-bottom: clamp(32px, 5vw, 46px);
  }

  .paths {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--gap-md);
    grid-template-columns: 1fr;
  }

  @media (min-width: 760px) {
    .paths {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
  }

  /* A column, so the two buttons sit on the same line however long the
     Japanese and English bodies turn out. */
  .path {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border: 1px solid var(--card-edge);
    background: var(--card);
    padding: clamp(28px, 4vw, 40px) clamp(22px, 3vw, 32px);
  }

  .path__title {
    margin: 0 0 14px;
  }

  .path__body {
    margin-bottom: 26px;
    max-width: 34ch;
  }

  .path .btn {
    margin-top: auto;
  }

  /* ----------------------------------------------------------- channels */

  .channels__kicker {
    margin-bottom: clamp(32px, 5vw, 46px);
  }

  .channels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--gap-md);
    grid-template-columns: 1fr;
  }

  @media (min-width: 760px) {
    .channels {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
  }

  .channel {
    border: 1px solid var(--card-edge);
    background: var(--card);
    padding: clamp(22px, 3vw, 30px);
    text-align: center;
  }

  .channel__label {
    margin: 0 0 12px;
    font-family: var(--font-label);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  :global(html[lang='ja']) .channel__label {
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: none;
  }

  .channel__note {
    margin-bottom: 18px;
    min-height: 3.2em;
  }

  /* Never uppercase an identifier someone has to type. */
  .channel__value {
    margin: 0 0 18px;
    font-family: var(--font-body);
    font-size: 14px;
    text-transform: none;
    color: var(--ink);
    word-break: break-word;
  }

  .channel__action {
    font-family: var(--font-label);
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    display: inline-block;
    padding-block: 4px;
  }

  :global(html[lang='ja']) .channel__action {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: none;
  }

  /* ---------------------------------------------------------------- faq */

  .faq__head {
    margin-inline: auto;
    margin-bottom: clamp(36px, 5vw, 52px);
  }

  .faq {
    margin-inline: auto;
  }

  .faq__item {
    border-bottom: 1px solid var(--hairline-soft);
  }
  .faq__item:first-child {
    border-top: 1px solid var(--hairline-soft);
  }

  .faq__q {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-md);
    padding: 20px 0;
    font-family: var(--font-display);
    font-size: clamp(16px, 2vw, 19px);
    color: var(--ink);
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__q::after {
    content: '+';
    flex: none;
    color: var(--gold-text);
    font-size: 16px;
  }
  .faq__item[open] .faq__q::after {
    content: '\2212';
  }

  :global(html[lang='ja']) .faq__q {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(14.5px, 1.8vw, 16.5px);
    line-height: 1.7;
  }

  .faq__a {
    padding: 0 0 24px;
    max-width: 60ch;
  }
  .faq__a > * + * {
    margin-top: 0.7em;
  }
  .faq__list {
    margin: 0;
    padding-left: 1.4em;
  }
  .faq__list li {
    padding-left: 0.2em;
  }
</style>
