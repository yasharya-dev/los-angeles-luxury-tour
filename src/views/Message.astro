---
import { type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import { CONTACT } from '../data/contact';

interface Props {
  locale: Locale;
  kind: 'notfound' | 'thanks';
}
const { locale, kind } = Astro.props;
const p = (path: string) => localizePath(path, locale);

const copy = {
  en: {
    notfound: {
      code: '404',
      title: 'That page is not here.',
      body: 'It may have moved, or the link may have a typo in it. The journeys are all one page away.',
      cta: 'See the journeys',
      href: '/experience',
    },
    thanks: {
      code: '',
      title: 'Thank you. Your message is on its way.',
      body: 'You will hear back from me within 24 hours. If it is urgent, LINE is the fastest way to reach me.',
      cta: 'Back to the start',
      href: '/',
    },
  },
  ja: {
    notfound: {
      code: '404',
      title: ['お探しのページが', '見つかりません。'],
      body: 'ページが移動したか、リンクに誤りがあるかもしれません。プランの一覧は、こちらからご覧いただけます。',
      cta: 'プランを見る',
      href: '/experience',
    },
    thanks: {
      code: '',
      title: ['ありがとうございます。', 'メッセージをお送りしました。'],
      body: '24時間以内にご返信いたします。お急ぎの場合は、LINEがいちばん早くご連絡いただけます。',
      cta: 'トップページへ戻る',
      href: '/',
    },
  },
} as const;

const c = copy[locale][kind];
---

<section class="section message">
  <div class="measure center">
    {c.code && <p class="code" aria-hidden="true">{c.code}</p>}
    {/* Japanese titles carry authored breaks, as every Japanese heading does. */}
    <h1 class="h2 message__title">
      {typeof c.title === 'string'
        ? c.title
        : c.title.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
    </h1>
    <p class="body message__body">{c.body}</p>
    <div class="message__actions">
      <a class="btn" href={p(c.href)}>{c.cta}</a>
      <a class="line" href={CONTACT.lineUrl} rel="noopener">
        LINE <span class="line__id">{CONTACT.lineId}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .message {
    min-height: 52svh;
    display: flex;
    align-items: center;
  }

  .code {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-size: clamp(46px, 9vw, 76px);
    line-height: 1;
    color: var(--gold-text);
  }

  .message__title {
    margin-bottom: 22px;
  }

  .message__body {
    margin-bottom: 38px;
  }

  .message__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-lg);
    flex-wrap: wrap;
  }

  .line {
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .line:hover {
    color: var(--gold-text);
  }

  /* Identifiers are never uppercased. */
  .line__id {
    text-transform: none;
    letter-spacing: 0.06em;
  }

  :global(html[lang='ja']) .line {
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: none;
  }
</style>
