---
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  jaHref: string;
}
const { locale, jaHref } = Astro.props;

// Offer, never a redirect. Shown once to first-time visitors whose browser
// prefers Japanese. Hidden until the script decides, so it can't flash.
const show = locale === 'en';
---

{
  show && (
    <div class="lang-offer" data-lang-offer hidden>
      <p class="lang-offer__text" lang="ja">
        このページは日本語でもご覧いただけます。
      </p>
      <a class="lang-offer__go" href={jaHref} lang="ja" hreflang="ja">
        日本語で読む
      </a>
      <button
        class="lang-offer__close"
        type="button"
        data-lang-offer-close
        aria-label="Dismiss"
      >
        &times;
      </button>
    </div>
  )
}

<script>
  const KEY = 'lalt-lang-offer-dismissed';
  const bar = document.querySelector<HTMLElement>('[data-lang-offer]');

  if (bar) {
    let dismissed = false;
    try {
      dismissed = localStorage.getItem(KEY) === '1';
    } catch {
      /* private mode: treat as not dismissed, it just will not persist */
    }

    const prefersJa = navigator.languages?.some((l) =>
      l.toLowerCase().startsWith('ja'),
    );

    if (!dismissed && prefersJa) {
      bar.hidden = false;
    }

    bar
      .querySelector<HTMLButtonElement>('[data-lang-offer-close]')
      ?.addEventListener('click', () => {
        bar.hidden = true;
        try {
          localStorage.setItem(KEY, '1');
        } catch {
          /* no-op */
        }
      });
  }
</script>

<style>
  .lang-offer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-md);
    flex-wrap: wrap;
    background: var(--bar-deep);
    border-bottom: 1px solid var(--hairline-soft);
    padding: 10px 44px 10px 20px;
    position: relative;
  }

  .lang-offer[hidden] {
    display: none;
  }

  .lang-offer__text {
    margin: 0;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.6;
    color: rgba(245, 245, 250, 0.78);
  }

  .lang-offer__go {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #d4af37;
    border-bottom: 1px solid rgba(212, 175, 55, 0.45);
    padding-bottom: 1px;
  }
  .lang-offer__go:hover {
    color: #f5f5fa;
    border-color: #f5f5fa;
  }

  .lang-offer__close {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: 0;
    color: rgba(245, 245, 250, 0.55);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    padding: 4px 8px;
  }
  .lang-offer__close:hover {
    color: #d4af37;
  }
</style>
