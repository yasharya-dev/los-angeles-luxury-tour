---
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  jaHref: string;
}
const { locale, jaHref } = Astro.props;

// Offer, never a redirect. Shown once to first-time visitors whose browser
// prefers Japanese. Hidden until the script decides, so it can't flash.
const show = locale === 'en';
---

{
  show && (
    <div class="lang-offer plate" data-lang-offer hidden>
      <p class="lang-offer__text" lang="ja">
        このページは日本語でもご覧いただけます。
      </p>
      <a class="lang-offer__go" href={jaHref} lang="ja" hreflang="ja" data-lang-link>
        日本語で読む
      </a>
      <button
        class="lang-offer__close"
        type="button"
        data-lang-offer-close
        aria-label="Dismiss"
      >
        &times;
      </button>
    </div>
  )
}

<script>
  const KEY = 'lalt-lang-offer-dismissed';
  const bar = document.querySelector<HTMLElement>('[data-lang-offer]');

  if (bar) {
    let dismissed = false;
    try {
      dismissed = localStorage.getItem(KEY) === '1';
    } catch {
      /* private mode: treat as not dismissed, it just will not persist */
    }

    const prefersJa = navigator.languages?.some((l) =>
      l.toLowerCase().startsWith('ja'),
    );

    if (!dismissed && prefersJa) {
      bar.hidden = false;
    }

    bar
      .querySelector<HTMLButtonElement>('[data-lang-offer-close]')
      ?.addEventListener('click', () => {
        bar.hidden = true;
        try {
          localStorage.setItem(KEY, '1');
        } catch {
          /* no-op */
        }
      });
  }
</script>

<style>
  /* A plate above the header: black in both themes, tokens throughout. */
  .lang-offer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0 var(--gap-md);
    flex-wrap: wrap;
    background: var(--bar-deep);
    border-bottom: 1px solid var(--hairline-soft);
    padding: 2px 48px 2px 20px;
    position: relative;
  }

  .lang-offer[hidden] {
    display: none;
  }

  .lang-offer__text {
    margin: 0;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-mid);
  }

  /* A control, so a 44px target; the underline sits under the words only. */
  .lang-offer__go {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--gold-text);
    text-decoration: underline;
    text-decoration-color: var(--hairline);
    text-underline-offset: 0.3em;
  }
  .lang-offer__go:hover {
    color: var(--ink);
  }

  .lang-offer__close {
    position: absolute;
    right: 2px;
    top: 50%;
    transform: translateY(-50%);
    width: var(--tap);
    height: var(--tap);
    background: none;
    border: 0;
    color: var(--ink-soft);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
  }
  .lang-offer__close:hover {
    color: var(--gold-text);
  }
</style>
