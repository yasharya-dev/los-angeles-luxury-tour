---
import { CONTACT } from '../data/contact';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// There's almost no photography on the site by design, so Instagram gets a
// real exit rather than a footer icon.
const copy = {
  en: {
    title: 'The day-to-day lives on Instagram',
    body: 'The games, the food, the city as it looks this week. I keep the pictures there, so this page can stay quiet.',
  },
  ja: {
    title: '日々の様子は、Instagramで',
    body: '試合も、グルメも、今週の街の空気も。写真はInstagramにまとめています。だからこのページは、静かなままで。',
  },
} as const;

const c = copy[locale];
---

<section class="section ig">
  <div class="measure center">
    <h2 class="h3 ig__title">{c.title}</h2>
    <p class="body ig__body">{c.body}</p>
    <a class="ig__handle" href={CONTACT.instagram} rel="me noopener">
      {CONTACT.instagramHandle}
    </a>
  </div>
</section>

<style>
  .ig {
    background: var(--bar);
    border-block: 1px solid var(--hairline-soft);
  }

  .ig__title {
    color: #f5f5fa;
    margin-bottom: 18px;
  }

  .ig__body {
    color: rgba(245, 245, 250, 0.72);
    margin-bottom: 30px;
  }

  .ig__handle {
    display: inline-block;
    font-family: var(--font-label);
    font-size: clamp(12px, 2vw, 15px);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #d4af37;
    border-bottom: 1px solid rgba(212, 175, 55, 0.4);
    padding-bottom: 6px;
  }
  .ig__handle:hover {
    color: #f5f5fa;
    border-color: #f5f5fa;
  }
</style>
