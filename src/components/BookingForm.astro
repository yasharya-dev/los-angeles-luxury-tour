---
import '../styles/form.css';
import { type Locale } from '../i18n/ui';
import { CONTACT } from '../data/contact';
import { offerings } from '../data/offerings';
import { yenAmount, lowestPrice } from '../data/plans';
import { planPhotos } from '../data/plan-photos';
import { guestOptions, hasChoice, planFor, problemText } from '../data/booking';
import { cancellation } from '../data/cancellation';
import Icon from './Icon.astro';
import Monogram from './Monogram.astro';
import Photo from './Photo.astro';
import Phrases from './Phrases.astro';

interface Props {
  locale: Locale;
  /** The plan being requested. Each plan has its own booking page. */
  id: string;
}
const { locale, id } = Astro.props;

const offering = offerings.find((o) => o.id === id);
if (!offering) throw new Error(`No offering "${id}"`);
const plan = planFor(id);
const choice = hasChoice(plan) ? plan : undefined;
const photo = planPhotos[id]?.hero;
const terms = cancellation[locale];

// Unset until the widget exists; the Worker skips verification without it.
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

// Her request form (brief of 2026-11-05, section 10B), in her order and with
// her words. A booking is a request: nothing here may call it confirmed.
const copy = {
  en: {
    selected: 'Your plan',
    type: 'Transfer',
    route: 'Route',
    date: 'Preferred date',
    guests: 'Guests',
    guestsPlaceholder: 'How many',
    hotel: 'Where you are staying',
    hotelPlaceholder: 'Hotel name or area',
    customer: 'Your details',
    name: 'Your name',
    email: 'Email',
    line: 'LINE ID',
    linePlaceholder: 'If you would like to hear back on LINE',
    notes: 'Requests or notes',
    notesPlaceholder: 'Pickup point, wishes, anything you would like us to know.',
    optional: ' (optional)',
    priceTitle: 'Base price for your choice',
    priceNote:
      'Once we have checked availability and the transfer details, we will write to you with the final price and your booking.',
    send: 'Send booking request',
    sending: 'Sending',
    sendNote: 'Your booking is not final yet.',
    formErr: 'A few fields still need attention. See the marks above.',
    sendErr: 'Something went wrong sending that. Please email us directly at',
    required: 'required',
  },
  ja: {
    selected: '選択中のプラン',
    type: '送迎タイプ',
    route: '送迎区間',
    date: 'ご利用希望日',
    guests: 'ご利用人数',
    guestsPlaceholder: '選択してください',
    hotel: 'ご宿泊先',
    hotelPlaceholder: 'ホテル名・エリアなど',
    customer: 'お客様情報',
    name: 'お名前',
    email: 'メールアドレス',
    line: 'LINE ID',
    linePlaceholder: 'LINEでのご連絡をご希望の場合',
    notes: 'ご要望・備考',
    notesPlaceholder: '送迎場所やご希望など、お気軽にお知らせください。',
    optional: '（任意）',
    priceTitle: 'ご希望の基本料金',
    priceNote: '空き状況・送迎条件を確認後、正式な料金とご予約についてご案内いたします。',
    send: '予約リクエストを送信する',
    sending: '送信中',
    sendNote: 'この時点では予約は確定していません。',
    formErr: '未記入の項目があります。上の印をご確認ください。',
    sendErr: '送信に失敗しました。お手数ですが直接ご連絡ください：',
    required: '必須',
  },
} as const;

const c = copy[locale];
const err = problemText[locale];

// What the summary card and the price box show before a choice: the plan's
// lowest price as a from-price. A choice puts its own price there.
const unit = plan?.unit[locale] ?? offering.priceNote?.[locale] ?? '';
const fromPrice = plan ? lowestPrice(plan, locale) : offering.price[locale];
---

<form
  class="form booking"
  method="post"
  action={CONTACT.bookingEndpoint}
  data-enhance
  data-booking-form
>
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="service" value={id} />

  {/* Honeypot: the Worker drops anything that arrives with it filled. Named
      so that no browser's autofill has a value for it. */}
  <div class="hp" aria-hidden="true">
    <label>
      Leave this empty
      <input type="text" name="llt-check" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  {/* Her summary card: the plan, its picture, the price of the choice. */}
  <div class="pick panel">
    <span class="pick__thumb">
      {
        photo ? (
          <Photo class="pick__photo" src={photo.src} alt="" aspect={1} sizes="72px" />
        ) : (
          <Monogram size={40} lazy />
        )
      }
    </span>
    <div class="pick__text">
      <p class="pick__label">{c.selected}</p>
      <p class="pick__name"><Phrases text={offering.name[locale]} /></p>
      <p class="pick__price">
        <span class="pick__amount" data-selected-price>{fromPrice}</span>{' '}
        <span class="pick__unit"><Phrases text={unit} /></span>
      </p>
    </div>
  </div>

  {
    choice && (
      <fieldset class="field choice">
        <legend class="label">
          {c.type} <span class="req" aria-hidden="true">*</span>
          <span class="sr-only">{c.required}</span>
        </legend>
        {choice.prices.map((row) => (
          <label class="option">
            <input
              type="radio"
              name="type"
              value={row.id}
              required
              data-price={yenAmount(row.yen, locale)}
              data-needs-route={row.route ? '' : undefined}
            />
            <span class="option__label">{row.label[locale]}</span>
            <span class="option__price">{yenAmount(row.yen, locale)}</span>
          </label>
        ))}
        <p class="err" id="e-type" hidden>
          {err.type}
        </p>
      </fieldset>
    )
  }

  {/* Only for a one-way choice. Not required in the markup: without script a
      round trip must still go through, and the Worker asks for a route only
      where one applies. The script makes it required when it is. */}
  {
    choice?.routes && (
      <fieldset class="field choice route" data-route-field>
        <legend class="label">
          {c.route} <span class="req" aria-hidden="true">*</span>
          <span class="sr-only">{c.required}</span>
        </legend>
        {choice.routes.map((way) => (
          <label class="option">
            <input type="radio" name="route" value={way.id} />
            <span class="option__label">{way.label[locale]}</span>
          </label>
        ))}
        <p class="err" id="e-route" hidden>
          {err.route}
        </p>
      </fieldset>
    )
  }

  <div class="field">
    <label class="label" for="f-date">
      {c.date} <span class="req" aria-hidden="true">*</span>
      <span class="sr-only">{c.required}</span>
    </label>
    <input
      class="input"
      id="f-date"
      name="date"
      type="date"
      required
      data-min-today
    />
    <p class="err" id="e-date" hidden>{err.date}</p>
  </div>

  <div class="field">
    <label class="label" for="f-guests">
      {c.guests} <span class="req" aria-hidden="true">*</span>
      <span class="sr-only">{c.required}</span>
    </label>
    <select class="input" id="f-guests" name="guests" required>
      <option value="">{c.guestsPlaceholder}</option>
      {guestOptions(id).map((g) => <option value={g.value}>{g.label[locale]}</option>)}
    </select>
    {plan?.over && <p class="caption over-note">{plan.over.note[locale]}</p>}
    <p class="err" id="e-guests" hidden>{err.guests}</p>
  </div>

  <div class="field">
    <label class="label" for="f-hotel">{c.hotel}{c.optional}</label>
    <input
      class="input"
      id="f-hotel"
      name="hotel"
      type="text"
      autocomplete="off"
      placeholder={c.hotelPlaceholder}
    />
  </div>

  <h2 class="form__heading">{c.customer}</h2>

  <div class="field">
    <label class="label" for="f-name">
      {c.name} <span class="req" aria-hidden="true">*</span>
      <span class="sr-only">{c.required}</span>
    </label>
    <input
      class="input"
      id="f-name"
      name="name"
      type="text"
      required
      autocomplete="name"
    />
    <p class="err" id="e-name" hidden>{err.name}</p>
  </div>

  <div class="field">
    <label class="label" for="f-email">
      {c.email} <span class="req" aria-hidden="true">*</span>
      <span class="sr-only">{c.required}</span>
    </label>
    <input
      class="input"
      id="f-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      inputmode="email"
      pattern="[^@\s]+@[^@\s]+\.[A-Za-z]{2,}"
    />
    <p class="err" id="e-email" hidden>{err.email}</p>
  </div>

  <div class="field">
    <label class="label" for="f-line">{c.line}{c.optional}</label>
    <input
      class="input"
      id="f-line"
      name="line"
      type="text"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      placeholder={c.linePlaceholder}
    />
  </div>

  <div class="field">
    <label class="label" for="f-notes">{c.notes}{c.optional}</label>
    <textarea
      class="input textarea"
      id="f-notes"
      name="notes"
      rows="4"
      placeholder={c.notesPlaceholder}></textarea>
  </div>

  {/* Her price box: the base price of the choice, and what happens next. */}
  {
    choice && (
      <div class="price-box">
        <p class="price-box__title">{c.priceTitle}</p>
        <p class="price-box__price">
          <span class="price-box__amount" data-selected-price>
            {fromPrice}
          </span>{' '}
          <span class="price-box__unit">{unit}</span>
        </p>
        <p class="caption">
          <Phrases text={c.priceNote} />
        </p>
      </div>
    )
  }

  {/* Her cancellation terms, from the FAQ's data, where they can be read
      before sending. Closed, so her screen order stays as she drew it. */}
  <details class="terms">
    <summary class="terms__label">
      <span>{terms.question}</span>
      <Icon name="chevron-down" size={18} class="terms__chevron" />
    </summary>
    <div class="terms__body">
      <p class="body"><Phrases text={terms.lead} /></p>
      <ul class="terms__list">
        {terms.tiers.map((tier) => <li class="body">{tier}</li>)}
      </ul>
      <p class="body"><Phrases text={terms.after} /></p>
    </div>
  </details>

  {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="light" />}

  <p class="form__err" data-form-error hidden>{c.formErr}</p>
  {/* A failed send is not the visitor's fault. Say so, and give a way out. */}
  <p class="form__err" data-send-error hidden role="alert">
    {c.sendErr} <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
  </p>

  <div class="booking__send">
    <button
      class="btn btn--solid"
      type="submit"
      data-submit
      data-label={c.send}
      data-sending={c.sending}
    >
      {c.send}
    </button>
    <p class="caption booking__note">{c.sendNote}</p>
  </div>
</form>

{turnstileKey && <script is:inline async src="https://challenges.cloudflare.com/turnstile/v0/api.js" />}

<script>
  import { enhanceForms } from '../scripts/enhance-form';
  enhanceForms();

  // The parts that follow a choice. The route is asked for only on a one-way
  // choice: the script makes it required then, and switches it off (which
  // also clears it) on a round trip. The summary card and the price box show
  // the price of the choice. Without script the style still shows and hides
  // the route, and the Worker checks it either way.
  const form = document.querySelector<HTMLFormElement>('[data-booking-form]');
  const route = form?.querySelector<HTMLFieldSetElement>('[data-route-field]');
  const sync = () => {
    if (!form) return;
    const chosen = form.querySelector<HTMLInputElement>('input[name="type"]:checked');
    const needs = chosen?.hasAttribute('data-needs-route') ?? false;
    route?.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
      input.required = needs;
      input.disabled = !needs;
      if (!needs) input.checked = false;
    });
    // Let the form's own check clear a mark the route no longer needs.
    route?.querySelector('input')?.dispatchEvent(new Event('change', { bubbles: true }));
    if (chosen?.dataset.price) {
      form.querySelectorAll('[data-selected-price]').forEach((el) => {
        el.textContent = chosen.dataset.price ?? '';
      });
    }
  };
  form?.querySelectorAll('input[name="type"]').forEach((input) => {
    input.addEventListener('change', sync);
  });
  sync();
</script>

<style>
  /* Her summary card: the plan, its picture and the price of the choice. */
  .pick {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    padding: 12px;
  }
  .pick__thumb {
    display: grid;
    place-items: center;
    width: 72px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-ctl);
    background: var(--bg-deep);
  }
  .pick__thumb :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .pick__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pick__label {
    margin: 0;
    font-size: 14px;
    color: var(--ink-soft);
  }
  .pick__name {
    margin: 2px 0 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--ink);
  }
  .pick__price {
    margin: 2px 0 0;
  }
  .pick__amount {
    font-weight: 600;
    color: var(--gold-text);
  }
  .pick__unit {
    font-size: 14px;
    color: var(--ink-soft);
  }

  /* Her choices, one per row, each a 52px target with its price. */
  .choice {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .choice legend {
    margin-bottom: 8px;
    padding: 0;
  }
  .option {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 10px 14px;
    border: 1px solid var(--field-edge);
    border-radius: var(--radius-ctl);
    background: var(--surface);
    cursor: pointer;
  }
  .option + .option {
    margin-top: 8px;
  }
  .option:has(input:checked) {
    border-color: var(--gold-text);
    box-shadow: inset 0 0 0 1px var(--gold-text);
  }
  .option input {
    flex: none;
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--gold-text);
  }
  .option input:focus-visible {
    outline: 2px solid var(--gold-text);
    outline-offset: 2px;
  }
  .option__label {
    flex: 1;
    font-size: 16px;
    color: var(--ink);
  }
  .option__price {
    font-size: 16px;
    font-weight: 600;
    color: var(--gold-text);
    white-space: nowrap;
  }

  /* The route only for a one-way choice, her note only for five or more.
     Where :has() is not understood these rules are dropped and both stay in
     view, which is the safe way for them to fail. */
  .booking:not(:has([data-needs-route]:checked)) .route,
  .booking:not(:has(option[value='over']:checked)) .over-note {
    display: none;
  }
  .over-note {
    margin: 0;
  }

  .form__heading {
    margin: 8px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--hairline-soft);
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--ink);
  }
  :global(html[lang='ja']) .form__heading {
    font-family: var(--font-body);
    font-size: 18px;
  }

  .price-box {
    padding: 16px 18px;
    border-radius: var(--radius-card);
    background: var(--bg-deep);
  }
  .price-box__title {
    margin: 0;
    font-size: 14px;
    color: var(--ink-soft);
  }
  .price-box__price {
    margin: 2px 0 8px;
  }
  .price-box__amount {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 600;
    color: var(--gold-text);
  }
  :global(html[lang='ja']) .price-box__amount {
    font-family: var(--font-body);
    font-size: 24px;
  }
  .price-box__unit {
    font-size: 14px;
    color: var(--ink-soft);
  }

  .terms {
    border-block: 1px solid var(--hairline-soft);
  }
  .terms__label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: var(--tap);
    padding: 8px 0;
    list-style: none;
    cursor: pointer;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
  }
  .terms__label::-webkit-details-marker {
    display: none;
  }
  .terms__label:hover {
    color: var(--gold-text);
  }
  .terms__label :global(.terms__chevron) {
    flex: none;
    color: var(--gold-text);
    transition: transform 0.25s ease;
  }
  .terms[open] .terms__label :global(.terms__chevron) {
    transform: rotate(180deg);
  }
  .terms__body {
    padding-bottom: 14px;
  }
  .terms__body > * + * {
    margin-top: 6px;
  }
  .terms__list {
    margin: 0;
    padding-left: 1.3em;
  }

  .booking__send {
    display: grid;
    gap: 8px;
    justify-items: center;
    text-align: center;
  }
  .booking__send .btn {
    width: 100%;
  }
  .booking__note {
    margin: 0;
  }
</style>
