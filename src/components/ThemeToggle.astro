---
import { type Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
  /** Show the words next to the mark, for the row in the phone menu. */
  labelled?: boolean;
}
const { locale, labelled = false } = Astro.props;
const t = useTranslations(locale);
---

{/* Cream is the default. Pressed means the dark theme is on. */}
<button
  class:list={['theme-toggle', { 'theme-toggle--labelled': labelled }]}
  type="button"
  aria-label={labelled ? undefined : t('toggle.theme')}
  aria-pressed="false"
  title={labelled ? undefined : t('toggle.theme')}
  data-theme-toggle
>
  <span class="theme-toggle__mark" aria-hidden="true"></span>
  {labelled && <span class="theme-toggle__text">{t('toggle.dark')}</span>}
</button>

<script>
  const KEY = 'llt-theme';
  const root = document.documentElement;
  const toggles = () =>
    document.querySelectorAll<HTMLElement>('[data-theme-toggle]');

  const sync = () => {
    const dark = root.dataset.theme === 'dark';
    toggles().forEach((btn) => btn.setAttribute('aria-pressed', String(dark)));
  };

  // Two toggles are on a page, in the bar and in the phone menu. Astro ships
  // this script once however many times the component is used.
  sync();
  toggles().forEach((btn) => {
    btn.addEventListener('click', () => {
      const dark = root.dataset.theme !== 'dark';
      if (dark) root.dataset.theme = 'dark';
      else delete root.dataset.theme;
      try {
        localStorage.setItem(KEY, dark ? 'dark' : 'light');
      } catch {
        /* private mode: the choice just will not persist */
      }
      sync();
    });
  });
</script>

<style>
  /* The button is the 44px target; the mark inside is the 26px drawing. */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0;
    border: 0;
    background: none;
    color: #f5f5fa;
    cursor: pointer;
  }

  /* Half-filled circle: reads as "two states" and costs no icon swap. */
  .theme-toggle__mark {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid rgba(212, 175, 55, 0.6);
    background: linear-gradient(90deg, transparent 0 50%, #d4af37 50% 100%);
    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
  }

  .theme-toggle:hover .theme-toggle__mark {
    border-color: #d4af37;
    transform: rotate(180deg);
  }

  .theme-toggle[aria-pressed='true'] .theme-toggle__mark {
    background: linear-gradient(90deg, #d4af37 0 50%, transparent 50% 100%);
  }

  .theme-toggle--labelled {
    justify-content: flex-start;
    width: 100%;
  }

  .theme-toggle__text {
    font-family: var(--font-label);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  :global(html[lang='ja']) .theme-toggle__text {
    font-family: var(--font-body);
    font-size: 15px;
    letter-spacing: 0.1em;
    text-transform: none;
  }
</style>
