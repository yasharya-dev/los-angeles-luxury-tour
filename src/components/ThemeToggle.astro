---
import { type Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
  /** Show the words next to the mark, for the row in the phone menu. */
  labelled?: boolean;
}
const { locale, labelled = false } = Astro.props;
const t = useTranslations(locale);
---

{/* Cream is the default. One name in both places, "Dark mode", and pressed
    means it is on. Without JavaScript the button could do nothing, so
    Base.astro hides it in a <noscript> style. */}
<button
  class:list={['theme-toggle', { 'theme-toggle--labelled': labelled }]}
  type="button"
  aria-pressed="false"
  title={labelled ? undefined : t('toggle.dark')}
  data-theme-toggle
>
  <span class="theme-toggle__mark" aria-hidden="true"></span>
  {labelled && <span class="theme-toggle__text">{t('toggle.dark')}</span>}
</button>

<script>
  const KEY = 'llt-theme';
  const root = document.documentElement;
  const toggles = () =>
    document.querySelectorAll<HTMLElement>('[data-theme-toggle]');

  const sync = () => {
    const dark = root.dataset.theme === 'dark';
    toggles().forEach((btn) => btn.setAttribute('aria-pressed', String(dark)));
  };

  // Two toggles are on a page, in the bar and in the phone menu. Astro ships
  // this script once however many times the component is used.
  sync();
  toggles().forEach((btn) => {
    btn.addEventListener('click', () => {
      const dark = root.dataset.theme !== 'dark';
      if (dark) root.dataset.theme = 'dark';
      else delete root.dataset.theme;
      try {
        localStorage.setItem(KEY, dark ? 'dark' : 'light');
      } catch {
        /* private mode: the choice just will not persist */
      }
      sync();
    });
  });

  // A page restored by the Back button keeps the DOM it had. Re-read the
  // choice, which may have changed on the page the visitor came back from.
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    let dark = false;
    try {
      dark = localStorage.getItem(KEY) === 'dark';
    } catch {
      // Storage is blocked, so it cannot say what was chosen. Leave the page
      // as it was restored.
      return;
    }
    if (dark) root.dataset.theme = 'dark';
    else delete root.dataset.theme;
    sync();
  });
</script>

<style>
  /* The button is the 44px target; the mark inside is the 26px drawing. In
     the header's plate, so the tokens are the dark-surface ones. */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  /* A half-filled circle: the gold half is on the right for cream and on the
     left for dark. It follows the theme attribute on <html>, which the
     blocking script in Base.astro sets before first paint, so a visitor who
     chose dark never sees the cream mark first. */
  .theme-toggle__mark {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--hairline);
    background: linear-gradient(90deg, transparent 0 50%, var(--gold-text) 50% 100%);
    transition: border-color 0.3s ease;
  }
  :global(html[data-theme='dark']) .theme-toggle__mark {
    background: linear-gradient(90deg, var(--gold-text) 0 50%, transparent 50% 100%);
  }

  .theme-toggle:hover .theme-toggle__mark {
    border-color: var(--gold-text);
  }

  .theme-toggle--labelled {
    justify-content: flex-start;
    width: 100%;
  }

  .theme-toggle__text {
    font-family: var(--font-label);
    font-size: 14px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  :global(html[lang='ja']) .theme-toggle__text {
    font-family: var(--font-body);
    font-size: 16px;
    letter-spacing: 0.1em;
    text-transform: none;
  }
</style>
