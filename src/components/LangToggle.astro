---
import { localeGloss, localeNames, locales, type Locale } from '../i18n/ui';
import { alternatePath, pagePath } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// Labelled in the destination language's own script: someone looking for
// English needs to see "EN", not "英語". Maps over the array so a third locale
// is a data change.
const others = locales.filter((l) => l !== locale);
---

{/* In the header bar, not floating over the page: her brief asks for nothing
    that can cover the content.

    The accessible name is the visible label followed by the language spelled
    out ("EN English", "日本語 Japanese"): it starts with what is on screen, so
    voice control still matches it, and each half carries its own lang. */}
{
  others.map((other) => (
    <a
      class="lang-link"
      href={alternatePath(pagePath(Astro.url.pathname), other)}
      hreflang={other}
      data-lang-link
    >
      <span class="lang-link__label" lang={other}>{localeNames[other]}</span>
      <span class="sr-only" lang="en">{localeGloss[other]}</span>
    </a>
  ))
}

<script>
  // The page is static, so the link cannot know what follows the path. Carry
  // the query and the fragment across, or switching language on the booking
  // form drops the plan that was selected (/ja/book?service=temecula).
  // Set on load too, so "open in new tab" gets the same address.
  const carry = (a: HTMLAnchorElement) => {
    a.href = a.pathname + location.search + location.hash;
  };
  document.querySelectorAll<HTMLAnchorElement>('a[data-lang-link]').forEach((a) => {
    carry(a);
    a.addEventListener('click', () => carry(a));
  });
  window.addEventListener('hashchange', () =>
    document.querySelectorAll<HTMLAnchorElement>('a[data-lang-link]').forEach(carry),
  );
</script>

<style>
  /* The link is the 44px target; the pill inside is only how it looks. On
     the header's plate, so the tokens are the dark-surface ones. */
  .lang-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: 4px;
  }

  .lang-link__label {
    padding: 4px 12px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    color: var(--gold-text);
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.6;
    white-space: nowrap;
    transition:
      border-color 0.3s ease,
      color 0.3s ease;
  }

  /* 日本語 falls back to a system font in Montserrat. */
  .lang-link__label[lang='ja'] {
    font-family: var(--font-body);
    font-size: 14px;
    letter-spacing: 0.06em;
  }

  .lang-link:hover .lang-link__label {
    border-color: var(--gold-text);
    color: var(--ink);
  }

  /* See the header: the row is short of room on a 320px screen. */
  @media (max-width: 345px) {
    .lang-link__label {
      padding-inline: 9px;
    }
  }
</style>
