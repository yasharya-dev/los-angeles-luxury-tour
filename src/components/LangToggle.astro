---
import { localeLinkNames, localeNames, locales, type Locale } from '../i18n/ui';
import { alternatePath } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// Labelled in the destination language's own script: someone looking for
// English needs to see "EN", not "英語". Maps over the array so a third locale
// is a data change.
const others = locales.filter((l) => l !== locale);
---

{/* In the header bar, not floating over the page: her brief asks for nothing
    that can cover the content. */}
{
  others.map((other) => (
    <a
      class="lang-link"
      href={alternatePath(Astro.url.pathname, other)}
      hreflang={other}
      lang={other}
      aria-label={localeLinkNames[other]}
    >
      <span class="lang-link__label">{localeNames[other]}</span>
    </a>
  ))
}

<style>
  /* The link is the 44px target; the pill inside is only how it looks. */
  .lang-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: 4px;
  }

  .lang-link__label {
    padding: 4px 12px;
    border: 1px solid rgba(212, 175, 55, 0.55);
    border-radius: 999px;
    color: #d4af37;
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.6;
    white-space: nowrap;
    transition:
      border-color 0.3s ease,
      color 0.3s ease;
  }

  /* 日本語 falls back to a system font in Montserrat. */
  .lang-link[lang='ja'] .lang-link__label {
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.08em;
  }

  .lang-link:hover .lang-link__label {
    border-color: #d4af37;
    color: #f5f5fa;
  }
</style>
