---
/*
  Renders Japanese so that a line folds only between phrases: on a wide
  screen the phrases run on together, on a phone they fold at natural points,
  and a heading can no longer end on one stranded character.

  - An array is copy with authored breaks (see i18n/text.ts): it folds only
    between its entries, and `BR` is a break at every width. Use it where
    Amelia gave the breaks.
  - A Japanese string is split into phrases for you (see i18n/phrase.ts).
  - Anything else is rendered as is. English wraps well on its own.

  The break points are <wbr>, with `word-break: keep-all` on the wrapper, so
  the text stays one string for copy and find-in-page. Chromium does join the
  pieces with a space when it builds a control's name or description from
  them, and a screen reader then reads the label phrase by phrase every time
  the field takes focus. Text that names or describes a control is rendered
  with `label`: its folds are U+200B, which no browser reads as a space.
  Inside a phrase, the characters Chromium folds at even under keep-all are
  joined to their neighbours (see `glue` in i18n/phrase.ts).
*/
import { BR, type Text } from '../i18n/text';
import { glue, isJapanese, phrases } from '../i18n/phrase';

interface Props {
  text: Text;
  /** It names or describes a control: a label, a hint, an error line. */
  label?: boolean;
}
const { text, label = false } = Astro.props;

const parts =
  typeof text === 'string' ? (isJapanese(text) ? phrases(text) : null) : text;
const FOLD = String.fromCharCode(0x200b);
---

{
  parts === null ? (
    text
  ) : label ? (
    <span class="phrases">
      {parts
        .filter((part) => part !== BR)
        .map(glue)
        .join(FOLD)}
    </span>
  ) : (
    <span class="phrases">
      {parts.map((part, i) =>
        part === BR ? (
          <br />
        ) : (
          <>
            {i > 0 && parts[i - 1] !== BR && <wbr />}
            {glue(part)}
          </>
        ),
      )}
    </span>
  )
}
