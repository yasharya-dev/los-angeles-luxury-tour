---
import '../styles/form.css';
import { type Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { CONTACT } from '../data/contact';
import { byTier, tierOrder, type Tier } from '../data/offerings';
import Phrases from './Phrases.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const EM = String.fromCharCode(0x2014);

// Unset until the widget exists; the Worker skips verification without it.
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const tierLabel: Record<Tier, string> = {
  signature: t('tier.signature'),
  day: t('tier.day'),
  transport: t('tier.transport'),
};

const copy = {
  en: {
    lead: 'Required fields are marked',
    leadAfter: '.',
    name: 'Your name',
    nameErr: 'Please enter your name.',
    email: 'Email',
    emailErr: 'Please check the email address.',
    lang: 'Preferred language',
    langOpts: ['English', 'Japanese', 'Either'],
    guests: 'Guests',
    guestOpts: ['Not sure yet', '1', '2', '3', '4', '5', '6 or more'],
    dates: 'Approximate travel dates',
    datesHint: 'e.g. around September 2026, four nights',
    service: 'Which plan are you interested in?',
    serviceNone: 'Not sure yet, just exploring',
    hoping: 'What are you hoping for?',
    hopingErr: `A single line is plenty ${EM} what are you hoping for?`,
    heard: 'How did you hear about us?',
    heardNote: 'If a friend sent you, tell us their name. Referrals carry a small thank-you discount.',
    heardOpts: [
      'Choose one',
      'A friend referred me',
      'Instagram',
      'LINE',
      'Search',
      'Other',
    ],
    referrer: `Your friend${String.fromCharCode(0x2019)}s name (optional)`,
    send: 'Send',
    sending: 'Sending',
    reply: 'You will usually hear back within 24 hours.',
    formErr: 'Please check the marked fields above.',
    // Ends in its space: the address follows straight on in every language.
    sendErr: 'Something went wrong sending that. Please email us directly at ',
    star: 'with an asterisk',
  },

  ja: {
    lead: '',
    leadAfter: 'は必須項目です。',
    name: 'お名前',
    nameErr: 'お名前をご記入ください。',
    email: 'メールアドレス',
    emailErr: 'メールアドレスをご確認ください。',
    lang: 'ご希望の言語',
    langOpts: ['日本語', 'English', 'どちらでも'],
    guests: '人数',
    guestOpts: [
      '未定',
      '1名様',
      '2名様',
      '3名様',
      '4名様',
      '5名様',
      '6名様以上',
    ],
    dates: 'ご旅行の時期（未定でも大丈夫です）',
    datesHint: '例：2026年9月ごろ・4泊',
    service: 'ご興味のあるプラン',
    serviceNone: '未定・相談しながら決めたい',
    hoping: 'どんな旅をお望みですか',
    hopingErr: 'ひとことで構いません。ご希望をお聞かせください。',
    heard: 'このサービスを、どこでお知りになりましたか？',
    heardNote:
      'ご紹介の場合は、ご紹介者のお名前でご紹介割引を適用いたします。',
    heardOpts: [
      '選択してください',
      'ご友人・知人の紹介',
      'Instagram',
      'LINE',
      '検索',
      'その他',
    ],
    referrer: 'ご紹介者のお名前（任意）',
    send: '送信する',
    sending: '送信中',
    // 通常 as in her own reply line (round 1) and the thank-you page.
    reply: '通常24時間以内にご返信いたします。',
    formErr: '上の印の項目をご確認ください。',
    sendErr: '送信に失敗しました。お手数ですが直接ご連絡ください：',
    // Ours, for her read: what a screen reader hears for the star.
    star: '＊印',
  },
} as const;

const c = copy[locale];
const FOLD = String.fromCharCode(0x200b);
---

<section class="section form-section" id="form">
  <div class="measure--cards">
    {/* The star is drawn for the eye; a screen reader hears what it is. */}
    <p class="caption center form__lead">
      {c.lead} <span class="req" aria-hidden="true">*</span><span class="sr-only"
        >{c.star}</span
      >{c.leadAfter}
    </p>

    <form
      class="form"
      method="post"
      action={CONTACT.formEndpoint}
      data-enhance
      data-inquiry-form
    >
      <input type="hidden" name="locale" value={locale} />

      {/* Honeypot: the Worker drops anything that arrives with it filled.
          Named so that no browser's autofill has a value for it. */}
      <div class="hp" aria-hidden="true">
        <label>
          Leave this empty
          <input type="text" name="llt-check" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <div class="field">
        <label class="label" for="f-name">
          {c.name} <span class="req" aria-hidden="true">*</span>
        </label>
        <input
          class="input"
          id="f-name"
          name="name"
          type="text"
          required
          aria-invalid="false"
          autocomplete="name"
        />
        <p class="err" id="e-name" hidden><Phrases text={c.nameErr} label /></p>
      </div>

      <div class="field">
        <label class="label" for="f-email">
          {c.email} <span class="req" aria-hidden="true">*</span>
        </label>
        <input
          class="input"
          id="f-email"
          name="email"
          type="email"
          required
          aria-invalid="false"
          autocomplete="email"
          inputmode="email"
          pattern="[^@\s]+@[^@\s]+\.[A-Za-z]{2,}"
        />
        <p class="err" id="e-email" hidden><Phrases text={c.emailErr} label /></p>
      </div>

      <div class="row">
        <div class="field">
          <label class="label" for="f-lang"><Phrases text={c.lang} label /></label>
          <select class="input" id="f-lang" name="language">
            {c.langOpts.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>

        <div class="field">
          <label class="label" for="f-guests"><Phrases text={c.guests} label /></label>
          <select class="input" id="f-guests" name="guests">
            {c.guestOpts.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>
      </div>

      {/* Free text, not a picker - "sometime next spring" is a real answer. */}
      <div class="field">
        <label class="label" for="f-dates"><Phrases text={c.dates} label /></label>
        <input
          class="input"
          id="f-dates"
          name="dates"
          type="text"
          placeholder={c.datesHint}
        />
      </div>

      {/* A plan card links here with ?service=<id>; the script pre-selects it. */}
      <div class="field">
        <label class="label" for="f-service"><Phrases text={c.service} label /></label>
        <select class="input" id="f-service" name="service">
          <option value="">{c.serviceNone}</option>
          {tierOrder.map((tier) => (
            <optgroup label={tierLabel[tier]}>
              {byTier(tier).map((o) => (
                <option value={o.id}>{o.name[locale]}</option>
              ))}
            </optgroup>
          ))}
        </select>
      </div>

      <div class="field">
        <label class="label" for="f-hoping">
          <Phrases text={c.hoping} label /> <span class="req" aria-hidden="true">*</span>
        </label>
        <textarea
          class="input textarea"
          id="f-hoping"
          name="hoping"
          rows="5"
          required
          aria-invalid="false"></textarea>
        <p class="err" id="e-hoping" hidden><Phrases text={c.hopingErr} label /></p>
      </div>

      <div class="field">
        <label class="label" for="f-heard"><Phrases text={c.heard} label /></label>
        {/* The discount is part of the question: read with the field, and with
            the name field it is about. */}
        <p class="caption hint" id="h-heard"><Phrases text={c.heardNote} label /></p>
        <select class="input" id="f-heard" name="heard" aria-describedby="h-heard">
          {/* The first option is the placeholder. Empty value, so an unanswered
              question sends nothing and the Worker leaves the row out. */}
          {c.heardOpts.map((o, i) => (
            <option value={i === 0 ? '' : o}>{o}</option>
          ))}
        </select>
      </div>

      <div class="field">
        <label class="label" for="f-ref"><Phrases text={c.referrer} label /></label>
        <input class="input" id="f-ref" name="referrer" type="text" aria-describedby="h-heard" />
      </div>

      {
        turnstileKey && (
          <div
            class="cf-turnstile"
            data-sitekey={turnstileKey}
            data-theme="light"
          />
        )
      }

      <p class="form__err" data-form-error hidden><Phrases text={c.formErr} label /></p>
      {/* A failed send is not the visitor's fault. Say so, and give a way out.
          The address may fold onto a line of its own. Any space before it is
          the copy's: none after a Japanese colon. */}
      <p class="form__err" data-send-error hidden role="alert">
        <Phrases text={c.sendErr} label />{FOLD}<a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      </p>

      <div class="form__foot">
        <button
          class="btn btn--solid"
          type="submit"
          data-submit
          data-label={c.send}
          data-sending={c.sending}
        >
          {c.send}
        </button>
        <p class="caption form__reply"><Phrases text={c.reply} /></p>
      </div>
    </form>

  </div>
</section>

{turnstileKey && <script is:inline async src="https://challenges.cloudflare.com/turnstile/v0/api.js" />}

<script>
  import { enhanceForms } from '../scripts/enhance-form';
  enhanceForms();
</script>

<style>
  .form-section {
    padding-top: 0;
  }

  .form__lead {
    margin-bottom: clamp(28px, 4vw, 40px);
  }
</style>
