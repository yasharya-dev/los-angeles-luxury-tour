---
import { type Locale } from '../i18n/ui';
import { useTranslations, localizePath, pagePath } from '../i18n/utils';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import Icon from './Icon.astro';
import Monogram from './Monogram.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const p = (path: string) => localizePath(path, locale);

const current = pagePath(Astro.url.pathname);
const isCurrent = (path: string) => current === p(path);

const links = [
  { href: '/experience', label: t('nav.experience') },
  { href: '/about', label: t('nav.about') },
  { href: '/contact', label: t('nav.contact') },
];
---

{/* One row at every width, as she asked: logo, language, and the way to the
    pages. Under 800px that is a menu; from 800px the links sit in the bar.
    Each is its own <nav>, and only one is ever rendered, so a screen reader
    always finds exactly one main navigation, open or closed.

    A plate: black in both themes, so every colour below is a token. */}
<header class="site-header plate">
  <a class="brand" href={p('/')} aria-label={t('nav.home')}>
    <Monogram size={40} />
    <span class="brand__words">
      {/* The space is real text: without it the lockup reads to a screen
          reader, and to the label-in-name rule, as "LOS ANGELESLUXURY TOUR". */}
      <span class="brand__name">LOS ANGELES</span>{' '}
      <span class="brand__sub">LUXURY TOUR</span>
    </span>
  </a>

  <div class="tools">
    <nav class="nav" aria-label={t('nav.main')}>
      {
        links.map((l) => (
          <a
            class="nav__link"
            href={p(l.href)}
            aria-current={isCurrent(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <LangToggle locale={locale} />
    <span class="tools__theme"><ThemeToggle locale={locale} /></span>

    {/* <details>, so the menu opens without JavaScript. The script below adds
        what a native disclosure lacks: Escape, a tap outside, closing when
        focus moves on, and closing when the bar takes over at 800px. */}
    <nav class="menu-nav" aria-label={t('nav.main')}>
      <details class="menu" data-menu>
        <summary class="menu__button" aria-label={t('nav.menu')}>
          <Icon name="menu" class="menu__icon menu__icon--open" />
          <Icon name="close" class="menu__icon menu__icon--close" />
        </summary>
        <div class="menu__panel">
          {
            links.map((l) => (
              <a
                class="menu__link"
                href={p(l.href)}
                aria-current={isCurrent(l.href) ? 'page' : undefined}
              >
                {l.label}
                <Icon name="chevron-right" size={18} />
              </a>
            ))
          }
          <div class="menu__foot">
            <ThemeToggle locale={locale} labelled />
          </div>
        </div>
      </details>
    </nav>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
  if (menu) {
    const summary = menu.querySelector('summary');
    const close = () => {
      menu.open = false;
    };

    // Escape closes it. Focus goes back to the button only if it was inside
    // the menu: pressing Escape elsewhere must not move a keyboard user.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !menu.open) return;
      const inside = menu.contains(document.activeElement);
      close();
      if (inside) summary?.focus();
    });

    // A tap or click anywhere else closes it. pointerdown, because iOS Safari
    // does not send click for a tap on plain page content.
    document.addEventListener('pointerdown', (e) => {
      if (menu.open && e.target instanceof Node && !menu.contains(e.target)) close();
    });

    // Tabbing out of the open panel closes it, so focus is never left on a
    // link the panel is covering.
    menu.addEventListener('focusout', (e) => {
      const next = e.relatedTarget;
      if (menu.open && next instanceof Node && !menu.contains(next)) close();
    });

    // From 800px the links are in the bar and the button is gone.
    window.matchMedia('(min-width: 800px)').addEventListener('change', (e) => {
      if (e.matches) close();
    });

    // Coming back with the Back button can restore the page as it was left.
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) close();
    });
  }
</script>

<style>
  /* The left edge lines up with the page's own gutter. The right is 10px
     tighter, because the menu button is a 44px box around a 24px glyph: the
     glyph, not the box, is what should meet the gutter. */
  .site-header {
    position: relative;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-sm);
    min-height: 64px;
    padding: 8px calc(var(--gutter) - 10px) 8px var(--gutter);
    background: var(--bar);
    border-bottom: 1px solid var(--hairline-soft);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    color: inherit;
  }
  .brand:hover {
    color: inherit;
  }

  .brand__name,
  .brand__sub {
    display: block;
    font-family: var(--font-label);
    white-space: nowrap;
  }
  .brand__name {
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.28em;
    line-height: 1.5;
    color: var(--ink);
  }
  /* The second line of the logo lockup. It is the logo's own lettering, set
     small as in her artwork, not a label: the link's name carries the words. */
  .brand__sub {
    font-weight: 400;
    font-size: 9px;
    letter-spacing: 0.44em;
    line-height: 1.5;
    color: var(--gold-text);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* ------------------------------------------------- links in the bar */

  .nav,
  .tools__theme {
    display: none;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: 4px;
    font-family: var(--font-label);
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mid);
    /* Japanese has no spaces, so without this a label breaks mid-word. */
    white-space: nowrap;
  }
  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--gold-text);
  }

  :global(html[lang='ja']) .nav__link {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: none;
  }

  /* ----------------------------------------------------------- the menu */

  .menu__button {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-ctl);
  }
  .menu__button::-webkit-details-marker {
    display: none;
  }
  .menu__button:hover {
    color: var(--gold-text);
  }

  .menu :global(.menu__icon--close),
  .menu[open] :global(.menu__icon--open) {
    display: none;
  }
  .menu[open] :global(.menu__icon--close) {
    display: block;
  }

  /* Full width under the bar, whatever the button's own position: the header
     is the positioned ancestor, not the <details>. */
  .menu__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: 4px var(--gutter) 16px;
    background: var(--bar);
    border-bottom: 1px solid var(--hairline-soft);
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.28);
  }

  .menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 54px;
    border-bottom: 1px solid var(--hairline-soft);
    font-family: var(--font-label);
    font-size: 14px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .menu__link:hover,
  .menu__link[aria-current='page'] {
    color: var(--gold-text);
  }

  :global(html[lang='ja']) .menu__link {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 16px;
    letter-spacing: 0.1em;
    text-transform: none;
  }

  .menu__foot {
    padding-top: 12px;
  }

  @media (min-width: 800px) {
    .site-header {
      padding-inline: clamp(24px, 4vw, 40px);
    }
    .nav {
      display: flex;
      align-items: center;
      gap: clamp(16px, 2.4vw, 28px);
      margin-right: clamp(8px, 1.6vw, 20px);
    }
    .tools__theme {
      display: block;
    }
    .menu-nav {
      display: none;
    }
  }

  /* On the narrowest phones the lockup, the language link and the button
     share about 290px, so the lockup's lettering tightens a little. */
  @media (max-width: 380px) {
    .brand__name {
      font-size: 12px;
      letter-spacing: 0.22em;
    }
    .brand__sub {
      letter-spacing: 0.36em;
    }
  }

  /* A 320px screen (an iPhone in Display Zoom) is 14px short for the English
     page's row, whose language link reads 日本語. The lettering and the gap
     give it back, with room to spare. */
  @media (max-width: 345px) {
    .site-header {
      gap: var(--gap-xs);
    }
    .brand__name {
      letter-spacing: 0.12em;
    }
    .brand__sub {
      letter-spacing: 0.24em;
    }
  }

  @media print {
    .tools {
      display: none;
    }
  }
</style>
