---
import { type Locale } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/utils';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import Icon from './Icon.astro';
import { getImage } from 'astro:assets';
import logo from '../assets/logo.png';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const p = (path: string) => localizePath(path, locale);

const current = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (path: string) => current === p(path).replace(/\/$/, '');

// The mark is drawn at 129px and cropped to the monogram. The source is an
// 800px PNG; this is the same picture at the size it is shown, and at 2x.
const [mark, mark2x] = await Promise.all(
  [129, 258].map((width) => getImage({ src: logo, width, format: 'webp' })),
);

const links = [
  { href: '/experience', label: t('nav.experience') },
  { href: '/about', label: t('nav.about') },
  { href: '/contact', label: t('nav.contact') },
];
---

{/* One row at every width, as she asked: logo, language, menu. From 800px
    the links sit in the bar and the menu button goes away. The two navs are
    never both rendered, so assistive tech only ever meets one. */}
<header class="site-header">
  <a class="brand" href={p('/')} aria-label={t('nav.home')}>
    <span class="brand__mark">
      <img
        src={mark.src}
        srcset={`${mark.src} 1x, ${mark2x.src} 2x`}
        alt=""
        width="129"
        height="129"
      />
    </span>
    <span class="brand__words">
      <span class="brand__name">LOS ANGELES</span>
      <span class="brand__sub">LUXURY TOUR</span>
    </span>
  </a>

  <div class="tools">
    <nav class="nav" aria-label={t('nav.main')}>
      {
        links.map((l) => (
          <a
            class="nav__link"
            href={p(l.href)}
            aria-current={isCurrent(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <LangToggle locale={locale} />
    <span class="tools__theme"><ThemeToggle locale={locale} /></span>

    {/* <details> so the menu opens without JavaScript. The script below only
        adds the niceties: Escape, a tap outside, and closing on resize. */}
    <details class="menu" data-menu>
      <summary class="menu__button" aria-label={t('nav.menu')}>
        <Icon name="menu" class="menu__icon menu__icon--open" />
        <Icon name="close" class="menu__icon menu__icon--close" />
      </summary>
      <nav class="menu__panel" aria-label={t('nav.main')}>
        {
          links.map((l) => (
            <a
              class="menu__link"
              href={p(l.href)}
              aria-current={isCurrent(l.href) ? 'page' : undefined}
            >
              {l.label}
              <Icon name="chevron-right" size={18} />
            </a>
          ))
        }
        <div class="menu__foot">
          <ThemeToggle locale={locale} labelled />
        </div>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
  if (menu) {
    const summary = menu.querySelector('summary');
    const close = (refocus = false) => {
      if (!menu.open) return;
      menu.open = false;
      if (refocus) summary?.focus();
    };

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close(true);
    });
    document.addEventListener('click', (e) => {
      if (e.target instanceof Node && !menu.contains(e.target)) close();
    });
    // The button is hidden from 800px; a menu left open would be orphaned.
    window.matchMedia('(min-width: 800px)').addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
</script>

<style>
  /* Her black bar - stays dark in both themes, so its colours are literal. */
  .site-header {
    position: relative;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-sm);
    min-height: 64px;
    padding: 8px clamp(14px, 4vw, 40px);
    background: var(--bar);
    border-bottom: 1px solid rgba(212, 175, 55, 0.3);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    color: inherit;
  }
  .brand:hover {
    color: inherit;
  }

  /* Monogram is cropped from the full lockup, so there is one logo file. */
  .brand__mark {
    display: block;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    flex: none;
  }
  .brand__mark img {
    position: absolute;
    width: 129px;
    height: 129px;
    left: -43px;
    top: -36px;
    max-width: none;
  }

  .brand__name,
  .brand__sub {
    display: block;
    font-family: var(--font-label);
    white-space: nowrap;
  }
  .brand__name {
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.28em;
    line-height: 1.5;
    color: #f5f5fa;
  }
  /* The second line of the lockup, part of the logo rather than a label. */
  .brand__sub {
    font-weight: 400;
    font-size: 9px;
    letter-spacing: 0.44em;
    line-height: 1.5;
    color: #d4af37;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* ------------------------------------------------- links in the bar */

  .nav,
  .tools__theme {
    display: none;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: 4px;
    font-family: var(--font-label);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 245, 250, 0.88);
    /* Japanese has no spaces, so without this a label breaks mid-word. */
    white-space: nowrap;
  }
  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: #d4af37;
  }

  :global(html[lang='ja']) .nav__link {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: none;
  }

  /* ----------------------------------------------------------- the menu */

  .menu__button {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    color: #f5f5fa;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-ctl);
  }
  .menu__button::-webkit-details-marker {
    display: none;
  }
  .menu__button:hover {
    color: #d4af37;
  }

  .menu :global(.menu__icon--close),
  .menu[open] :global(.menu__icon--open) {
    display: none;
  }
  .menu[open] :global(.menu__icon--close) {
    display: block;
  }

  /* Full width under the bar, whatever the button's own position. */
  .menu__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding: 4px var(--gutter) 16px;
    background: var(--bar);
    border-bottom: 1px solid rgba(212, 175, 55, 0.3);
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.28);
  }

  .menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 54px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.18);
    font-family: var(--font-label);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #f5f5fa;
  }
  .menu__link:hover,
  .menu__link[aria-current='page'] {
    color: #d4af37;
  }

  :global(html[lang='ja']) .menu__link {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 16px;
    letter-spacing: 0.1em;
    text-transform: none;
  }

  .menu__foot {
    padding-top: 12px;
  }

  @media (min-width: 800px) {
    .nav {
      display: flex;
      align-items: center;
      gap: clamp(16px, 2.4vw, 28px);
      margin-right: clamp(8px, 1.6vw, 20px);
    }
    .tools__theme {
      display: block;
    }
    .menu {
      display: none;
    }
  }

  /* At 360px the lockup, the language link and the button share 328px. */
  @media (max-width: 380px) {
    .brand__name {
      font-size: 12px;
      letter-spacing: 0.22em;
    }
    .brand__sub {
      letter-spacing: 0.36em;
    }
  }

  @media print {
    .tools {
      display: none;
    }
  }
</style>
