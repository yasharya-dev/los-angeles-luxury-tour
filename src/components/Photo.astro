---
/*
  Every photograph on the site goes through here: AVIF, then WebP, then a JPEG
  fallback, each at a ladder of widths, so a phone downloads a phone-sized
  file. Below the fold by default (lazy, decoded off the main thread); pass
  `priority` for the one image a page opens on.

  `sizes` must say how wide the photo is actually DRAWN, which for a photo
  that fills a box with object-fit: cover is often wider than the screen: a
  landscape photo in a tall phone hero is scaled up to the box's height. Left
  at 100vw there, the browser fetches a file for the screen's width and
  stretches it to more than twice that.

  `art` is a second photo of the same scene for the screens a media query
  picks out, such as an upright one for an upright phone. Its files are
  listed first, in all three formats, so wherever the query holds the browser
  takes them and never fetches the first photo. The styles that frame it
  must use the same query.
*/
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** Empty for a purely decorative photo. Says what both photos show. */
  alt: string;
  /** How wide the image is drawn, for the browser to pick a file. */
  sizes?: string;
  /** The page's opening image: fetched early, never lazy. */
  priority?: boolean;
  /**
   * Crop to this shape (width over height) while resizing. For a photo shown
   * as a band much shorter than itself: without it a phone downloads the
   * whole of a portrait photo to draw a strip of it.
   */
  aspect?: number;
  /** Which part a crop keeps: 'top', 'centre', 'bottom', 'left', 'right'. */
  keep?: string;
  /** The photo shown where `media` holds, whole, and how wide it is drawn there. */
  art?: { media: string; src: ImageMetadata; sizes: string };
  class?: string;
  style?: string;
  // Astro hands a child component the parent's style-scope attribute; it has
  // to reach the <img> or the parent's scoped rules will not match it.
  [attr: `data-astro-cid-${string}`]: unknown;
}

const {
  src,
  alt,
  sizes = '100vw',
  priority = false,
  aspect,
  keep = 'centre',
  art,
  ...rest
} = Astro.props;

// One quality per format. A single number for all three makes the AVIF
// larger than the WebP, which defeats listing it first: at these settings
// the AVIF is the smallest of the three at every width.
const QUALITY = { avif: 48, webp: 68, jpg: 74 } as const;
type Format = keyof typeof QUALITY;

// One photo's files, at `shape` (width over height): its own, or a crop's.
const ladder = async (photo: ImageMetadata, shape: number, crop: boolean) => {
  // A crop taller than the photo is cut from its sides, so it has less width
  // to offer.
  const own = Math.min(photo.width, Math.round(photo.height * shape));
  // A ladder of widths, ending on the photo's own (capped at 1920): asking for
  // more than the original holds only upscales it, and stopping at the rung
  // below would throw resolution away.
  const top = Math.min(own, 1920);
  const widths = [...[240, 480, 768, 1080, 1440].filter((w) => w < top), top];
  const make = (format: Format) =>
    Promise.all(
      widths.map((width) =>
        getImage({
          src: photo,
          width,
          format,
          quality: QUALITY[format],
          ...(crop ? { height: Math.round(width / shape), fit: 'cover', position: keep } : {}),
        }),
      ),
    );
  const [avif, webp, jpg] = await Promise.all([make('avif'), make('webp'), make('jpg')]);
  const srcset = (set: typeof avif) =>
    set.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
  return {
    width: top,
    height: Math.round(top / shape),
    avif: srcset(avif),
    webp: srcset(webp),
    jpg: srcset(jpg),
    // What a browser with no srcset support gets: the middle of the ladder.
    fallback: jpg[Math.min(3, jpg.length - 1)].src,
  };
};

const [main, other] = await Promise.all([
  ladder(src, aspect ?? src.width / src.height, Boolean(aspect)),
  art && ladder(art.src, art.src.width / art.src.height, false),
]);
---

<picture>
  {
    art && other && (
      <>
        <source media={art.media} type="image/avif" srcset={other.avif} sizes={art.sizes} width={other.width} height={other.height} />
        <source media={art.media} type="image/webp" srcset={other.webp} sizes={art.sizes} width={other.width} height={other.height} />
        <source media={art.media} type="image/jpeg" srcset={other.jpg} sizes={art.sizes} width={other.width} height={other.height} />
      </>
    )
  }
  <source type="image/avif" srcset={main.avif} sizes={sizes} />
  <source type="image/webp" srcset={main.webp} sizes={sizes} />
  <img
    src={main.fallback}
    srcset={main.jpg}
    sizes={sizes}
    alt={alt}
    width={main.width}
    height={main.height}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'auto' : 'async'}
    fetchpriority={priority ? 'high' : undefined}
    {...rest}
  />
</picture>
