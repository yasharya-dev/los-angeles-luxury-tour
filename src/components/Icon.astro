---
/*
  The site's one icon set: line icons drawn on a 24px grid at one stroke
  weight, so every icon on a page reads as the same hand. Decorative by
  default (aria-hidden); the control around an icon carries the name.

  Inline SVG rather than a sprite or a font: no extra request, and
  `currentColor` lets each use take its colour from the theme tokens.
*/
import { ICONS, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  /** Rendered box in px. The drawing scales; the stroke scales with it. */
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name]}
/>

<style>
  .icon {
    flex: none;
    display: block;
  }
</style>
