---
/*
  The compact plan card from Amelia's brief, in her order: name, short
  details, price, and the way to the details. One component for every plan
  list on the site.

  Two ways to "see details", same look:
   - `href` given: the price row ends in a link to it.
   - no `href`: the price row is the <summary> of a <details>, and the
     default slot is what it reveals. Native, so it works without script.

  Either way the control is stretched over the whole card, so the card is
  the tap target. The name and the details stay OUTSIDE the control: a
  summary is a button, and a screen reader flattens what is inside a button,
  which would take the plan's name out of heading navigation.

  The tile is the monogram until her photograph for the plan arrives.
*/
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import type { Offering } from '../data/offerings';
import Monogram from './Monogram.astro';
import Icon from './Icon.astro';
import Phrases from './Phrases.astro';

interface Props {
  locale: Locale;
  offering: Offering;
  /** Where "details" leads. Omit to expand in place. */
  href?: string;
  /** The plan name's heading level, set by what the list sits under. */
  level?: 3 | 4;
}

const { locale, offering: o, href, level = 3 } = Astro.props;
const t = useTranslations(locale);

const more = t('plan.details');
const name = o.name[locale];
const unit = o.priceNote?.[locale];
// English details are items separated by a middle dot. Each item stays whole
// where it fits, so a line folds between items, not inside 'LAX pickup', and
// a no-break space keeps the dot at the end of the line before. Japanese
// folds at its own \u30fb (see Phrases).
const blurb = o.blurb[locale];
const items = locale === 'en' ? blurb.split(' \u00b7 ') : null;

const Foot = href ? 'div' : 'details';
const Row = href ? 'div' : 'summary';
const Name = `h${level}` as const;
---

<article class="plan panel" id={`plan-${o.id}`}>
  <div class="plan__head">
    {/* Decorative: the name beside it says what the plan is. */}
    <span class="plan__thumb">
      <Monogram size={40} lazy />
    </span>

    <div class="plan__body">
      <Name class="plan__name"><Phrases text={name} /></Name>
      <p class="plan__blurb">
        {
          items ? (
            items.map((item, i) => (
              <>
                {i > 0 && ' '}
                <span class="plan__item">
                  {item}
                  {i < items.length - 1 && '\u00a0·'}
                </span>
              </>
            ))
          ) : (
            <Phrases text={blurb} />
          )
        }
      </p>
    </div>

    <Foot class="plan__foot">
      <Row class="plan__row">
        <span class="plan__price">
          <span class="plan__amount">{o.price[locale]}</span>
          {
            unit && (
              <span class="plan__unit">
                <Phrases text={unit} />
              </span>
            )
          }
        </span>
        {
          href ? (
            // The name starts with the visible label, then says which plan.
            <a class="plan__more plan__more--link" href={href} aria-label={`${more}: ${name}`}>
              {more}
              <Icon name="arrow-right" size={18} />
            </a>
          ) : (
            // The same words for a screen reader, after the price it reads
            // on the way: "… Details: Solo traveler plan".
            <span class="plan__more">
              {more}
              <span class="sr-only">: {name}</span>
              <Icon name="chevron-down" size={18} class="plan__chevron" />
            </span>
          )
        }
      </Row>
      {
        !href && (
          <div class="plan__reveal">
            <slot />
          </div>
        )
      }
    </Foot>
  </div>
</article>

<style>
  .plan {
    position: relative;
    display: block;
    scroll-margin-top: 16px;
    transition: border-color 0.3s ease;
  }
  .plan:hover {
    border-color: var(--hairline);
  }
  /* The card an address names, as in /experience#plan-charter. */
  .plan:target {
    border-color: var(--gold-text);
  }

  /* Two rows: the tile beside the name and details, then the price and the
     way in across the whole card. Across the card, the price has room to sit
     beside the control; inside the text column it never did, and every card
     ran a line longer. */
  .plan__head {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 8px 14px;
    align-items: center;
    padding: 12px;
  }

  /* The photo slot. Square, so a column of cards lines up. */
  .plan__thumb {
    display: grid;
    place-items: center;
    width: 72px;
    aspect-ratio: 1;
    border-radius: var(--radius-ctl);
    background: var(--bg-deep);
  }

  .plan__body {
    min-width: 0;
  }

  /* Two lines of a long name come out even, rather than one word alone, in
     both languages: 'Dodgers game private / transfer' left the last word. */
  .plan__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
    text-wrap: balance;
  }
  :global(html[lang='ja']) .plan__name {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: 0.02em;
  }

  /* Balanced, like the name: two even lines, not one long and one word. */
  .plan__blurb {
    margin: 2px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-soft);
    text-wrap: balance;
  }
  /* Whole where it fits; an item wider than the card still wraps inside. */
  .plan__item {
    display: inline-block;
  }

  .plan__foot {
    grid-column: 1 / -1;
    display: block;
  }

  /* The price takes the room the control leaves. A long price folds between
     its figure and its unit, and the control stays on the last line. */
  .plan__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0 12px;
    line-height: 1.5;
    list-style: none;
  }
  .plan__row::-webkit-details-marker {
    display: none;
  }
  summary.plan__row {
    cursor: pointer;
  }

  .plan__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 8px;
  }

  /* A figure never wraps mid-number; the row wraps around it. */
  .plan__amount {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    color: var(--gold-text);
    white-space: nowrap;
  }
  :global(html[lang='ja']) .plan__amount {
    font-family: var(--font-body);
    font-size: 16px;
  }

  .plan__unit {
    font-size: 14px;
    color: var(--ink-soft);
  }

  /* The control covers the card (below), far over 44px, so this label only
     has to read as the way in: her quiet pill (04). The arrow or chevron
     stays inside it, as her written brief asks for a details arrow. */
  .plan__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 0 12px 0 14px;
    border: 1px solid var(--chip-edge);
    border-radius: 13px;
    background: var(--chip-fill);
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--quiet-ink);
    white-space: nowrap;
  }
  :global(html[lang='ja']) .plan__more {
    font-family: var(--font-body);
    letter-spacing: 0.06em;
    text-transform: none;
  }

  /* The link, or the summary, is stretched over the card: one big target
     with a short name. Its focus ring is drawn around the card, where a
     sighted keyboard user is looking. */
  .plan__more--link::after,
  summary.plan__row::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }
  .plan__more--link:focus-visible,
  summary.plan__row:focus-visible {
    outline: none;
  }
  .plan__more--link:focus-visible::after,
  summary.plan__row:focus-visible::after {
    outline: 2px solid var(--gold-text);
    outline-offset: 2px;
  }

  .plan :global(.plan__chevron) {
    transition: transform 0.25s ease;
  }
  .plan__foot[open] :global(.plan__chevron) {
    transform: rotate(180deg);
  }

  /* What the card opens to show. It sits above the stretched control, or
     its own links could not be reached and its text could not be selected. */
  .plan__reveal {
    position: relative;
    z-index: 1;
    margin-top: 10px;
    padding: 14px 0 4px;
    border-top: 1px solid var(--hairline-soft);
  }

  /* Under 340px the longest unit and the control no longer fit side by
     side: the price takes the row and the control goes under it, at the
     right. */
  @media (max-width: 339px) {
    .plan__row {
      grid-template-columns: minmax(0, 1fr);
    }
    .plan__more {
      justify-self: end;
    }
  }

  @media (min-width: 720px) {
    .plan__head {
      grid-template-columns: 84px minmax(0, 1fr);
      gap: 10px 18px;
      padding: 14px;
    }
    .plan__thumb {
      width: 84px;
    }
  }
</style>
