---
/*
  The compact plan card from Amelia's brief, in her order: name, short
  details, price, and the way to the details. One component for every plan
  list on the site.

  Two ways to "see details", same look:
   - `href` given: the card links to it. The link is stretched over the whole
     card, so the card is the tap target, but its name stays short.
   - no `href`: the card is a <details>. The whole head is the summary, and
     the default slot is what it reveals. Native, so it works without script.

  The tile is the monogram until her photograph for the plan arrives.
*/
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import type { Offering } from '../data/offerings';
import Monogram from './Monogram.astro';
import Icon from './Icon.astro';
import Phrases from './Phrases.astro';

interface Props {
  locale: Locale;
  offering: Offering;
  /** Where "details" leads. Omit to expand in place. */
  href?: string;
  /** The plan name's heading level, set by what the list sits under. */
  level?: 3 | 4;
}

const { locale, offering: o, href, level = 3 } = Astro.props;
const t = useTranslations(locale);

const more = t('plan.details');
const name = o.name[locale];
const unit = o.priceNote?.[locale];

const Card = href ? 'article' : 'details';
const Head = href ? 'div' : 'summary';
const Name = `h${level}` as const;
---

<Card class="plan panel" id={`plan-${o.id}`}>
  <Head class="plan__head">
    {/* Decorative: the name beside it says what the plan is. */}
    <span class="plan__thumb">
      <Monogram size={40} lazy />
    </span>

    <span class="plan__body">
      <Name class="plan__name"><Phrases text={name} /></Name>
      <span class="plan__blurb"><Phrases text={o.blurb[locale]} /></span>
    </span>

    <span class="plan__foot">
      <span class="plan__price">
        <span class="plan__amount">{o.price[locale]}</span>
        {unit && (
          <span class="plan__unit">
            <Phrases text={unit} />
          </span>
        )}
      </span>
      {
        href ? (
          // The name starts with the visible label, then says which plan.
          <a class="plan__more plan__more--link" href={href} aria-label={`${more}: ${name}`}>
            {more}
            <Icon name="arrow-right" size={18} />
          </a>
        ) : (
          <span class="plan__more">
            {more}
            <Icon name="chevron-down" size={18} class="plan__chevron" />
          </span>
        )
      }
    </span>
  </Head>

  {
    !href && (
      <div class="plan__reveal">
        <slot />
      </div>
    )
  }
</Card>

<style>
  .plan {
    position: relative;
    display: block;
    scroll-margin-top: 16px;
    transition: border-color 0.3s ease;
  }
  .plan:hover {
    border-color: var(--hairline);
  }
  /* The card an address names, as in /experience#plan-charter. */
  .plan:target {
    border-color: var(--gold-text);
  }

  /* Two rows: the tile beside the name and details, then the price and the
     way in across the whole card. Across the card, the price has room to sit
     beside the link; inside the text column it never did, and every card ran
     a line longer. */
  .plan__head {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 8px 14px;
    align-items: center;
    padding: 12px;
    list-style: none;
  }
  .plan__head::-webkit-details-marker {
    display: none;
  }
  summary.plan__head {
    cursor: pointer;
    border-radius: var(--radius-card);
  }

  /* The photo slot. Square, so a column of cards lines up. */
  .plan__thumb {
    display: grid;
    place-items: center;
    width: 72px;
    aspect-ratio: 1;
    border-radius: var(--radius-ctl);
    background: var(--bg-deep);
  }

  .plan__body {
    display: block;
    min-width: 0;
  }

  .plan__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }
  /* Two lines of a long name come out even, rather than one word alone. */
  :global(html[lang='ja']) .plan__name {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }

  /* Balanced, like the name: two even lines, not one long and one word. */
  .plan__blurb {
    display: block;
    margin-top: 2px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-soft);
    text-wrap: balance;
  }

  /* The price takes the room the link leaves. A long price folds between
     its figure and its unit, and the link stays on the last line. */
  .plan__foot {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0 12px;
    line-height: 1.5;
  }

  .plan__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 8px;
  }

  /* A figure never wraps mid-number; the row wraps around it. */
  .plan__amount {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    color: var(--gold-text);
    white-space: nowrap;
  }
  :global(html[lang='ja']) .plan__amount {
    font-family: var(--font-body);
    font-size: 16px;
  }

  .plan__unit {
    font-size: 14px;
    color: var(--ink-soft);
  }

  /* The card (or the summary) is the tap target, far over 44px, so this label
     only has to read as the way in. */
  .plan__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 28px;
    font-family: var(--font-label);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-text);
    white-space: nowrap;
  }
  :global(html[lang='ja']) .plan__more {
    font-family: var(--font-body);
    letter-spacing: 0.06em;
    text-transform: none;
  }

  /* The link covers the card: one big target, one short name. The focus ring
     is drawn around the card, where a sighted keyboard user is looking. */
  .plan__more--link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }
  .plan__more--link:focus-visible {
    outline: none;
  }
  .plan__more--link:focus-visible::after {
    outline: 2px solid var(--gold-text);
    outline-offset: 2px;
  }

  .plan :global(.plan__chevron) {
    transition: transform 0.25s ease;
  }
  .plan[open] :global(.plan__chevron) {
    transform: rotate(180deg);
  }

  .plan__reveal {
    margin: 0 12px;
    padding: 14px 0 16px;
    border-top: 1px solid var(--hairline-soft);
  }

  /* Under 340px the longest unit and the link no longer fit side by side:
     the price takes the row and the link goes under it, at the right. */
  @media (max-width: 339px) {
    .plan__foot {
      grid-template-columns: minmax(0, 1fr);
    }
    .plan__more {
      justify-self: end;
    }
  }

  @media (min-width: 720px) {
    .plan__head {
      grid-template-columns: 84px minmax(0, 1fr);
      gap: 10px 18px;
      padding: 14px;
    }
    .plan__thumb {
      width: 84px;
    }
    .plan__reveal {
      margin-inline: 14px;
    }
  }
</style>
