---
import { type Locale } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/utils';
import { CONTACT } from '../data/contact';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const p = (path: string) => localizePath(path, locale);
---

<footer class="site-footer">
  {/* Monolingual per page. The stacked bilingual lockup is for OG cards. */}
  <p class="site-footer__signoff">{t('footer.signoff')}</p>

  <nav class="site-footer__links" aria-label={t('footer.location')}>
    <a href={`mailto:${CONTACT.email}`}>{t('footer.email')}</a>
    <a href={CONTACT.lineUrl} rel="noopener">
      {t('footer.line')} <span class="site-footer__id">{CONTACT.lineId}</span>
    </a>
    <a href={CONTACT.instagram} rel="me noopener">{t('footer.instagram')}</a>
    <a href={CONTACT.threads} rel="me noopener">{t('footer.threads')}</a>
  </nav>

  <div class="site-footer__meta">
    <span>{t('footer.location')}</span>
    <a href={p('/privacy')}>{t('footer.privacy')}</a>
    <span>{t('footer.rights')}</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bar-deep);
    border-top: 1px solid var(--hairline-soft);
    padding: clamp(56px, 9vw, 88px) 24px clamp(72px, 10vw, 96px);
    text-align: center;
  }

  .site-footer__signoff {
    margin: 0 0 clamp(32px, 5vw, 48px);
    font-family: var(--font-display);
    font-size: clamp(17px, 2.6vw, 23px);
    font-style: italic;
    line-height: 1.6;
    color: #d4af37;
  }

  :global(html[lang='ja']) .site-footer__signoff {
    font-family: var(--font-body);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(15px, 2.2vw, 19px);
    letter-spacing: 0.06em;
  }

  .site-footer__links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(18px, 4vw, 38px);
    margin-bottom: clamp(28px, 4vw, 40px);
  }

  .site-footer__links a {
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(245, 245, 250, 0.8);
  }
  .site-footer__links a:hover {
    color: #d4af37;
  }

  :global(html[lang='ja']) .site-footer__links a {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: none;
  }

  /* An identifier, not a label. @153CQWQP is a different string to type. */
  .site-footer__id {
    text-transform: none;
    letter-spacing: 0.08em;
    color: rgba(245, 245, 250, 0.55);
  }

  .site-footer__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(12px, 3vw, 26px);
    font-family: var(--font-label);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 245, 250, 0.42);
  }

  .site-footer__meta a {
    color: inherit;
  }
  .site-footer__meta a:hover {
    color: #d4af37;
  }

  :global(html[lang='ja']) .site-footer__meta {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: none;
  }
</style>
