---
import { type Locale } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/utils';
import { CONTACT } from '../data/contact';
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const p = (path: string) => localizePath(path, locale);

// Her brief: three icons, Email, Instagram and Facebook, in place of the text
// links; LINE stays on the contact page. Facebook joins the row once she has
// sent the page address, rather than shipping as a dead link.
interface FooterLink {
  icon: IconName;
  label: string;
  href: string;
  rel?: string;
}

const links: FooterLink[] = [
  { icon: 'mail', label: t('footer.email'), href: `mailto:${CONTACT.email}` },
  {
    icon: 'instagram',
    label: t('footer.instagram'),
    href: CONTACT.instagram,
    rel: 'me noopener',
  },
];
if (CONTACT.facebook) {
  links.push({
    icon: 'facebook',
    label: t('footer.facebook'),
    href: CONTACT.facebook,
    rel: 'me noopener',
  });
}
---

{/* A plate: black in both themes, so every colour below is a token. */}
<footer class="site-footer plate">
  {/* Monolingual per page. The stacked bilingual lockup is for OG cards. */}
  <p class="site-footer__signoff">{t('footer.signoff')}</p>

  <nav class="site-footer__links" aria-label={t('footer.contact')}>
    {
      links.map((link) => (
        <a
          class="site-footer__icon"
          href={link.href}
          rel={link.rel}
          aria-label={link.label}
          title={link.label}
        >
          <Icon name={link.icon} size={28} />
        </a>
      ))
    }
  </nav>

  <div class="site-footer__meta">
    <span>{t('footer.location')}</span>
    <a href={p('/privacy')}>{t('footer.privacy')}</a>
    <span>{t('footer.rights')}</span>
  </div>

  {/* Her registration as a California seller of travel. A legal line, on its
      own row. Two halves that each stay whole: on a narrow phone it folds
      between them, never inside the number. */}
  <p class="site-footer__meta site-footer__registration">
    <span class="site-footer__whole">{t('footer.sellerOfTravel')}</span>
    <span class="site-footer__whole">
      {t('footer.registrationNo')}{' '}{CONTACT.sellerOfTravel}
    </span>
  </p>
</footer>

<style>
  .site-footer {
    background: var(--bar-deep);
    border-top: 1px solid var(--hairline-soft);
    padding: clamp(40px, 7vw, 64px) var(--gutter) clamp(36px, 6vw, 56px);
    text-align: center;
  }

  .site-footer__signoff {
    margin: 0 0 clamp(18px, 3vw, 26px);
    font-family: var(--font-display);
    font-size: clamp(19px, 2.6vw, 23px);
    font-style: italic;
    line-height: 1.6;
    color: var(--gold-text);
  }

  :global(html[lang='ja']) .site-footer__signoff {
    font-family: var(--font-body);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(16px, 2.2vw, 19px);
    letter-spacing: 0.06em;
  }

  .site-footer__links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 3vw, 24px);
    margin-bottom: clamp(18px, 3vw, 26px);
  }

  /* The link is the target; the drawing inside is 28px. */
  .site-footer__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    color: var(--gold-text);
    transition:
      color 0.3s ease,
      background 0.3s ease;
  }
  .site-footer__icon:hover {
    color: var(--ink);
    background: var(--btn-hover);
  }

  /* --ink-soft on --bar-deep is 8.5:1: the quietest line on the page, and
     still comfortably readable. */
  .site-footer__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px clamp(12px, 3vw, 26px);
    font-family: var(--font-label);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* A real target for a finger, and an underline so it reads as the one
     link in a row of plain text. */
  .site-footer__meta a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--hairline);
    text-underline-offset: 0.3em;
  }
  .site-footer__meta a:hover {
    color: var(--gold-text);
  }

  :global(html[lang='ja']) .site-footer__meta {
    font-family: var(--font-body);
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: none;
  }

  /* A registration number is an identifier: never uppercased, never tracked
     apart, so it reads back exactly as issued. The lang-scoped selector is
     needed too, or the Japanese meta rule above outranks this one. */
  .site-footer__registration,
  :global(html[lang='ja']) .site-footer__registration {
    gap: 0 0.5em;
    margin: 4px 0 0;
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .site-footer__whole {
    white-space: nowrap;
  }
</style>
