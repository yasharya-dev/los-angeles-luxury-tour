---
import { type Locale } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/utils';
import { CONTACT } from '../data/contact';
import Icon from './Icon.astro';
import Phrases from './Phrases.astro';
import type { IconName } from '../data/icons';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const p = (path: string) => localizePath(path, locale);

// Her brief: three icons, Email, Instagram and Facebook, in place of the text
// links; LINE stays on the contact page. Facebook joins the row once she has
// sent the page address, rather than shipping as a dead link.
interface FooterLink {
  icon: IconName;
  label: string;
  href: string;
  rel?: string;
}

const links: FooterLink[] = [
  { icon: 'mail', label: t('footer.email'), href: `mailto:${CONTACT.email}` },
  {
    icon: 'instagram',
    label: t('footer.instagram'),
    href: CONTACT.instagram,
    rel: 'me noopener',
  },
];
if (CONTACT.facebook) {
  links.push({
    icon: 'facebook',
    label: t('footer.facebook'),
    href: CONTACT.facebook,
    rel: 'me noopener',
  });
}
---

{/* A plate: black in both themes, so every colour below is a token. */}
<footer class="site-footer plate">
  {/* Monolingual per page. The stacked bilingual lockup is for OG cards. */}
  {/* Folded at a phrase on a narrow phone, never before its last 「に。」. */}
  <p class="site-footer__signoff"><Phrases text={t('footer.signoff')} /></p>

  <nav class="site-footer__links" aria-label={t('footer.contact')}>
    {
      links.map((link) => (
        <a
          class="site-footer__icon"
          href={link.href}
          rel={link.rel}
          title={link.label}
        >
          <Icon name={link.icon} size={28} />
        </a>
      ))
    }
  </nav>

  {/* Her order: the wish, the icons, the privacy link on its own row, then
      the two legal lines. */}
  <p class="site-footer__privacy">
    <a href={p('/privacy')}>{t('footer.privacy')}</a>
  </p>

  <p class="site-footer__meta">{t('footer.rights')}</p>

  {/* Her registration as a California seller of travel. Two halves that each
      stay whole: on a narrow phone the line folds between them, never inside
      the number. */}
  <p class="site-footer__meta site-footer__registration">
    <span class="site-footer__whole">{t('footer.sellerOfTravel')}</span>
    <span class="site-footer__whole">
      {t('footer.registrationNo')}{' '}{CONTACT.sellerOfTravel}
    </span>
  </p>
</footer>

<style>
  .site-footer {
    background: var(--bar-deep);
    border-top: 1px solid var(--hairline-soft);
    padding: clamp(40px, 7vw, 64px) var(--gutter) clamp(36px, 6vw, 56px);
    text-align: center;
  }

  .site-footer__signoff {
    margin: 0 0 clamp(18px, 3vw, 26px);
    font-family: var(--font-display);
    font-size: clamp(19px, 2.6vw, 23px);
    font-style: italic;
    line-height: 1.6;
    color: var(--gold-text);
  }

  :global(html[lang='ja']) .site-footer__signoff {
    font-family: var(--font-body);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(16px, 2.2vw, 19px);
    letter-spacing: 0.06em;
  }

  .site-footer__links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 3vw, 24px);
    margin-bottom: clamp(18px, 3vw, 26px);
  }

  /* The link is the target; the drawing inside is 28px. */
  .site-footer__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    color: var(--gold-text);
    transition:
      color 0.3s ease,
      background 0.3s ease;
  }
  .site-footer__icon:hover {
    color: var(--ink);
    background: var(--btn-hover);
  }

  /* The one text link in the footer: a real target for a finger, and
     underlined so it reads as a link among plain lines. */
  .site-footer__privacy {
    margin: 0 0 4px;
  }
  .site-footer__privacy a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: 8px;
    font-family: var(--font-label);
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mid);
    text-decoration: underline;
    text-decoration-color: var(--hairline);
    text-underline-offset: 0.3em;
  }
  .site-footer__privacy a:hover {
    color: var(--gold-text);
  }
  /* Half-width marks without proportional kana: WebKit underlines a palt run
     at its full width, past the last character. */
  :global(html[lang='ja']) .site-footer__privacy a {
    font-family: var(--font-body);
    letter-spacing: 0.06em;
    text-transform: none;
    font-feature-settings: 'halt';
  }

  /* The legal lines, as issued: a name and a registration number are never
     uppercased or tracked apart. --ink-soft on --bar-deep is 8.5:1, the
     quietest text on the page and still comfortably readable. */
  .site-footer__meta {
    margin: 0;
    font-family: var(--font-label);
    font-size: 14px;
    line-height: 1.9;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }
  :global(html[lang='ja']) .site-footer__meta {
    font-family: var(--font-body);
  }

  .site-footer__registration {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.5em;
  }

  .site-footer__whole {
    white-space: nowrap;
  }
</style>
